<view class="home-page {{themeClass}}">
  <view style="height:{{statusBarHeight}}px"/>

  <view class="brandbar">
    <image class="brand-logo" src="/assets/brand/logo-ai.png" mode="aspectFit" aria-label="五色知时"/>
  </view>

  <view wx:if="{{contentSource === 'loading'}}" class="loading-card">
    <view class="skeleton wide"/><view class="skeleton"/><view class="skeleton short"/>
  </view>
  <view wx:elif="{{contentSource === 'error'}}" class="reload-card">
    <view class="reload-mark">时</view>
    <view class="reload-copy"><view>今日内容稍后即来</view><text>网络恢复后可立即重新读取，不会展示过期排行。</text></view>
    <button bindtap="loadToday">重新读取</button>
  </view>

  <block wx:else>
    <view class="overview-card">
      <view class="today-heading">
        <view class="today-date">{{solarDateLabel}}</view>
        <view class="today-title-row"><view class="today-title">今日五色</view><button class="public-poster-trigger" bindtap="generatePublicPoster" loading="{{posterGenerating}}" disabled="{{posterGenerating}}">生成海报</button></view>
        <view class="today-lunar">{{lunarDateLabel}}</view>
        <view class="today-tagline">穿衣、配饰与一缕香，都可以从今天的色序开始。</view>
      </view>
      <scroll-view class="date-strip" scroll-x="true" enable-flex="true">
        <button wx:for="{{dayOptions}}" wx:key="date" class="date-option {{item.active ? 'active' : ''}}" bindtap="selectDate" data-date="{{item.date}}">
          <text>{{item.label}}</text><text class="date-weekday">{{item.weekday}}</text>
        </button>
      </scroll-view>
      <view class="rank-pills">
        <button wx:for="{{guides}}" wx:key="rank" class="rank-pill tone-{{item.product.id}} {{selected.rank === item.rank ? 'active' : ''}}" bindtap="selectGuide" data-rank="{{item.rank}}">
          <text>0{{item.rank}}</text><view>{{item.name}}</view><text class="rank-tier">{{item.tier}}</text>
        </button>
      </view>
      <view class="featured" wx:if="{{selected}}">
        <view class="featured-copy">
          <view class="featured-label">今日首选对应香品</view>
          <view class="featured-name">{{selected.product.name}}</view>
          <view class="featured-mood">{{selected.product.mood}}</view>
          <view class="featured-text">{{selected.scent}}</view>
          <button bindtap="toGuideProduct" data-id="{{selected.product.id}}">查看香品　›</button>
        </view>
        <view class="featured-image-wrap">
          <image class="featured-image" src="{{selected.product.image}}" mode="aspectFill"/>
        </view>
      </view>
    </view>

    <view wx:if="{{personalState === 'ready'}}" class="personal-lock-card personal-feature-card personal-ready-card">
      <view class="personal-card-rail"/>
      <view class="personal-lock-copy">
        <view class="personal-lock-kicker">PERSONAL FIVE COLORS · {{personalDate}}</view>
        <view class="personal-lock-title-row"><view class="personal-lock-title">我的五色</view><text class="personal-lock-status">已生成</text></view>
        <view class="personal-hero-swatches"><view wx:for="{{personalColors}}" wx:key="rank" class="personal-hero-swatch {{index === 0 ? 'active' : ''}}" style="background:{{item.swatches[0]}}"/></view>
        <view class="personal-primary-line"><text>今日首选</text><view>{{personalPrimaryColor}}</view></view>
        <text class="personal-focus">{{personalFocus}}</text>
        <view wx:if="{{personalOpen}}" class="personal-home-details">
          <view wx:for="{{personalColors}}" wx:key="rank" class="personal-home-row">
            <view class="personal-row-head">
              <text class="personal-row-rank">0{{item.rank}}</text>
              <view class="personal-row-swatches"><view wx:for="{{item.swatches}}" wx:for-item="swatch" wx:key="*this" class="personal-row-swatch" style="background:{{swatch}}"/></view>
              <view class="personal-row-main">
                <view class="personal-row-title">{{item.name}} <text>· {{item.product}}</text></view>
                <view class="personal-row-meta">{{item.tendency}} · {{item.score}}分 · 公共第{{item.public_rank}}名 · {{item.rankChangeLabel}}</view>
              </view>
            </view>
            <view class="personal-row-palette"><text>穿衣色</text>{{item.palette}}</view>
            <view class="personal-row-advice"><text>穿衣与搭配</text>{{item.advice}}</view>
            <view class="personal-row-caution"><text>少用 / 留意</text>{{item.resistance}}</view>
          </view>
        </view>
      </view>
      <button class="state-toggle personal-state-toggle" bindtap="togglePersonalColors"><text>{{personalOpen ? '收起' : '查看'}}</text><view class="state-toggle-icon {{personalOpen ? 'minus' : 'plus'}}"/></button>
    </view>
    <view wx:else class="personal-lock-card personal-feature-card personal-gated-card">
      <view class="personal-card-rail"/>
      <view class="personal-lock-copy">
        <view class="personal-lock-kicker">PERSONAL FIVE COLORS</view>
        <view class="personal-lock-title-row"><view class="personal-lock-title">个人五色</view><text class="personal-lock-status">{{personalState === 'missing' ? '待完善' : '请登录'}}</text></view>
        <view class="personal-hero-swatches" aria-hidden="true"><view class="personal-hero-swatch personal-swatch-white active"/><view class="personal-hero-swatch personal-swatch-gold"/><view class="personal-hero-swatch personal-swatch-green"/><view class="personal-hero-swatch personal-swatch-red"/><view class="personal-hero-swatch personal-swatch-black"/></view>
        <text>{{personalState === 'missing' ? '完善本人档案后，即可生成你的专属色序。' : '登录后即可查看结合本命与当日流日生成的个人五色。'}}</text>
      </view>
      <button wx:if="{{personalState === 'missing'}}" bindtap="toProfile">完善档案 ›</button><button wx:else bindtap="toSettings">登录查看 ›</button>
    </view>

    <view class="detail-section">
      <view class="section-kicker">DAILY GUIDANCE</view>
      <view class="section-title">五色穿衣指南</view>
      <view class="section-intro">每个颜色都有对应的穿衣解释，也会清楚标出今天需要少用或留意的搭配。</view>

      <view class="rule-basis-card">
        <view class="rule-seal"><text>{{dayBranch}}</text><view>{{dayElement}}</view></view>
        <view class="rule-basis-copy">
          <view class="rule-basis-title">日支取象 · {{dayPillar}}日</view>
          <view class="rule-basis-text">{{dayBasis}}</view>
        </view>
      </view>

      <view wx:for="{{guides}}" wx:key="rank" class="guide-card tone-card-{{item.product.id}}">
        <view class="guide-head">
          <view class="guide-rank">0{{item.rank}}</view>
          <view class="guide-identity"><view>{{item.name}}</view><text>{{item.element}} · {{item.tier}}</text></view>
          <view class="guide-actions"><view class="status-chip">{{item.status}}</view><button class="state-toggle guide-state-toggle" bindtap="toggleGuide" data-rank="{{item.rank}}" aria-label="{{item.expanded ? '收起详情' : '展开详情'}}"><text>{{item.expanded ? '收起' : '展开'}}</text><view class="state-toggle-icon {{item.expanded ? 'minus' : 'plus'}}"/></button></view>
        </view>
        <view class="swatch-row">
          <view class="swatch-colors"><view wx:for="{{item.product.swatches}}" wx:for-item="swatch" wx:key="*this" class="guide-swatch" style="background:{{swatch}}"/></view>
          <view class="swatch-copy"><text>今日穿衣色</text><text>{{item.palette}}</text></view>
        </view>
        <view wx:if="{{item.expanded}}" class="guide-summary">
          <view class="guide-note guide-note-fit">
            <view class="guide-note-label">穿衣与搭配</view>
            <view class="guide-note-copy">{{item.advice}}</view>
          </view>
          <view class="guide-note guide-note-caution">
            <view class="guide-note-label">今日少用 / 留意</view>
            <view class="guide-note-copy">{{item.resistance}}</view>
          </view>
        </view>
        <view wx:if="{{item.expanded}}" class="advice-panel">
          <view class="relation-explanation"><text>色序依据</text><view>{{item.relationReason}}</view></view>
          <view class="micro-title">今日适宜</view>
          <view class="suitable-list"><text wx:for="{{item.suitable}}" wx:key="*this">{{item}}</text></view>
        </view>
        <view wx:if="{{item.expanded}}" class="product-row">
          <view><text>对应香品</text><view>{{item.product.name}} · {{item.product.mood}}</view></view>
          <button bindtap="toGuideProduct" data-id="{{item.product.id}}">了解 ›</button>
        </view>
      </view>
      <view class="source-note">传统文化与日常生活参考，请结合实际情境判断。</view>
    </view>
  </block>

  <!-- 2D canvas 需要一直在页面树中，生成海报时才能取得节点实例。 -->
  <canvas type="2d" id="publicGuidePoster" class="public-poster-canvas"></canvas>

  <view wx:if="{{posterVisible}}" class="poster-modal" catchtouchmove="preventPosterTouchMove">
    <view class="poster-sheet">
      <view class="poster-sheet-head"><view>今日公共五色</view><button class="poster-close" bindtap="closePublicPoster">关闭</button></view>
      <image class="poster-preview" src="{{posterPath}}" mode="widthFix"/>
      <view class="poster-actions"><button bindtap="savePublicPoster">保存图片</button><button class="poster-share" bindtap="sharePublicPoster">分享海报</button></view>
    </view>
  </view>

  <view class="gift">
    <view class="gift-copy"><view class="gift-kicker">五色齐备 · 一盒知时</view><view class="gift-title">五色知时线香套装</view><view class="gift-desc">青木、朱蜜、黄檀、白桂、墨沉</view><view class="gift-price price-figure">¥268 <text>预购价</text></view><button class="gift-button" bindtap="toGift">查看套装</button></view>
    <image class="gift-image" src="{{gift.image}}" mode="aspectFit"/>
  </view>

  <view class="page-foot {{themeClass}}">五色知时 · 让传统文化自然进入日常</view>
</view>

