.mine-page{padding:14rpx 34rpx 0}.mine-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:24rpx}.mine-heading .brand-logo{width:88rpx;height:76rpx}.screen-title{font-size:50rpx}
.identity-card{background:#171a15;color:#ddcda7;padding:32rpx;border:1rpx solid #4a4738}.identity-top{display:flex;align-items:center}.identity-seal{display:flex;align-items:center;justify-content:center;width:98rpx;height:98rpx;border:1rpx solid #a18a5a;border-radius:50%;font-family:"Songti SC",serif;font-size:46rpx;flex:none}
.identity-copy{padding-left:24rpx;min-width:0}.identity-title{font-family:"Songti SC",serif;font-size:36rpx;letter-spacing:3rpx}.identity-copy>view:last-child{color:#afa68d;font-size:22rpx;margin-top:10rpx}
.login-button{margin-top:30rpx;width:100%;background:#c5ae7b;color:#25291f;border-radius:3rpx;font-size:27rpx;line-height:74rpx;letter-spacing:4rpx}.identity-footer{display:flex;justify-content:space-between;border-top:1rpx solid #484635;padding-top:22rpx;margin-top:30rpx;font-size:21rpx;color:#ad9e7f}.identity-footer button{background:transparent;padding:0;color:#c4ad7c;font-size:21rpx;line-height:1.8}.account-error{margin-top:20rpx;color:#d8ba8d;font-size:23rpx}.account-error button{background:transparent;color:#d1b98d;font-size:23rpx;text-align:left;padding:0;text-decoration:underline}
.orders-panel,.service-panel{padding:26rpx 0;border-bottom:1rpx solid #3c3428}.panel-heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:20rpx}.panel-heading>view{font-family:"Songti SC",serif;font-size:32rpx;letter-spacing:3rpx}.panel-heading .text-button{font-size:22rpx}
.order-entries{display:flex;justify-content:space-between;padding:6rpx 0}.order-entries>button{width:25%;padding:0 4rpx;background:transparent;color:#bfad91;line-height:1.6;font-size:23rpx;border-radius:0}.order-symbol{position:relative;width:52rpx;height:44rpx;border:1.5rpx solid #9f865b;border-radius:4rpx;margin:8rpx auto 18rpx}.order-symbol:before{content:"";position:absolute;top:11rpx;left:8rpx;right:8rpx;border-top:1rpx solid #9f865b}.order-symbol.box:before{top:0;bottom:0;left:50%;right:auto;border-left:1rpx solid #9f865b}.order-symbol.delivery{border-radius:4rpx 14rpx 4rpx 4rpx}.order-symbol.delivery:after{content:"";position:absolute;bottom:-7rpx;left:7rpx;width:9rpx;height:9rpx;border:1rpx solid #9f865b;border-radius:50%;background:#0d0e0d;box-shadow:26rpx 0 #0d0e0d}.order-symbol.service{width:44rpx;height:44rpx;border-radius:50%}.order-symbol.service:before{top:13rpx;left:12rpx;width:16rpx;height:10rpx;border:1rpx solid #9f865b;border-radius:50%}.order-symbol>text{position:absolute;right:-20rpx;top:-14rpx;background:#0d0e0d;color:#947345;font-size:20rpx;line-height:28rpx;min-width:28rpx;text-align:center}.order-error{display:block;margin-top:22rpx}
.profile-link{display:flex;width:100%;align-items:center;padding:28rpx 0;background:transparent;border-radius:0;text-align:left;border-bottom:1rpx solid #3c3428;line-height:1.6;color:#e7cfab}.profile-seal{border:1rpx solid #afa07c;border-radius:50%;width:68rpx;height:68rpx;line-height:68rpx;text-align:center;font-family:serif;font-size:32rpx;color:#8c754b;flex:none;margin-right:22rpx}.profile-title{font-family:"Songti SC",serif;font-size:31rpx;letter-spacing:3rpx}.profile-link .muted{font-size:22rpx;margin-top:4rpx}.arrow{margin-left:auto;padding-left:16rpx;font-size:32rpx;color:#a08960}.service-label{font-size:21rpx;color:#96886c;letter-spacing:2rpx}
.service-link{display:flex;align-items:center;width:100%;background:transparent;border-radius:0;text-align:left;padding:12rpx 0;line-height:1.7;color:#d6c09d}.service-link>view{min-width:0;flex:1}.service-link>view>view{font-size:27rpx}.service-link>view>text{display:block;font-size:22rpx;color:#93836b;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:520rpx}.history-link{margin-top:6rpx}
.menu-panel{margin-top:14rpx}.menu-row{display:flex;justify-content:space-between;align-items:center;width:100%;background:transparent;border-radius:0;padding:23rpx 0;text-align:left;color:#d6c09d;font-size:26rpx;line-height:1.8;border-bottom:1rpx solid #3c3428}.menu-row>view{font-size:23rpx;color:#9a8a6b}.menu-row>view>text{margin-left:15rpx;font-size:28rpx}.logout-button{margin:32rpx auto 0;background:transparent;border:1rpx solid #6c5940;border-radius:4rpx;line-height:72rpx;color:#8c795a;font-size:25rpx;letter-spacing:3rpx}
.mine-page{padding-bottom:calc(110rpx + env(safe-area-inset-bottom))}
.mine-page{color:#4b4236}.identity-card{background:rgba(248,244,236,.76);color:#4b4236;border-color:#c1b29d}.identity-copy>view:last-child{color:#7c7162}.orders-panel,.service-panel,.profile-link,.menu-row{border-bottom-color:#c5b7a1}.profile-link,.service-link,.menu-row{color:#5e5140}.order-entries>button{color:#796c5a}.order-symbol,.order-symbol:before,.order-symbol:after{border-color:#9f8050}.service-label{color:#87745b}
.mine-page{color:#eee6d8;background-color:#272c28;background-image:linear-gradient(rgba(39,44,40,.88),rgba(29,34,30,.95)),url('/assets/brand/stone-texture.jpg');background-size:auto,720rpx}.mine-heading .screen-title{color:#f0e5d6}.identity-card{background:#353b36;color:#eee6d8;border-color:#626e64;box-shadow:0 12rpx 24rpx rgba(20,23,20,.22)}.identity-seal{border-color:#bc8b53;color:#dfb77d}.identity-copy>view:last-child{color:#b8b2a5}.login-button{background:#b88a53;color:#fffaf2}.identity-footer{border-top-color:#566159;color:#b9b1a2}.identity-footer button{color:#ddb071}.orders-panel,.service-panel,.profile-link,.menu-row{border-bottom-color:#566159}.panel-heading>view,.profile-title{color:#eee5d7}.panel-heading .text-button,.service-link,.profile-link,.menu-row{color:#dcc098}.order-entries>button{color:#b9b1a2}.order-symbol,.order-symbol:before,.order-symbol:after{border-color:#c0955b}.order-symbol.delivery:after{background:#272c28;box-shadow:26rpx 0 #272c28}.order-symbol>text{background:#272c28;color:#ddb071}.service-label{color:#aaa99b}.profile-seal{border-color:#b99660;color:#d4aa70}.profile-link .muted,.service-link>view>text,.menu-row>view{color:#aaa99b}.arrow{color:#d6ab71}.logout-button{border-color:#826344;color:#d2a367}.page-foot{color:#9d9f95}
