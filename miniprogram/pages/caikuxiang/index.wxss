.shop-page{padding:24rpx 30rpx 140rpx}.shop-heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:26rpx}.shop-heading .screen-title{font-size:38rpx;letter-spacing:3rpx;margin-top:10rpx}.shop-heading .eyebrow{font-size:21rpx}.shop-logo{width:90rpx;height:80rpx;margin-left:12rpx}
.shop-hero{position:relative;display:block;padding:0;width:100%;height:480rpx;background:#151613;border-radius:0;text-align:left;color:#e0cca0;overflow:hidden}.shop-hero image{width:100%;height:100%}.hero-copy{position:absolute;left:28rpx;right:28rpx;bottom:24rpx;padding-top:50rpx;background:linear-gradient(transparent,rgba(12,13,10,.88));text-shadow:0 2rpx 8rpx #000}.hero-title{font-family:"Songti SC",serif;font-size:34rpx;letter-spacing:3rpx}.hero-copy>view:nth-child(2){font-size:22rpx;color:#d4c7ad;margin-top:5rpx}.hero-copy>text{display:block;margin-top:13rpx;font-size:23rpx;color:#d9bd84}
.catalog-header{display:flex;justify-content:space-between;align-items:center;border-bottom:1rpx solid #3c3428;margin:30rpx 0 24rpx;color:#8c826f;font-size:22rpx}.filters{display:flex;gap:28rpx}.filters button{padding:14rpx 0;background:transparent;border-radius:0;color:#8b816c;font-size:25rpx;line-height:1.8;border-bottom:3rpx solid transparent}.filters button.active{color:#e1b97f;border-bottom-color:#c99c5f}
.product-grid{display:grid;grid-template-columns:1fr 1fr;gap:30rpx 20rpx}.product-card{min-width:0;padding:0;border-radius:0;text-align:left;background:transparent;line-height:1.6;color:#e7cfab}.product-picture{position:relative;height:354rpx;background:#181916;overflow:hidden}.product-picture image{width:100%;height:100%}.product-tag{position:absolute;left:12rpx;top:12rpx;padding:4rpx 10rpx;color:#dfcba0;background:rgba(18,19,16,.75);font-size:19rpx;letter-spacing:1rpx}.product-info{padding:16rpx 2rpx 0}.product-name{font-family:"Songti SC",serif;font-size:30rpx;line-height:1.5}.product-mood{font-size:20rpx;color:#a4947e;margin-top:4rpx}.product-price{display:flex;align-items:center;font-family:Georgia,serif;font-size:31rpx;margin-top:12rpx;color:#e1b97f}.product-price>text{font-family:sans-serif;font-size:18rpx;color:#968973;margin-left:10rpx}.product-price .product-arrow{margin-left:auto;font-size:28rpx}
.shop-note{text-align:center;color:#8e8270;font-size:20rpx;padding:28rpx 5rpx;border-bottom:1rpx solid #3c3428}.shop-story{text-align:center;padding:48rpx 0}.shop-story>view:last-child{font-family:"Songti SC",serif;font-size:36rpx;color:#ccb58f;letter-spacing:4rpx;margin-top:20rpx}.shop-story text{display:block}
.bag-bar{position:fixed;left:0;right:0;bottom:0;z-index:10;display:flex;align-items:center;height:104rpx;padding:0 30rpx;background:#171814;border-top:1rpx solid #3c3428}.bag-open{padding:0;background:transparent;color:#e7cfab;font-size:25rpx;line-height:1.6}.bag-open text{background:#c99c5f;color:#fff7e7;padding:2rpx 10rpx;border-radius:30rpx;margin-left:8rpx;font-size:21rpx}.bag-total{font-size:21rpx;color:#8a795c;flex:1;text-align:right;margin-right:22rpx}.bag-view{background:#b58c52;color:#e3d2ac;font-size:22rpx;line-height:60rpx;border-radius:2rpx;padding:0 18rpx}
.cart-row{display:flex;align-items:center;border-bottom:1rpx solid #3c3428;padding:22rpx 0}.cart-row image{width:82rpx;height:106rpx;flex:none}.cart-copy{flex:1;padding:0 16rpx;min-width:0}.cart-copy>view{font-family:serif;font-size:26rpx}.cart-copy>text{font-size:22rpx;color:#968059}.quantity{display:flex;align-items:center;gap:14rpx}.quantity button{padding:0;width:44rpx;height:52rpx;line-height:52rpx;font-size:25rpx;color:#e1b97f;background:#292820;border-radius:2rpx}.quantity text{font-size:24rpx}.cart-summary{display:flex;justify-content:space-between;margin:26rpx 0}.cart-note{font-size:21rpx;color:#8c806a;text-align:center;margin-top:18rpx}
.shop-page{padding-bottom:calc(260rpx + env(safe-area-inset-bottom))}.bag-bar{bottom:calc(110rpx + env(safe-area-inset-bottom))}.bag-view{background:#b58c52;color:#10110e}
