# 复制为 .env.production 后填写真实值；不要把 .env.production 提交到 Git。
ENVIRONMENT=production
AUTO_CREATE_SCHEMA=false
TESTING=false

# 域名（不要带 http:// 或路径）
SITE_DOMAIN=wusezhishi.com
API_DOMAIN=api.wusezhishi.com
CORS_ORIGINS=https://wusezhishi.com,https://www.wusezhishi.com

# PostgreSQL（请使用随机强密码）
POSTGRES_DB=folk_guide
POSTGRES_USER=folk_guide_app
POSTGRES_PASSWORD=replace-with-a-long-random-password

# 应用密钥（至少32/24位随机值）
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_API_KEY=replace-with-a-long-random-admin-key
ADMIN_SESSION_HOURS=8
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCK_MINUTES=15

# 真实微信凭据只放服务器；暂未配置时不要开放真实登录功能
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 正式开售前填写微信支付商户资料和容器内只读密钥路径，再将总开关改为true。
COMMERCE_ENABLED=false
COMMERCE_PENDING_MINUTES=15
COMMERCE_SHIPPING_FEE_FEN=1000
COMMERCE_FREE_SHIPPING_THRESHOLD_FEN=19900
COMMERCE_MERCHANT_NAME=请填写营业执照主体或店铺经营主体
COMMERCE_CUSTOMER_SERVICE=请填写客服电话或企业微信
COMMERCE_SHIPPING_ETA=付款后3个工作日内发货
WECHAT_PAY_MODE=wechat
WECHAT_PAY_MCH_ID=
WECHAT_PAY_CERT_SERIAL=
WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/wechat_pay_private_key.pem
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=/run/secrets/wechat_pay_public_key.pem
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://api.wusezhishi.com/api/payments/wechat/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://api.wusezhishi.com/api/payments/wechat/notify

# 模型未准备好时保持为空；联网搜索和知识库按方案保持关闭
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
AI_USE_KNOWLEDGE_BASE=false
AI_WEB_SEARCH_ENABLED=false
AI_WEB_SEARCH_ALWAYS=false

DAILY_SCHEDULER_ENABLED=true
KNOWLEDGE_STORAGE_ROOT=/app/storage/knowledge
