page { background: var(--canvas); color: var(--text); }
.ai-page { min-height: 100vh; padding: 0 32rpx calc(340rpx + env(safe-area-inset-bottom)); color: var(--text); background-color: #262626; background-image: linear-gradient(rgba(38, 38, 38, .88), rgba(25, 25, 25, .95)), var(--stone-texture); background-size: auto, 720rpx; }
.ai-heading { display: flex; min-height: 128rpx; align-items: center; justify-content: space-between; }
.ai-heading image { width: 164rpx; height: 116rpx; }
.ai-heading button { padding: 0 22rpx; color: #dfb378; background: #3b3936; border-radius: 30rpx; font-size:27rpx; line-height: 62rpx; }
.ai-intro { padding: 44rpx 0 32rpx; }
.ai-intro .eyebrow { font-size:24rpx; letter-spacing: 4rpx; }
.ai-title { margin-top: 14rpx; color: var(--cream); font-family: "Songti SC", serif; font-size:55rpx; line-height: 1.4; letter-spacing: 4rpx; }
.ai-subtitle { margin-top: 10rpx; color: var(--muted); font-size:30rpx; }
.service-strip { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 24rpx; background: #353432; border-radius: 18rpx; }
.service-strip>view { min-width: 0; flex: 1; }
.service-title { color: #eadfce; font-size:30rpx; }
.service-copy { margin-top: 4rpx; color: var(--muted); font-size:26rpx; }
.login-link { padding: 0; color: var(--copper); background: transparent; font-size:28rpx; }
.quota-number { color: var(--copper); font-family: Georgia, serif; font-size:37rpx; white-space: nowrap; }
.quota-number text { color: var(--muted); font-family: sans-serif; font-size:22rpx; }
.personal-panel { margin-top: 24rpx; padding: 0 22rpx; background: #393836; border-radius: 20rpx; box-shadow: 0 14rpx 34rpx rgba(0,0,0,.14); }
.personal-toggle { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; width: 100%; padding: 22rpx 0; color: var(--cream); background: transparent; border-radius: 0; line-height: 1.6; text-align: left; }
.personal-toggle>view { min-width: 0; flex: 1; }
.personal-toggle>view>view { font-family: "Songti SC", serif; font-size:31rpx; letter-spacing: 2rpx; }
.personal-toggle>view>text { color: var(--muted); font-size:23rpx; }
.personal-toggle>text { font-size:33rpx; }
.personal-content { padding: 18rpx 0; }
.personal-copy, .personal-detail { margin: 16rpx 0; color: #c9c1b5; font-size:28rpx; line-height: 1.85; }
.personal-summary { color: var(--cream); font-family: "Songti SC", serif; font-size:32rpx; line-height: 1.8; }
.personal-color-row { display: flex; align-items: center; gap: 15rpx; width: 100%; margin-top: 10rpx; padding: 19rpx; color: var(--text); background: #323230; border-radius: 14rpx; font-size:29rpx; line-height: 1.6; }
.personal-color-row>text:nth-last-child(2) { margin-left: auto; color: #d7b179; font-size:24rpx; }
.personal-dot { width: 18rpx; height: 18rpx; border-radius: 50%; background: #aaa; }
.personal-dot.green { background: #738557; } .personal-dot.black { background: #424b46; } .personal-dot.gold { background: #b38e46; } .personal-dot.white { background: #d6cbb7; } .personal-dot.red { background: #ac5650; }
.personal-detail { padding: 18rpx 8rpx; }
.personal-label { margin-top: 16rpx; color: var(--copper); font-size:23rpx; }
.incense-link { padding: 18rpx 0 0; color: var(--copper); background: transparent; font-size:25rpx; text-align: left; }
.profile-button { margin-top: 20rpx; color: #e0b67c; background: #403a34; border-radius: 32rpx; font-size:26rpx; line-height: 70rpx; }
.suggestion-title { margin: 34rpx 0 16rpx; color: var(--cream); font-family: "Songti SC", serif; font-size:36rpx; letter-spacing: 2rpx; }
.question-tabs { display: flex; justify-content: space-between; padding: 6rpx; background: #333230; border-radius: 18rpx; }
.question-tabs button { padding: 18rpx 0; color: #bbb9af; background: transparent; border-bottom: 2rpx solid transparent; border-radius: 0; font-size:26rpx; }
.question-tabs button.active { color: #e0b476; border-bottom-color: #bd8c51; }
.suggestions button { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; width: 100%; margin-top: 12rpx; padding: 24rpx; color: #e9e1d5; background: #383735; border-radius: 16rpx; font-size:30rpx; line-height: 1.7; text-align: left; }
.suggestions button>text:last-child { color: var(--copper); }
.conversation-heading { display: flex; align-items: center; gap: 24rpx; margin: 36rpx 0 24rpx; color: var(--muted); font-size:25rpx; }
.conversation-current { display: inline-block; padding: 10rpx 16rpx; color: #e4bd86; background: rgba(157,108,61,.16); border: 1rpx solid rgba(214,166,103,.72); border-radius: 24rpx; font-family: sans-serif; font-size: 27rpx; line-height: 1.25; }
.conversation-heading button { margin: 0; padding: 10rpx 16rpx; color: #e4bd86; background: rgba(157,108,61,.16); border: 1rpx solid rgba(214,166,103,.72); border-radius: 24rpx; font-family: sans-serif; font-size: 27rpx; line-height: 1.25; }
.history-panel { margin-bottom: 24rpx; padding: 12rpx; background: #333230; border-radius: 18rpx; }
.history-item { display: flex; flex-wrap: wrap; align-items: center; width: 100%; margin: 6rpx 0; padding: 0 18rpx; color: var(--text); background: #3d3b38; border-radius: 12rpx; }
.history-open { min-width: 0; flex: 1; padding: 18rpx 0; color: var(--text); background: transparent; text-align: left; }
.history-open view { overflow: hidden; font-size: 27rpx; white-space: nowrap; text-overflow: ellipsis; }
.history-open small { display: block; margin-top: 7rpx; color: var(--muted); font-size: 22rpx; }
.history-delete { flex: none; padding: 0 0 0 14rpx; color: #c47f6f; background: transparent; font-size: 22rpx; }
.history-detail { flex-basis: 100%; width: 100%; padding: 8rpx 0 18rpx; border-top: 1rpx solid rgba(214,166,103,.18); }
.history-detail-message { display: block; margin-top: 12rpx; padding: 14rpx; color: #d8d0c4; background: #353331; border-radius: 10rpx; font-size: 25rpx; line-height: 1.7; white-space: pre-wrap; }
.history-detail-message.user { color: #f0d2a9; background: #51463c; }
.history-detail-message .message-role { display: block; margin-bottom: 4rpx; font-size: 21rpx; }
.history-continue { margin-top: 16rpx; padding: 0 24rpx; color: #fffaf2; background: var(--copper-deep); border-radius: 6rpx; font-size: 25rpx; line-height: 58rpx; }
.history-empty { padding: 20rpx; color: var(--muted); font-size: 25rpx; }
.conversation-heading>view { height: 0; flex: 1; }
.message { margin-bottom: 24rpx; padding: 25rpx; color: var(--text); background: #383735; border-radius: 20rpx; box-shadow: 0 8rpx 18rpx rgba(12, 15, 13, .18); }
.message.user { margin-left: 44rpx; background: #5c4e40; }
.message-role { margin-bottom: 12rpx; color: #dfb275; font-size:26rpx; letter-spacing: 2rpx; }
.message-text { color: var(--text); font-size:33rpx; line-height: 1.95; overflow-wrap: anywhere; white-space: pre-wrap; }
.safety-note, .references { margin-top: 16rpx; color: #c4bcaf; font-size:26rpx; }
.references>text { color: var(--copper); }
.feedback-row { display: flex; gap: 20rpx; margin-top: 20rpx; }
.feedback-row button { padding: 0; color: #b5aa99; background: transparent; font-size:23rpx; }
.feedback-row button.chosen, .thinking { color: #e0b476; }
.thinking { padding: 10rpx 0; font-size:26rpx; }
.composer-wrap { position: fixed; z-index: 10; right: 0; bottom: calc(110rpx + env(safe-area-inset-bottom)); left: 0; padding: 20rpx 28rpx 14rpx; background: rgba(38,38,38,.98); }
.composer { display: flex; align-items: flex-end; gap: 10rpx; padding: 14rpx; background: #343331; border-radius: 22rpx; box-shadow: 0 0 0 1rpx rgba(194,143,84,.55); }
.composer textarea { min-height: 62rpx; max-height: 230rpx; flex: 1; width: auto; margin: 0; padding: 10rpx 6rpx; color: var(--text); background: transparent; border: 0; font-size:31rpx; line-height: 1.6; }
.composer button { flex: none; padding: 0 22rpx; color: #fffaf2; background: var(--copper-deep); border-radius: 4rpx; font-size:29rpx; line-height: 70rpx; }
.ai-disclaimer { padding-top: 11rpx; color: #b9b7ae; font-size:24rpx; letter-spacing: 1rpx; text-align: center; }
