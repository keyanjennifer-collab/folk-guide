@font-face {
  font-family: "Wuse Sans";
  src: url("https://api.wusezhishi.com/font-assets/wuse-sans.woff2") format("woff2"),
    url("./assets/fonts/wuse-sans.woff2") format("woff2");
  font-style: normal;
  font-weight: 400;
}

@font-face {
  font-family: "Wuse Serif";
  src: url("https://api.wusezhishi.com/font-assets/wuse-serif.woff2") format("woff2"),
    url("./assets/fonts/wuse-serif.woff2") format("woff2");
  font-style: normal;
  font-weight: 400;
}

page {
  --font-body: "Wuse Sans", "Noto Sans SC", "Noto Sans CJK SC", "HarmonyOS Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
  --font-display: "Wuse Serif", "Noto Serif SC", "Noto Serif CJK SC", "HarmonyOS Serif SC", "Source Han Serif SC", "Kaiti SC", "STKaiti", "STSong", serif;
  --font-numeric: "Wuse Sans", "Noto Sans SC", "Noto Sans CJK SC", "HarmonyOS Sans SC", "PingFang SC", "Roboto", sans-serif;
  --canvas: #262626;
  --canvas-deep: #1d1d1d;
  --surface: #343434;
  --surface-raised: #3e3e3e;
  --cream: #f1e7d8;
  --text: #e7dfd3;
  --muted: #b6b0a5;
  --copper: #d0a166;
  --copper-deep: #a97743;
  --line: #5d5953;
  --danger: #d79b90;
  --stone-texture: url("data:image/jpeg;base64,");
  min-height: 100%;
  background: var(--canvas);
  color: var(--text);
  font-family: var(--font-body);
  font-size:31rpx;
  line-height: 1.68;
}

/* 日间模式：月砚灰为主背景，素绢用于卡片和输入区域。 */
page.theme-day {
  --canvas: #D5D3CA;
  --canvas-deep: #cbc9c0;
  --surface: #E7E4DA;
  --surface-raised: #f0eee8;
  --cream: #34342F;
  --text: #34342F;
  --muted: #68675f;
  --copper: #756242;
  --copper-deep: #62543b;
  --line: #b8b5aa;
  --danger: #8c5149;
}

view, button, input, textarea, picker { box-sizing: border-box; }
button { margin: 0; font-family: inherit; font-weight: 400; }
button::after { border: 0; }
button[disabled] { opacity: .48; }
.price-figure { font-family: var(--font-numeric); font-weight: 500; letter-spacing: .5rpx; }
.page { min-height: 100vh; padding: 32rpx; }
.serif, .title, .section-title, .screen-title { font-family: var(--font-display); font-weight: 400; }
.title { margin-bottom: 20rpx; color: var(--cream); font-size:41rpx; letter-spacing: 3rpx; }
.eyebrow { color: var(--copper); font-size:26rpx; letter-spacing: 3rpx; }
.screen-heading { display: flex; align-items: flex-end; justify-content: space-between; padding-bottom: 26rpx; }
.screen-title { color: var(--cream); font-size:51rpx; line-height: 1.35; letter-spacing: 5rpx; }
.brand-logo { width: 126rpx; height: 106rpx; }
.card { margin-bottom: 24rpx; padding: 30rpx; color: var(--text); background: var(--surface); border-radius: 20rpx; box-shadow: 0 12rpx 28rpx rgba(8, 11, 9, .18); }
.muted { color: var(--muted); font-size:27rpx; }
.button, .solid-button { padding: 0 28rpx; color: #fffaf2; background: var(--copper-deep); border-radius: 6rpx; font-size:30rpx; line-height: 82rpx; }
.button { margin-top: 24rpx; }
.outline-button { padding: 0 26rpx; color: #e7bd83; background: #3b3936; border-radius: 32rpx; font-size:29rpx; line-height: 76rpx; }
.text-button { padding: 0; color: var(--copper); background: transparent; border-radius: 0; font-size:28rpx; line-height: 1.8; }
input, textarea, picker { display: block; width: 100%; min-height: 82rpx; padding: 20rpx 24rpx; color: var(--text); background: #323232; border: 2rpx solid #5a5650; border-radius: 14rpx; font-size:31rpx; line-height: 1.35; }
page.theme-day input, page.theme-day textarea, page.theme-day picker { background: var(--surface-raised); border-color: var(--line); }
input, picker { margin: 12rpx 0 24rpx; }
.empty-state { padding: 72rpx 26rpx; text-align: center; }
.empty-state .empty-mark { margin-bottom: 20rpx; color: var(--copper); font-family: var(--font-display); font-size:67rpx; }
.empty-state .empty-title { margin-bottom: 14rpx; color: var(--cream); font-family: var(--font-display); font-size:35rpx; }
.empty-state .outline-button { display: inline-block; margin-top: 30rpx; }
.page-foot { padding: 40rpx 20rpx; color: #9fa096; font-size:26rpx; letter-spacing: 2rpx; text-align: center; }
.scrim { position: fixed; z-index: 40; inset: 0; background: rgba(4, 6, 5, .66); }
.sheet { position: fixed; z-index: 41; right: 0; bottom: 0; left: 0; max-height: 78vh; padding: 32rpx 36rpx calc(32rpx + env(safe-area-inset-bottom)); overflow-y: auto; color: var(--text); background: #30302f; border-radius: 28rpx 28rpx 0 0; box-shadow: 0 -16rpx 44rpx rgba(7, 9, 8, .34); }
.sheet-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.sheet-title { color: var(--cream); font-family: var(--font-display); font-size:37rpx; }
.sheet-close { padding: 0 10rpx; color: var(--copper); background: transparent; font-size:41rpx; line-height: 1.5; }
.theme-toggle { position: absolute; top: 24rpx; right: 28rpx; z-index: 2; width: 68rpx; height: 58rpx; padding: 0; color: var(--cream); background: var(--surface); border: 1rpx solid var(--line); border-radius: 30rpx; font-size: 25rpx; line-height: 58rpx; }

/* 日间模式统一覆盖各页面的历史深色背景 */
.theme-day { color: #34342F; }
.theme-day input, .theme-day textarea, .theme-day picker { color: #34342F; background: #E7E4DA; border-color: #B8B5AA; }
