/*
 * AI 国学页：暖纸色、墨灰与少量哑金。
 * 页面只保留少量黛色用于识别，避免整页被深绿色覆盖。
 */
.ai-page{
  box-sizing:border-box;
  min-height:100vh;
  padding:24rpx 24rpx 56rpx;
  background:
    radial-gradient(circle at 94% 2%,rgba(176,142,83,.11),transparent 28%),
    linear-gradient(180deg,#f1ebe1,#f7f3eb 620rpx,#f3eee5);
  color:#363b36;
  font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;
}
.ai-page button::after{border:0}

/* 顶部顾问名片 */
.ai-hero{
  position:relative;
  overflow:hidden;
  min-height:0;
  padding:36rpx 32rpx 30rpx!important;
  border:1rpx solid #d2c09f!important;
  border-radius:10rpx!important;
  background:linear-gradient(145deg,#fbf7ef,#e9ddca)!important;
  color:#343a35!important;
  box-shadow:0 18rpx 45rpx rgba(71,62,46,.09)!important;
}
.ai-hero::before{content:"";position:absolute;right:-84rpx;top:-104rpx;width:300rpx;height:300rpx;border:1rpx solid rgba(157,128,73,.18);border-radius:50%}
.ai-hero::after{content:"";position:absolute;right:-20rpx;top:-42rpx;width:170rpx;height:170rpx;border:1rpx solid rgba(157,128,73,.12);border-radius:50%}
.hero-top,.hero-intro,.trial-row,.quota{position:relative;z-index:1}
.hero-top{display:flex;align-items:flex-start;justify-content:space-between}
.hero-identity{display:flex;align-items:center;min-width:0}
.advisor-logo{position:relative;display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:62rpx;height:62rpx;border:1rpx solid #a98b55;border-radius:50%;color:#8a7043}
.hero-advisor-logo{width:72rpx;height:72rpx;margin-right:20rpx;flex:0 0 72rpx;background:rgba(255,253,247,.5)}
.advisor-book{position:relative;display:flex;width:34rpx;height:25rpx}
.advisor-book text{box-sizing:border-box;width:17rpx;height:24rpx;border-bottom:1rpx solid currentColor}
.advisor-book text:first-child{border-left:1rpx solid currentColor;border-radius:0 0 0 8rpx;transform:skewY(10deg)}
.advisor-book text:last-child{border-right:1rpx solid currentColor;border-radius:0 0 8rpx 0;transform:skewY(-10deg)}
.advisor-book::after{content:"";position:absolute;top:2rpx;bottom:0;left:50%;width:1rpx;background:currentColor}
.advisor-spark{position:absolute;top:2rpx;right:4rpx;color:#ae8d4f;font-family:Georgia,"Times New Roman",serif;font-size:15rpx}
.eyebrow{color:#9b7f4e;font-family:Georgia,"Times New Roman",serif;font-size:14rpx;letter-spacing:3rpx;white-space:nowrap}
.hero-title{margin-top:3rpx;color:#38463f!important;font-family:"Songti SC","STSong","SimSun",serif!important;font-size:48rpx;font-weight:400;line-height:1.25;letter-spacing:6rpx}
.rule-button{width:auto;height:54rpx;margin:2rpx 0 0 18rpx;padding:0 15rpx;border:1rpx solid #b49a6b!important;border-radius:3rpx!important;background:rgba(255,253,248,.45)!important;color:#745f3b!important;font-size:20rpx;line-height:52rpx;white-space:nowrap}
.hero-intro{max-width:590rpx;margin-top:24rpx;color:#62665f;font-family:"Songti SC","STSong","SimSun",serif;font-size:24rpx;line-height:1.85;letter-spacing:1rpx}
.trial-row{display:flex;align-items:center;justify-content:space-between;margin-top:27rpx;padding:22rpx 21rpx;border-left:3rpx solid #ab8c51;background:rgba(255,253,248,.55)}
.trial-title{color:#434940;font-family:"Songti SC","STSong","SimSun",serif;font-size:27rpx;font-weight:400;letter-spacing:1rpx}
.trial-copy{max-width:455rpx;margin-top:5rpx;color:#777970;font-size:20rpx;line-height:1.55}
.trial-days{margin-left:18rpx;color:#846c42;font-family:Georgia,"Times New Roman",serif;font-size:43rpx;line-height:1;white-space:nowrap}
.trial-days text{margin-left:3rpx;font-family:inherit;font-size:18rpx}
.quota{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:15rpx;color:#6c6f68;font-size:19rpx}
.quota text{padding:6rpx 13rpx;border:1rpx solid rgba(168,143,96,.38);border-radius:24rpx;background:rgba(255,253,248,.42)}

/* 个人五色：与公共页保持同一套细线与圆形色印。 */
.result-card{
  position:relative;
  overflow:hidden;
  padding:34rpx 30rpx!important;
  border:1rpx solid #ded5c7!important;
  border-radius:8rpx!important;
  background:linear-gradient(145deg,#fffdf8,#f6f0e6)!important;
  box-shadow:0 14rpx 36rpx rgba(61,56,45,.06)!important;
}
.personal-color-card{margin-top:20rpx}
.result-head{display:flex;align-items:center;justify-content:space-between}
.section-kicker{color:#9a7f4c;font-family:Georgia,"Times New Roman",serif;font-size:15rpx;letter-spacing:3rpx}
.result-title{margin-top:5rpx;color:#3b4740!important;font-family:"Songti SC","STSong","SimSun",serif!important;font-size:39rpx;font-weight:400;letter-spacing:4rpx}
.result-badge{display:flex;align-items:center;justify-content:center;width:68rpx;height:68rpx;border:1rpx solid #a58a59;border-radius:50%;background:transparent!important;color:#846d42;font-family:"Songti SC","STSong","SimSun",serif;font-size:27rpx}
.personal-status{margin-top:18rpx;padding-top:17rpx;border-top:1rpx solid #e2dacd;color:#767b74;font-size:22rpx;line-height:1.7}
.personal-meta{display:flex;justify-content:space-between;margin-top:19rpx;color:#85887f;font-size:20rpx}
.personal-summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:20rpx}
.personal-summary-grid>view{padding:20rpx;border:1rpx solid #ddd5c8;background:rgba(255,253,248,.62)}
.personal-summary-grid text,.personal-focus-box>text,.personal-combination>text,.personal-comparison>text,.personal-detail-block>text,.personal-reason>text,.personal-calculation-note>text{display:block;margin-bottom:7rpx;color:#93794a;font-size:18rpx;letter-spacing:1rpx}
.personal-summary-grid strong{display:block;color:#404a43;font-family:"Songti SC","STSong","SimSun",serif;font-size:27rpx;font-weight:400;line-height:1.5}
.personal-focus-box{margin-top:14rpx;padding:21rpx;border-left:3rpx solid #a98a4d;background:#eee3d1}
.personal-focus-box strong{display:block;color:#484b44;font-size:23rpx;font-weight:500;line-height:1.75}
.personal-combination,.personal-comparison{margin-top:13rpx;padding:19rpx;border:1rpx solid #ded6c9;background:rgba(255,253,248,.62);color:#62665f;font-size:22rpx;line-height:1.75}
.personal-comparison{border-left:3rpx solid #8b9088;background:#efeee9}
.personal-comparison>text{color:#696e67}
.personal-detail-title{display:flex;align-items:flex-end;justify-content:space-between;margin-top:29rpx;padding-bottom:12rpx;border-bottom:1rpx solid #d9d1c4}
.personal-detail-title>text{color:#414a43;font-family:"Songti SC","STSong","SimSun",serif;font-size:28rpx;letter-spacing:2rpx}
.personal-detail-title>small{color:#92938c;font-size:18rpx}
.personal-ranking{margin:0}
.personal-color-item{border-bottom:1rpx solid #e0d9cd}
.personal-color-row{display:grid;grid-template-columns:35rpx 35rpx 1fr 43rpx 110rpx 31rpx;align-items:center;padding:20rpx 4rpx;color:#777b75;font-size:20rpx}
.personal-color-row strong{color:#414a44;font-family:"Songti SC","STSong","SimSun",serif;font-size:25rpx;font-weight:400}
.personal-rank{color:#a18755;font-family:Georgia,"Times New Roman",serif;font-size:21rpx}
.personal-swatch{box-sizing:border-box;width:24rpx;height:24rpx;border:1rpx solid rgba(61,65,59,.15);border-radius:50%;box-shadow:0 2rpx 6rpx rgba(45,46,40,.1)}
.personal-swatch.green{background:#47705c}.personal-swatch.black{background:#29312e}.personal-swatch.gold{background:#bea052}.personal-swatch.white{border-color:#afb6b0;background:#f8f6ef}.personal-swatch.red{background:#a2544b}
.personal-arrow{color:#987d4b;font-size:17rpx}
.personal-color-detail{padding:0 7rpx 23rpx 69rpx;color:#61665f;font-size:21rpx;line-height:1.75}
.personal-reason{margin-bottom:13rpx;padding:16rpx;border-left:3rpx solid #989d94;background:#efeee9}
.personal-reason>text{color:#686e66}
.personal-detail-block{padding:13rpx 0;border-top:1rpx dashed #ddd6ca}
.personal-suitable-list text{display:block}
.personal-incense{display:flex;align-items:center;justify-content:space-between;margin-top:12rpx;padding:16rpx;border-left:3rpx solid #a98a4d;background:#eee3d1}
.personal-incense>view{flex:1}.personal-incense text,.personal-incense strong,.personal-incense small{display:block}
.personal-incense text{color:#8f7749;font-size:17rpx}.personal-incense strong{color:#494c45;font-size:23rpx;font-weight:500}.personal-incense small{color:#777971;font-size:18rpx}
.personal-incense button{width:auto;height:52rpx;margin:0 0 0 12rpx;padding:0 14rpx;border:1rpx solid #9f8350!important;border-radius:2rpx;background:transparent!important;color:#715d3b!important;font-size:18rpx;line-height:50rpx}
.personal-calculation-note{margin-top:23rpx;padding-top:17rpx;border-top:1rpx solid #d9d1c4;color:#6f746d;font-size:20rpx;line-height:1.7}
.personal-reminders{margin-top:11rpx;color:#83867f;font-size:19rpx;line-height:1.7}.personal-reminders text{display:block}
.result-button{position:relative;margin:24rpx 0 0;border-radius:3rpx!important;background:#4b504b!important;color:#faf5ea!important;font-size:24rpx;letter-spacing:2rpx}

/* 问答能力说明 */
.knowledge-card{position:relative;overflow:hidden;margin-top:20rpx;padding:34rpx 30rpx;border:1rpx solid #ddd4c6;border-radius:8rpx;background:#faf7f0;box-shadow:0 13rpx 34rpx rgba(61,56,45,.05)}
.knowledge-mark{position:absolute;right:27rpx;top:28rpx;width:60rpx;height:60rpx;background:#f6efe3}
.knowledge-title{margin:8rpx 86rpx 12rpx 0;color:#404a43;font-family:"Songti SC","STSong","SimSun",serif;font-size:37rpx;font-weight:400;letter-spacing:4rpx}
.knowledge-copy{max-width:610rpx;color:#686d67;font-size:23rpx;line-height:1.85}
.status-list{margin-top:23rpx;border-top:1rpx solid #ddd5c8}
.status-row{display:flex;align-items:center;justify-content:space-between;padding:17rpx 0;border-bottom:1rpx solid #e5ded3;font-size:21rpx}
.status-row>text:first-child{color:#777b75}.status-row>text:last-child{max-width:460rpx;text-align:right}
.status-row.ready>text:last-child{color:#606f65}.status-row.waiting>text:last-child{color:#9a6754}
.loading-copy{padding-top:16rpx;color:#8b8e88;font-size:20rpx;text-align:center}

/* 推荐问题与聊天 */
.section-title{margin:38rpx 5rpx 18rpx;color:#414943!important;font-family:"Songti SC","STSong","SimSun",serif!important;font-size:32rpx;font-weight:400;letter-spacing:3rpx}
.section-line{display:flex;align-items:center}.section-rule{flex:1;height:1rpx;margin-left:22rpx;background:linear-gradient(90deg,#b49a67,transparent)}
.question-groups{display:flex;width:100%;white-space:nowrap}
.question-group{display:inline-block;box-sizing:border-box;width:520rpx;margin-right:16rpx;padding:23rpx;border:1rpx solid #ddd5c8!important;border-radius:7rpx!important;background:#fbf8f2!important;vertical-align:top;box-shadow:none!important}
.group-name{margin-bottom:13rpx;color:#796540;font-family:"Songti SC","STSong","SimSun",serif;font-size:25rpx;font-weight:400;letter-spacing:2rpx}
.question-button{width:100%;margin:7rpx 0;padding:16rpx 18rpx;border-left:2rpx solid #b39a6a!important;border-radius:2rpx!important;background:#f1ebe0!important;color:#4f554f!important;font-size:22rpx;text-align:left;line-height:1.5}
.question-button[disabled],.composer button[disabled]{opacity:.55}
.messages{padding:1rpx 0}
.message{box-sizing:border-box;max-width:88%;margin:17rpx 0;padding:21rpx 22rpx;border-radius:5rpx}
.message.assistant{margin-right:auto;border:1rpx solid #ddd5c8;background:#fcfaf5;box-shadow:4rpx 7rpx 17rpx rgba(55,53,46,.045)}
.message.user{margin-left:auto;border:1rpx solid #dacdb8;background:#ebe0cf;border-radius:16rpx 4rpx 16rpx 16rpx}
.message-role{margin-bottom:7rpx;color:#8d887c;font-size:18rpx;letter-spacing:1rpx}
.message-text{color:#444a45;font-size:24rpx;line-height:1.75;white-space:pre-wrap}
.safety-note{margin-top:12rpx;padding:10rpx 12rpx;border-left:3rpx solid #ad8b4d;background:#f0e6d5;color:#806b43;font-size:19rpx;line-height:1.55}
.references{margin-top:17rpx;padding:13rpx 13rpx 0;border-top:1rpx solid #ddd6ca;color:#797d77;font-size:19rpx}.reference-title{color:#856f45;font-weight:500}
.feedback-row{display:flex;gap:9rpx;margin-top:13rpx}.feedback{width:auto;margin:0;padding:0 15rpx;border:1rpx solid #d5cec2!important;border-radius:24rpx;background:transparent!important;color:#747870!important;font-size:19rpx;line-height:48rpx}.feedback.chosen{border-color:#a98c57!important;background:#eee4d3!important;color:#725e3c!important}
.composer{position:sticky;bottom:0;z-index:3;display:flex;align-items:flex-end;gap:10rpx;margin:22rpx -8rpx 0;padding:14rpx 8rpx;background:rgba(244,239,230,.94);backdrop-filter:blur(12rpx)}
.composer textarea{box-sizing:border-box;min-height:74rpx;max-height:190rpx;margin:0;padding:17rpx 18rpx;border:1rpx solid #d5cdc0;border-radius:5rpx;background:#fffdf8;color:#3f4540;font-size:23rpx;line-height:1.55}
.composer button{box-sizing:border-box;width:116rpx;height:74rpx;margin:0;padding:0;flex:0 0 116rpx;border-radius:4rpx!important;background:#4b504b!important;color:#fffaf0!important;font-size:22rpx;line-height:72rpx;letter-spacing:2rpx}
.disclaimer{padding:22rpx 13rpx;color:#90918b;font-size:19rpx;line-height:1.65;text-align:center}
