.home-page{min-height:100vh;color:#e7cfab;background:radial-gradient(circle at 18% 9%,rgba(255,255,255,.025),transparent 28%),linear-gradient(135deg,#121311,#090a09 46%,#151613);font-family:"Songti SC","STSong",serif}
.brandbar{height:140rpx;display:flex;justify-content:center;align-items:center}.brandbar .brand-logo{width:174rpx;height:122rpx}
.today{display:flex;height:990rpx;border-bottom:1rpx solid rgba(231,207,171,.2)}
.ranking{width:52%;flex:none;padding:22rpx 0 18rpx 34rpx;border-right:1rpx solid rgba(211,168,104,.34)}
.ranking-heading{padding-right:20rpx}.ranking .eyebrow{font-size:18rpx;color:#c99c5f;letter-spacing:2rpx;white-space:nowrap}
.today-title{font-size:59rpx;letter-spacing:6rpx;color:#ead3b0;line-height:1.2;margin-top:10rpx}
.today-subtitle{font-size:21rpx;color:#cdb99b;margin:14rpx 0 12rpx;letter-spacing:1rpx;white-space:nowrap}
.color-guide-button{display:flex;justify-content:space-between;align-items:center;width:100%;min-height:60rpx;padding:0 14rpx;border:1rpx solid rgba(225,185,127,.58);background:linear-gradient(100deg,rgba(201,156,95,.17),rgba(201,156,95,.045));color:#e1b97f;font-size:21rpx;line-height:1.5;border-radius:0;white-space:nowrap}
.color-guide-button text{font-size:19rpx;margin-left:8rpx;color:#edd0a1}
.rank-list{margin-top:22rpx;border:1rpx solid rgba(231,207,171,.12);border-right:0}
.rank-row{position:relative;display:flex;align-items:stretch;width:100%;height:122rpx;padding:0;border-radius:0;color:#eaddc8;border-bottom:1rpx solid rgba(231,207,171,.16);text-align:left;line-height:1.5;overflow:visible;transition:filter .2s}
.rank-row:last-child{border-bottom:0}.rank-row.selected{filter:brightness(1.17) saturate(1.06)}
.rank-row.selected:before{content:"";position:absolute;left:-18rpx;top:48rpx;border-top:13rpx solid transparent;border-bottom:13rpx solid transparent;border-left:16rpx solid #e1b97f}
.tone-green{background:linear-gradient(100deg,#303823,#62694d)}.tone-black{background:linear-gradient(100deg,#151616,#292b2b)}.tone-gold{background:linear-gradient(100deg,#874609,#b66d19)}.tone-white{background:linear-gradient(100deg,#9d8f7b,#cbbba2)}.tone-red{background:linear-gradient(100deg,#671012,#982126)}
.rank-no{width:74rpx;flex:none;display:flex;align-items:center;justify-content:center;border-right:1rpx solid rgba(244,227,201,.19);font-family:Georgia,serif;font-size:42rpx;color:#f1ddba}
.rank-copy{flex:1;min-width:0;display:flex;flex-direction:column;justify-content:center;padding:12rpx 8rpx 12rpx 18rpx}
.rank-main{display:flex;align-items:baseline;gap:6rpx;white-space:nowrap}.rank-color{font-size:29rpx;letter-spacing:1rpx}.rank-slash{font-size:20rpx;color:#d3ba97}.rank-status{font-size:18rpx;color:#f1ddbd}.rank-note{font-size:20rpx;color:#e6cfaa;margin-top:9rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tone-white .rank-color,.tone-white .rank-status,.tone-white .rank-no{color:#342e24}.tone-white .rank-note,.tone-white .rank-slash{color:#4e4434}
.calendar-line{font-size:17rpx;color:#9c8c70;padding:22rpx 18rpx 0 0;line-height:1.9}
.rank-empty{padding:40rpx 22rpx 40rpx 0;font-size:30rpx}.rank-empty>text{display:block;font-size:23rpx;color:#aa997e;margin:24rpx 0;line-height:1.9}.rank-empty .outline-button{font-size:23rpx;padding:0 16rpx}
.scent-stage{position:relative;width:48%;overflow:hidden;text-align:center;padding:28rpx 12rpx 0;background:radial-gradient(circle at 50% 55%,rgba(201,156,95,.07),transparent 56%)}
.scent-heading{position:relative;z-index:3;font-size:28rpx;color:#e1b97f;letter-spacing:3rpx}
.product-emblem{position:relative;z-index:3;width:104rpx;height:104rpx;margin:16rpx auto 0}
.scent-name{position:relative;z-index:3;color:#e1b97f;font-size:50rpx;line-height:1.2;letter-spacing:3rpx;margin-top:7rpx}
.scent-mood{position:relative;z-index:3;margin-top:8rpx;color:#d6c19f;font-size:24rpx;letter-spacing:3rpx}
.scent-notes{position:relative;z-index:3;margin:12rpx 0 0;font-size:18rpx;color:#bda887;white-space:nowrap}
.inline-aroma{position:relative;z-index:3;margin:16rpx 10rpx 0;padding-top:13rpx;border-top:1rpx solid rgba(225,185,127,.2);text-align:left}
.aroma-intro{font-size:18rpx;line-height:1.6;color:#c8b79d}
.aroma-notes{display:flex;margin-top:12rpx}.aroma-notes>view{width:33.33%;padding:0 6rpx;border-right:1rpx solid rgba(225,185,127,.16)}.aroma-notes>view:last-child{border:0}.aroma-notes text{font-size:16rpx;color:#c99c5f}.aroma-notes>view>view{font-size:17rpx;line-height:1.5;color:#ead5b5;white-space:nowrap}
.visual-frame{position:absolute;left:0;right:0;top:435rpx;bottom:0;background:#0a0b0a;overflow:hidden}
.product-visual{width:100%;height:100%;transform:scale(1.08);transform-origin:50% 100%}.visual-fade{position:absolute;inset:0;background:linear-gradient(to bottom,#0a0b0a,rgba(10,11,10,.18) 8%,transparent 22%,transparent 85%,rgba(10,11,10,.4))}
.aroma-button{position:absolute;z-index:5;bottom:22rpx;right:18rpx;border:1rpx solid #8a7149;background:rgba(14,15,12,.8);border-radius:30rpx;color:#ddbd85;font-size:21rpx;padding:0 16rpx;line-height:54rpx}
.gift{position:relative;height:390rpx;overflow:hidden;background:linear-gradient(120deg,#171815,#0a0b0a 62%,#191a16);border-bottom:1rpx solid rgba(231,207,171,.15)}
.gift-copy{position:relative;z-index:2;width:52%;padding:34rpx 0 0 34rpx}.gift-kicker{font-size:18rpx;color:#c99c5f;letter-spacing:2rpx;margin-bottom:14rpx}.gift-title{font-size:40rpx;line-height:1.3;color:#e1b97f;letter-spacing:2rpx}.gift-desc{font-size:21rpx;color:#c8b493;margin-top:12rpx;white-space:nowrap}.gift-price{font-family:Georgia,serif;font-size:48rpx;color:#e1b97f;margin:16rpx 0}.gift-price text{font-family:serif;font-size:18rpx;color:#a99574}.gift-button{display:inline-block;min-width:188rpx;height:64rpx;padding:0 24rpx;line-height:62rpx;background:linear-gradient(120deg,#e0b574,#b98142);border:1rpx solid #c99c5f;color:#17120c;border-radius:0;font-size:26rpx;letter-spacing:2rpx}
.gift-image{position:absolute;width:510rpx;height:380rpx;right:-106rpx;bottom:-18rpx;opacity:.82}
.home-links{display:flex;border-bottom:1rpx solid #3e382d}.home-links button{width:50%;padding:24rpx 34rpx;background:transparent;border-radius:0;text-align:left;color:#d0b78d;line-height:1.7}.home-links button+button{border-left:1rpx solid #3e382d}.home-links text{font-size:29rpx}.home-links view{font-size:21rpx;color:#a3906e;margin-top:6rpx}
.guide-status{color:#c99c5f;padding-bottom:20rpx;border-bottom:1rpx solid #3e382d}.guide-swatches{display:flex;padding-top:22rpx}.guide-swatches view{width:58rpx;height:58rpx;border-radius:50%;border:2rpx solid #d9bd92;margin-right:-8rpx}.detail-title{font-size:25rpx;color:#e1b97f;margin:24rpx 0 10rpx}.detail-text{font-size:27rpx;color:#cdbda5;line-height:1.9}.guide-note{margin-top:28rpx;font-size:22rpx}
.home-page{padding-bottom:calc(110rpx + env(safe-area-inset-bottom))}.visual-frame{top:530rpx}
