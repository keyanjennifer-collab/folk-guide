.explore-page { min-height: 100vh; padding: 38rpx 34rpx calc(60rpx + env(safe-area-inset-bottom)); color: var(--text); background-color: #262626; background-image: linear-gradient(rgba(38, 38, 38, .88), rgba(25, 25, 25, .95)), var(--stone-texture); background-size: auto, 720rpx; }
.explore-heading .screen-title { margin-top: 10rpx; font-size:60rpx; }
.explore-heading>text { display: block; margin-top: 14rpx; color: var(--muted); font-size:31rpx; }
.explore-tabs { display: flex; margin: 36rpx 0; border-bottom: 1rpx solid var(--line); }
.explore-tabs button { flex: 1; padding: 22rpx 0; color: #aaaca2; background: transparent; border-bottom: 3rpx solid transparent; border-radius: 0; font-size:32rpx; line-height: 1.7; }
.explore-tabs button.active { color: #e4bd83; border-color: #c38f52; }
.section-title { margin: 30rpx 0 14rpx; color: var(--cream); font-size:43rpx; }
.section-copy { color: #bbb4a8; font-size:32rpx; line-height: 1.85; }
.idea-card, .answer-card { display: block; width: 100%; margin-top: 24rpx; padding: 30rpx; color: var(--text); background: linear-gradient(145deg, #3d3b38, #31302f); border-radius: 20rpx; box-shadow: 0 11rpx 24rpx rgba(11, 14, 12, .2); line-height: 1.8; text-align: left; }
.idea-tag, .question-label { color: #d6a66c; font-size:29rpx; letter-spacing: 2rpx; }
.idea-title { display: flex; justify-content: space-between; margin-top: 8rpx; color: var(--cream); font-family: "Songti SC", serif; font-size:37rpx; }
.idea-copy { margin-top: 20rpx; color: #c4bdb1; font-size:32rpx; }
.note { margin-top: 32rpx; color: #aaa99f; font-size:29rpx; line-height: 1.9; }
.taste-step { margin: 36rpx 0; }
.question-title { margin: 14rpx 0 26rpx; color: var(--cream); font-family: "Songti SC", serif; font-size:41rpx; line-height: 1.7; }
.taste-options, .quiz-options { display: flex; flex-direction: column; gap: 16rpx; }
.taste-options button, .quiz-options button { padding: 24rpx; color: #e9e0d2; background: #373634; border-radius: 16rpx; font-size:33rpx; line-height: 1.7; text-align: left; }
.taste-options button.selected, .quiz-options button.correct { color: #fffaf2; background: #a97a46; border-color: #dda96c; }
.taste-result { display: flex; gap: 26rpx; padding: 28rpx 0; border-top: 1rpx solid var(--line); }
.taste-result image { width: 230rpx; height: 340rpx; flex: none; border-radius: 6rpx; }
.taste-result>view { min-width: 0; flex: 1; }
.result-title { margin: 14rpx 0; color: var(--cream); font-family: "Songti SC", serif; font-size:52rpx; }
.taste-result .eyebrow { font-size:28rpx; letter-spacing: 0; }
.taste-result .outline-button { margin-top: 18rpx; padding: 0 16rpx; font-size:30rpx; }
.reset-taste { margin-top: 17rpx; font-size:29rpx; }
.quiz-options { gap: 20rpx; }
.quiz-options button { display: flex; align-items: center; gap: 20rpx; }
.quiz-options button[disabled] { opacity: 1; }
.quiz-options button>text:last-child { margin-left: auto; }
.quiz-options button.selected { border-width: 3rpx; }
.answer-card { font-size:33rpx; }
.answer-title { margin-bottom: 16rpx; color: #efc58b; font-family: "Songti SC", serif; font-size:37rpx; }
.source-link { display: block; padding: 22rpx 0; color: var(--copper); background: transparent; font-size:29rpx; line-height: 1.8; text-align: left; }
