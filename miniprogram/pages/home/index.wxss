.home-page { min-height: 100vh; padding-bottom: calc(118rpx + env(safe-area-inset-bottom)); color: #eee4d5; background-color: var(--canvas); background-image: linear-gradient(180deg, rgba(38,38,38,.88), rgba(31,31,31,.96)), var(--stone-texture); background-size: auto, 760rpx; font-family: "Songti SC", "STSong", serif; }
button { font-family: inherit; }
.brandbar { position: relative; display: flex; height: 132rpx; align-items: center; justify-content: center; padding: 0 30rpx; }
.brand-logo { width: 210rpx; height: 122rpx; }
.eyebrow,.section-kicker { color: #d3a56f; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size:25rpx; letter-spacing: 3rpx; }
.loading-card,.reload-card,.overview-card { margin: 0 24rpx; padding: 32rpx; background: rgba(54,53,51,.94); border-radius: 28rpx; box-shadow: 0 16rpx 42rpx rgba(0,0,0,.15); }
.overview-card { overflow: hidden; background: linear-gradient(145deg,rgba(67,63,57,.98),rgba(48,47,45,.98) 40%,rgba(53,52,50,.97)); }
.today-heading { position: relative; padding: 2rpx 4rpx 8rpx; }
.today-date { color: #d8aa72; font-family: -apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; font-size:26rpx; letter-spacing: 1rpx; }
.today-title { margin-top: 10rpx; color: #f5eadb; font-size:59rpx; line-height: 1.25; letter-spacing: 7rpx; }
.today-lunar { margin-top: 10rpx; color: #c9bfb2; font-family: -apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; font-size:26rpx; line-height: 1.65; }
.date-strip { width: 100%; margin-top: 24rpx; white-space: nowrap; }
.date-option { display: inline-flex; width: 112rpx; height: 86rpx; margin-right: 10rpx; padding: 10rpx 6rpx; flex-direction: column; align-items: center; justify-content: center; color: #cfc3b4; background: rgba(30,29,28,.42); border: 1rpx solid rgba(224,190,145,.16); border-radius: 16rpx; line-height: 1.25; }
.date-option:last-child { margin-right: 0; }
.date-option text { font-family: sans-serif; font-size: 25rpx; }
.date-option .date-weekday { margin-top: 7rpx; color: #9f968b; font-family: sans-serif; font-size: 21rpx; }
.date-option.active { color: #f5dfbe; background: rgba(157,108,61,.48); border-color: rgba(226,181,123,.75); box-shadow: inset 0 0 0 2rpx rgba(236,198,149,.18); }
.date-option.active .date-weekday { color: #e6bf8e; }
.skeleton { width: 68%; height: 28rpx; margin-top: 22rpx; background: linear-gradient(90deg,#454545,#53504c,#454545); border-radius: 20rpx; animation: breathe 1.5s ease-in-out infinite; }.skeleton.wide{width:92%;height:48rpx;margin-top:0}.skeleton.short{width:44%}@keyframes breathe{50%{opacity:.45}}
.reload-card { display: flex; align-items: center; gap: 20rpx; }
.reload-mark { display: flex; width: 82rpx; height: 82rpx; flex: none; align-items: center; justify-content: center; color: #e2bc89; background: #45413c; border-radius: 50%; font-size:39rpx; }
.reload-copy { flex: 1; }.reload-copy>view{font-size:29rpx}.reload-copy text{display:block;margin-top:8rpx;color:#aaa197;font-family:sans-serif;font-size:23rpx;line-height:1.6}.reload-card button{padding:0 20rpx;color:#e6bc84;background:#4a4137;border-radius:30rpx;font-size:24rpx;line-height:62rpx}
.section-title { margin-top: 10rpx; color: #f1e6d7; font-size:49rpx; letter-spacing: 4rpx; }
.section-intro { margin-top: 13rpx; color: #b8afa5; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size:28rpx; line-height: 1.75; }
.rank-pills { display: flex; gap: 10rpx; margin-top: 24rpx; }
.rank-pill { min-width: 0; height: 142rpx; flex: 1; padding: 13rpx 4rpx; color: #f5eadc; border-radius: 17rpx; line-height: 1.25; text-shadow: 0 2rpx 5rpx rgba(0,0,0,.28); }
.rank-pill>text:first-child { display:block;color:rgba(247,237,223,.78);font-family:Georgia,serif;font-size:23rpx}.rank-pill view{margin-top:9rpx;font-size:28rpx;white-space:nowrap}.rank-pill .rank-tier{display:block;margin-top:8rpx;color:rgba(249,239,224,.8);font-family:sans-serif;font-size:22rpx;white-space:nowrap}.rank-pill.active{box-shadow:inset 0 0 0 3rpx rgba(245,224,196,.78),0 8rpx 20rpx rgba(0,0,0,.18)}.rank-pill.tone-white{background:linear-gradient(155deg,#77736d,#45433f)}.rank-pill.tone-gold{background:linear-gradient(155deg,#8a693b,#4b4034)}.rank-pill.tone-green{background:linear-gradient(155deg,#647454,#394038)}.rank-pill.tone-red{background:linear-gradient(155deg,#8c4b47,#493837)}.rank-pill.tone-black{background:linear-gradient(155deg,#424a46,#202524)}
.featured { display: flex; min-height: 320rpx; margin-top: 20rpx; overflow: hidden; background: #d8cdbc; border-radius: 22rpx; }
.featured-copy { z-index: 2; width: 52%; padding: 30rpx 0 28rpx 28rpx; color: #51483e; }
.featured-label { color:#8f673d;font-size:25rpx;letter-spacing:2rpx}.featured-name{margin-top:10rpx;font-size:53rpx;letter-spacing:4rpx}.featured-mood{margin-top:6rpx;color:#725f49;font-size:27rpx}.featured-text{margin-top:18rpx;color:#5f564d;font-family:sans-serif;font-size:26rpx;line-height:1.7}.featured-copy button{display:inline-block;margin-top:20rpx;padding:0 23rpx;color:#f8eee1;background:#5a4b3b;border-radius:30rpx;font-size:26rpx;line-height:64rpx}
.featured-image-wrap{position:relative;width:48%;overflow:hidden}.featured-image{width:100%;height:100%}.featured-image-wrap::after{position:absolute;inset:0;background:linear-gradient(90deg,#d8cdbc 0%,rgba(216,205,188,.18) 45%,rgba(36,32,28,.05));content:""}
.detail-section { padding: 48rpx 24rpx 10rpx; }
.rule-basis-card { display: flex; gap: 22rpx; margin-top: 24rpx; padding: 24rpx; background: linear-gradient(145deg,rgba(82,73,63,.84),rgba(55,53,50,.96)); border-radius: 22rpx; box-shadow: 0 14rpx 36rpx rgba(0,0,0,.14); }
.rule-seal { display: flex; width: 102rpx; height: 112rpx; flex: none; flex-direction: column; align-items: center; justify-content: center; color: #f0d4ad; background: rgba(28,27,26,.34); border: 2rpx solid rgba(210,164,108,.62); border-radius: 18rpx; }
.rule-seal text { font-size:46rpx; line-height: 1; }
.rule-seal view { margin-top: 9rpx; color: #d3a56f; font-family: -apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; font-size:22rpx; letter-spacing: 3rpx; }
.rule-basis-copy { min-width: 0; flex: 1; }
.rule-basis-title { color: #efd9bb; font-size:31rpx; letter-spacing: 2rpx; }
.rule-basis-text { margin-top: 10rpx; color: #d5ccc0; font-family: -apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; font-size:26rpx; line-height: 1.75; }
.source-note text { display: block; }
.guide-card { margin-top: 22rpx; padding: 26rpx; background: #3a3937; border-radius: 24rpx; box-shadow: 0 18rpx 44rpx rgba(0,0,0,.16); }
.tone-card-white{background:linear-gradient(145deg,#4b4844,#373635)}.tone-card-gold{background:linear-gradient(145deg,#514536,#383634)}.tone-card-green{background:linear-gradient(145deg,#42483d,#353735)}.tone-card-red{background:linear-gradient(145deg,#4b3b39,#373535)}.tone-card-black{background:linear-gradient(145deg,#333736,#2f3030)}
.guide-head { display:flex;align-items:center }.guide-rank{color:#d5a66e;font-family:Georgia,serif;font-size:39rpx}.guide-identity{margin-left:20rpx}.guide-identity>view{font-size:39rpx;letter-spacing:3rpx}.guide-identity text{display:block;margin-top:5rpx;color:#c2b7aa;font-family:sans-serif;font-size:25rpx}.guide-actions{display:flex;margin-left:auto;flex-direction:column;align-items:flex-end;gap:9rpx}.status-chip{padding:9rpx 16rpx;color:#f0d5b1;background:rgba(190,136,75,.24);border-radius:30rpx;font-family:sans-serif;font-size:24rpx}.guide-actions button{padding:0;color:#e4ba83;background:transparent;font-family:sans-serif;font-size:25rpx;line-height:1.6}
.swatch-row{display:flex;align-items:center;margin-top:24rpx}.swatch-row>view{width:44rpx;height:44rpx;margin-right:-5rpx;border:2rpx solid rgba(237,222,202,.55);border-radius:50%}.swatch-row>text{margin-left:20rpx;color:#c8beb2;font-family:sans-serif;font-size:25rpx}
.advice-panel{margin-top:25rpx;padding:27rpx;background:rgba(24,24,24,.2);border-radius:18rpx}.relation-explanation{margin-bottom:24rpx;padding:20rpx;background:rgba(213,166,111,.1);border-radius:14rpx}.relation-explanation text{display:block;color:#d9ad76;font-family:sans-serif;font-size:25rpx;letter-spacing:2rpx}.relation-explanation view{margin-top:8rpx;color:#eee2d4;font-family:sans-serif;font-size:28rpx;line-height:1.7}.micro-title{margin-top:24rpx;color:#e1b984;font-size:27rpx;letter-spacing:2rpx}.micro-title:first-child{margin-top:0}.suitable-list{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:14rpx}.suitable-list text{padding:11rpx 17rpx;color:#eee2d4;background:rgba(234,213,184,.11);border-radius:30rpx;font-family:sans-serif;font-size:26rpx}.body-copy{margin-top:12rpx;color:#e6dccf;font-family:sans-serif;font-size:29rpx;line-height:1.85}.notice{display:flex;gap:14rpx;margin-top:22rpx;padding:20rpx;background:rgba(10,10,10,.16);border-radius:14rpx}.notice text{flex:none;color:#d5a66f;font-size:26rpx}.notice view{color:#c9bfb3;font-family:sans-serif;font-size:26rpx;line-height:1.75}
.product-row{display:flex;align-items:center;margin-top:22rpx}.product-row>view{min-width:0;flex:1}.product-row>view text{color:#bdb2a5;font-family:sans-serif;font-size:24rpx}.product-row>view view{margin-top:5rpx;font-size:28rpx}.product-row button{padding:0 20rpx;color:#f1ca96;background:#4d443b;border-radius:28rpx;font-size:26rpx;line-height:62rpx}
.source-note{padding:34rpx 12rpx;color:#9d958c;font-family:sans-serif;font-size:24rpx;line-height:1.8;text-align:center}
.gift{position:relative;height:426rpx;margin:10rpx 24rpx 0;overflow:hidden;background:linear-gradient(115deg,rgba(67,61,54,.98),rgba(39,38,37,.9) 67%);border-radius:26rpx;box-shadow:0 20rpx 50rpx rgba(0,0,0,.2)}.gift-copy{position:relative;z-index:2;width:62%;padding:42rpx 0 0 32rpx}.gift-kicker{color:#d3a66c;font-size:24rpx;letter-spacing:2rpx}.gift-title{margin-top:14rpx;color:#f0dfc7;font-size:43rpx;line-height:1.35}.gift-desc{margin-top:10rpx;color:#c9beb1;font-family:sans-serif;font-size:25rpx}.gift-price{margin:18rpx 0;color:#e6bc82;font-family:"Avenir Next","DIN Alternate","Helvetica Neue",sans-serif;font-size:47rpx}.gift-price text{color:#bdb4a7;font-family:sans-serif;font-size:23rpx}.gift-button{display:inline-block;padding:0 25rpx;color:#fff7ec;background:#9a6b3f;border-radius:30rpx;font-size:28rpx;line-height:66rpx}.gift-image{position:absolute;right:-110rpx;bottom:-6rpx;width:520rpx;height:390rpx;opacity:.82}
.personal-lock-card { display: flex; align-items: center; gap: 18rpx; margin: 22rpx 24rpx 0; padding: 28rpx; background: linear-gradient(145deg,rgba(70,65,59,.98),rgba(44,43,41,.98)); border: 1rpx solid rgba(210,164,108,.25); border-radius: 24rpx; box-shadow: 0 16rpx 40rpx rgba(0,0,0,.16); }.personal-lock-copy { min-width: 0; flex: 1; }.personal-lock-kicker { color: #c99b62; font-family: -apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; font-size: 19rpx; letter-spacing: 2rpx; }.personal-lock-title-row { display: flex; align-items: center; gap: 14rpx; margin-top: 7rpx; }.personal-lock-title { color: #f0e3d1; font-size: 35rpx; letter-spacing: 3rpx; }.personal-lock-status { padding: 5rpx 12rpx; color: #d7b17c; background: rgba(193,139,77,.14); border: 1rpx solid rgba(211,165,105,.38); border-radius: 20rpx; font-family: -apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; font-size: 19rpx; letter-spacing: 1rpx; }.personal-lock-copy>text { display: block; margin-top: 6rpx; color: #bfb5a8; font-family: -apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; font-size: 24rpx; line-height: 1.65; }.personal-lock-card button { flex: none; padding: 0 18rpx; color: #f0c58b; background: rgba(151,103,59,.32); border-radius: 28rpx; font-size: 24rpx; line-height: 58rpx; }
.personal-ready-card { align-items: flex-start; }.personal-home-details { margin-top: 18rpx; }.personal-home-row { padding: 13rpx 0; border-top: 1rpx solid rgba(211,165,105,.17); }.personal-home-row>text { color: #ead7bd; font-size: 25rpx; }.personal-home-row>view { margin-top: 5rpx; color: #bfb5a8; font-family: -apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; font-size: 22rpx; line-height: 1.55; }
.page-foot{padding:32rpx 20rpx 46rpx;color:#918981;font-size:25rpx;letter-spacing:2rpx;text-align:center}

.home-page.theme-day { color: #34342F; background-color: #D5D3CA !important; background-image: none !important; }
.home-page.theme-day .card, .home-page.theme-day [class*='panel'], .home-page.theme-day [class*='card'], .home-page.theme-day [class*='sheet'], .home-page.theme-day [class*='dialog'] { color: #34342F; background: #E7E4DA; border-color: #B8B5AA; }
.home-page.theme-day .muted, .home-page.theme-day .caption, .home-page.theme-day .field-note { color: #68675F; }

