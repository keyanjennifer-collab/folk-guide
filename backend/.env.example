# 复制为 .env 后填写。不要把真实密钥提交到Git或发送到聊天中。
APP_NAME=五行五色 API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./folk_guide.db

# 至少32位随机字符串；生产环境请使用服务器密钥管理。
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=10080

# 真实微信登录；仅后端保存。
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 任意OpenAI兼容的聊天补全服务。三个字段必须同时填写，然后重启后端。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1200

# AI安全复核和费用边界。模型答案先经过后端复核，超长答案会截断。
AI_MAX_OUTPUT_CHARS=6000
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_MAX_REQUESTS=6
AI_TRIAL_NORMAL_LIMIT=20
AI_TRIAL_COMPARISON_LIMIT=2
AI_PAID_NORMAL_LIMIT=50
AI_PAID_COMPARISON_LIMIT=5

# AI问答内部策略。当前先直接调用模型；未来知识库准备好后改为true并重启后端。
AI_USE_KNOWLEDGE_BASE=false

# 可选联网搜索。false时完全关闭，不会请求任何搜索服务；打开时填写Tavily Key。
# 默认只对“最新、实时、来源、查一下”等问题搜索；如需每个问题都搜，再改为true。
AI_WEB_SEARCH_ENABLED=false
AI_WEB_SEARCH_ALWAYS=false
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=https://api.tavily.com
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_SEARCH_MAX_RESULTS=5

# 北京时间每日00:00自动生成：公共未来7天、有效权益用户个人未来3天。
# 多进程通过数据库任务租约防重复；失败默认重试3次。
DAILY_SCHEDULER_ENABLED=true
DAILY_CACHE_BATCH_SIZE=100
DAILY_CACHE_RETRY_ATTEMPTS=3
DAILY_CACHE_RETRY_SECONDS=10
DAILY_CACHE_LEASE_MINUTES=30

# 留空时使用项目storage/knowledge；生产可填写对象存储挂载目录。
KNOWLEDGE_STORAGE_ROOT=

# PDF解析：文字型PDF始终先在本地读取。只有显式开启后，扫描版才发送到指定MinerU服务。
PDF_MAX_PAGES=1000
PDF_MIN_TEXT_CHARS_PER_PAGE=20
PDF_MIN_OCR_CONFIDENCE=0.80
MINERU_ENABLED=false
MINERU_BASE_URL=
MINERU_TIMEOUT_SECONDS=1200

# 原型后台Key。生产环境必须替换为正式管理员账号与权限系统。
ADMIN_API_KEY=replace-with-a-long-random-admin-key
