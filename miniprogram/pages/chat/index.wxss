.ai-page { min-height: 100vh; padding: 0 32rpx calc(340rpx + env(safe-area-inset-bottom)); color: var(--text); background-color: var(--canvas); background-image: linear-gradient(rgba(38, 38, 38, .88), rgba(25, 25, 25, .95)), var(--stone-texture); background-size: auto, 720rpx; }
