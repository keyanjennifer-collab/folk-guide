.mine-page { min-height: 100vh; padding: 20rpx 34rpx calc(110rpx + env(safe-area-inset-bottom)); color: var(--text); background-color: var(--canvas); background-image: linear-gradient(rgba(38, 38, 38, .88), rgba(25, 25, 25, .95)), var(--stone-texture); background-size: auto, 720rpx; }
.mine-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 26rpx; }
.mine-heading .brand-logo { width: 96rpx; height: 82rpx; }
.mine-heading .screen-title { font-size:53rpx; }
.identity-card { padding: 34rpx; color: var(--text); background: linear-gradient(145deg, #403e3a, #32312f); border-radius: 22rpx; box-shadow: 0 14rpx 30rpx rgba(11, 14, 12, .24); }
.identity-top { display: flex; align-items: center; }
.identity-avatar { width: 98rpx; height: 98rpx; flex: none; border-radius: 50%; }
.identity-seal { display: flex; width: 98rpx; height: 98rpx; flex: none; align-items: center; justify-content: center; color: #dfb77d; border: 1rpx solid #bc8b53; border-radius: 50%; font-family: var(--font-display); font-size:47rpx; }
.identity-copy { min-width: 0; padding-left: 24rpx; }
.identity-title { color: var(--cream); font-family: var(--font-display); font-size:37rpx; letter-spacing: 3rpx; }
.identity-subtitle { margin-top: 8rpx; color: var(--muted); font-size:27rpx; }
.profile-edit-hint { margin-top: 8rpx; color: #c79d68; font-size: 22rpx; }
.login-button { width: 100%; margin-top: 30rpx; color: #fffaf2; background: var(--copper-deep); border-radius: 5rpx; font-size:31rpx; line-height: 80rpx; letter-spacing: 4rpx; }
.identity-footer { display: flex; justify-content: space-between; margin-top: 28rpx; padding-top: 22rpx; color: var(--muted); font-size:23rpx; }
.identity-action { padding: 0; color: var(--copper); background: transparent; font-size:24rpx; }
.account-error { margin-top: 20rpx; color: #e1b58b; font-size:25rpx; }
.identity-profile-edit { display: flex; align-items: center; gap: 14rpx; margin-top: 22rpx; padding-top: 18rpx; border-top: 1rpx solid rgba(220,190,150,.16); }
.avatar-edit-button { display: flex; width: 116rpx; padding: 0; flex-direction: column; align-items: center; color: var(--copper); background: transparent; font-size: 21rpx; line-height: 1.4; }
.avatar-edit-preview { width: 64rpx; height: 64rpx; margin-bottom: 5rpx; border-radius: 50%; }
.nickname-input { min-width: 0; flex: 1; height: 64rpx; padding: 0 14rpx; color: var(--text); background: rgba(0,0,0,.16); border-radius: 10rpx; font-size: 26rpx; }
.save-profile-button { padding: 0 14rpx; color: #fff5e8; background: var(--copper-deep); border-radius: 22rpx; font-size: 22rpx; line-height: 58rpx; }
.orders-panel, .service-panel { margin-top: 20rpx; padding: 28rpx; background: #343331; border-radius: 20rpx; }
.panel-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.panel-title { color: var(--cream); font-family: var(--font-display); font-size:34rpx; letter-spacing: 3rpx; }
.panel-heading .text-button { font-size:25rpx; }
.order-entries { display: flex; justify-content: space-between; padding: 6rpx 0; }
.order-entry { width: 25%; padding: 0 4rpx; color: #d0c8bd; background: transparent; border-radius: 0; font-size:27rpx; line-height: 1.6; }
.order-symbol { position: relative; width: 52rpx; height: 44rpx; margin: 8rpx auto 18rpx; border: 1.5rpx solid #c0955b; border-radius: 4rpx; }
.order-symbol::before { position: absolute; top: 11rpx; right: 8rpx; left: 8rpx; border-top: 1rpx solid #c0955b; content: ""; }
.order-symbol.box::before { top: 0; bottom: 0; left: 50%; border-top: 0; border-left: 1rpx solid #c0955b; }
.order-symbol.delivery { border-radius: 4rpx 14rpx 4rpx 4rpx; }
.order-symbol.delivery::after { position: absolute; bottom: -7rpx; left: 7rpx; width: 9rpx; height: 9rpx; background: var(--canvas); border: 1rpx solid #c0955b; border-radius: 50%; box-shadow: 26rpx 0 var(--canvas); content: ""; }
.order-symbol.service { width: 44rpx; height: 44rpx; border-radius: 50%; }
.order-symbol.service::before { top: 13rpx; left: 12rpx; width: 16rpx; height: 10rpx; border: 1rpx solid #c0955b; border-radius: 50%; }
.order-count { position: absolute; top: -14rpx; right: -20rpx; min-width: 28rpx; color: #ddb071; background: var(--canvas); font-size:22rpx; line-height: 28rpx; text-align: center; }
.profile-link { display: flex; align-items: center; width: 100%; margin-top: 18rpx; padding: 28rpx; color: #dec298; background: #373634; border-radius: 20rpx; line-height: 1.6; text-align: left; }
.profile-seal { width: 68rpx; height: 68rpx; flex: none; margin-right: 22rpx; color: #d4aa70; border: 1rpx solid #b99660; border-radius: 50%; font-family: var(--font-display); font-size:33rpx; line-height: 68rpx; text-align: center; }
.profile-title { color: var(--cream); font-family: var(--font-display); font-size:32rpx; letter-spacing: 3rpx; }
.profile-link .muted { margin-top: 4rpx; font-size:26rpx; }
.arrow { margin-left: auto; padding-left: 16rpx; color: #d6ab71; font-size:33rpx; }
.service-label { color: #aaa99f; font-size:23rpx; letter-spacing: 2rpx; }
.service-link { display: flex; align-items: center; width: 100%; padding: 13rpx 0; color: #dec298; background: transparent; border-radius: 0; line-height: 1.7; text-align: left; }
.service-copy { min-width: 0; flex: 1; }
.service-title { font-size:28rpx; }
.service-description { display: block; max-width: 500rpx; overflow: hidden; color: var(--muted); font-size:26rpx; text-overflow: ellipsis; white-space: nowrap; }
.history-link { margin-top: 6rpx; }
.menu-panel { margin-top: 14rpx; }
.menu-row { display: flex; align-items: center; justify-content: space-between; width: 100%; margin-top: 10rpx; padding: 24rpx; color: #e7cba0; background: #333230; border-radius: 15rpx; font-size:31rpx; line-height: 1.8; text-align: left; }
.menu-value { color: var(--muted); font-size:27rpx; }
.logout-button { margin: 32rpx auto 0; color: #d2a367; background: transparent; border: 1rpx solid #826344; border-radius: 5rpx; font-size:26rpx; line-height: 72rpx; letter-spacing: 3rpx; }
.info-overlay { position: fixed; z-index: 80; top: 0; right: 0; bottom: calc(110rpx + env(safe-area-inset-bottom)); left: 0; display: flex; align-items: flex-end; padding-top: 90rpx; background: rgba(10,10,10,.72); backdrop-filter: blur(10rpx); }
.info-dialog { position: relative; display: flex; width: 100%; max-height: 100%; flex-direction: column; padding: 30rpx 34rpx 24rpx; overflow: hidden; color: var(--text); background-color: #343331; background-image: linear-gradient(145deg,rgba(68,63,57,.96),rgba(42,41,39,.99)),var(--stone-texture); background-size: auto,720rpx; border-radius: 30rpx 30rpx 0 0; box-shadow: 0 -22rpx 60rpx rgba(0,0,0,.4); }
.info-halo { position: absolute; top: -180rpx; right: -150rpx; width: 430rpx; height: 430rpx; background: radial-gradient(circle,rgba(194,141,78,.18),transparent 67%); pointer-events: none; }
.info-heading { position: relative; display: flex; align-items: center; }
.info-seal { display: flex; width: 76rpx; height: 76rpx; flex: none; align-items: center; justify-content: center; color: #e2bc86; border: 1rpx solid rgba(205,157,95,.75); border-radius: 50%; font-family: var(--font-display); font-size:35rpx; }
.info-heading-copy { min-width: 0; margin-left: 20rpx; }
.info-eyebrow { color: #c99557; font-size:19rpx; letter-spacing: 4rpx; }
.info-title { margin-top: 3rpx; color: #f2e5d3; font-family: var(--font-display); font-size:39rpx; letter-spacing: 4rpx; }
.info-close { width: 66rpx; height: 66rpx; margin-left: auto; padding: 0; color: #d8c6ad; background: rgba(31,30,29,.5); border-radius: 50%; font-size:35rpx; line-height: 62rpx; }
.info-intro { position: relative; margin-top: 24rpx; padding: 20rpx 22rpx; color: #e5d6c2; background: rgba(177,124,67,.16); border-radius: 16rpx; font-family: var(--font-display); font-size:26rpx; line-height: 1.7; }
.info-scroll { height: 380rpx; flex: none; margin-top: 8rpx; }
.info-section { padding: 24rpx 4rpx 20rpx; }
.info-section-title { color: #dfb77f; font-family: var(--font-display); font-size:28rpx; letter-spacing: 2rpx; }
.info-section-body { margin-top: 8rpx; color: #ccc3b7; font-size:24rpx; line-height: 1.85; }
.info-confirm { width: 100%; margin-top: 14rpx; color: #fff8ed; background: #a97743; border-radius: 8rpx; font-size:27rpx; line-height: 78rpx; letter-spacing: 3rpx; }


.mine-page.theme-day { color: #34342F; background-color: #D5D3CA !important; background-image: none !important; }
.mine-page.theme-day .card, .mine-page.theme-day [class*='panel'], .mine-page.theme-day [class*='card'], .mine-page.theme-day [class*='sheet'], .mine-page.theme-day [class*='dialog'] { color: #34342F; background: #E7E4DA; border-color: #B8B5AA; }
.mine-page.theme-day .muted, .mine-page.theme-day .caption, .mine-page.theme-day .field-note { color: #68675F; }
