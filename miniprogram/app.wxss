page {
  --paper: #0d0e0d; --ink: #e7cfab; --gold: #c99c5f; --line: #3c3428; --muted: #a4947e;
  background: var(--paper); color: var(--ink); font-size: 28rpx; line-height: 1.65;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}
view, button, input, textarea { box-sizing: border-box; }
button { font-family: inherit; font-weight: normal; margin: 0; }
button::after { border: 0; }
button[disabled] { opacity: .48; }
.page { padding: 32rpx; }
.serif, .title, .section-title { font-family: "Songti SC", "STSong", serif; font-weight: normal; }
.title { font-size: 40rpx; margin-bottom: 20rpx; letter-spacing: 3rpx; }
.card { padding: 30rpx; border: 1rpx solid var(--line); background: #191a16; margin-bottom: 24rpx; border-radius: 8rpx; }
.muted { color: var(--muted); font-size: 24rpx; }
.button, .solid-button { background: #b58c52; color: #10110e; border-radius: 4rpx; font-size: 26rpx; line-height: 80rpx; padding: 0 28rpx; }
.button { margin-top: 24rpx; }
.outline-button { background: transparent; border: 1rpx solid #886b44; color: #e1b97f; border-radius: 4rpx; font-size: 25rpx; line-height: 74rpx; padding: 0 26rpx; }
.text-button { padding: 0; background: transparent; color: var(--gold); font-size: 24rpx; line-height: 1.8; border-radius: 0; }
input, textarea, picker { box-sizing: border-box; width: 100%; padding: 20rpx; border: 1rpx solid var(--line); background: #191a16; color: var(--ink); font-size: 28rpx; border-radius: 4rpx; }
input, picker { margin: 12rpx 0 24rpx; }
.brand-logo { width: 126rpx; height: 106rpx; }
.eyebrow { font-size: 22rpx; color: var(--gold); letter-spacing: 3rpx; }
.screen-heading { display: flex; justify-content: space-between; align-items: flex-end; padding-bottom: 26rpx; border-bottom: 1rpx solid var(--line); }
.screen-title { font-family: "Songti SC", "STSong", serif; font-size: 50rpx; letter-spacing: 5rpx; line-height: 1.4; }
.empty-state { padding: 72rpx 26rpx; text-align: center; }
.empty-state .empty-mark { color: #b7a27a; font-family: serif; font-size: 66rpx; margin-bottom: 20rpx; }
.empty-state .empty-title { font-family: "Songti SC", serif; font-size: 34rpx; margin-bottom: 14rpx; }
.empty-state .outline-button { display: inline-block; margin-top: 30rpx; }
.page-foot { padding: 40rpx 20rpx; text-align: center; color: #97866c; font-size: 21rpx; letter-spacing: 2rpx; }
.scrim { position: fixed; inset: 0; background: rgba(0,0,0,.55); z-index: 40; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 41; padding: 32rpx 36rpx calc(32rpx + env(safe-area-inset-bottom)); background: #0d0e0d; border-radius: 24rpx 24rpx 0 0; max-height: 78vh; overflow-y: auto; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.sheet-title { font-family: "Songti SC", serif; font-size: 36rpx; }
.sheet-close { background: transparent; padding: 0 10rpx; color: #c99c5f; font-size: 40rpx; line-height: 1.5; }

/* 明亮材质基线：岩石纹理负责触感，纸白与墨灰负责可读性 */
page { --paper: #e7e0d3; --ink: #3d3a34; --gold: #9a7139; --line: #c6b9a5; --muted: #756c5c; background: #e7e0d3; color: #3d3a34; }
.page, .mine-page, .explore-page { background-color: #e7e0d3; background-image: linear-gradient(rgba(235,230,220,.78),rgba(235,230,220,.9)),url('/assets/brand/stone-texture.jpg'); background-size: auto, 640rpx; }

/* C 方向视觉基线：深墨骨架 + 提亮岩面，铜色只做行动与状态强调。 */
page { --paper: #dcd4c7; --ink: #303531; --gold: #a87945; --line: #b9ad9d; --muted: #706b61; background: #dcd4c7; color: #303531; }
.page, .mine-page, .explore-page { background-color: #dcd4c7; background-image: linear-gradient(rgba(229,224,215,.82),rgba(214,205,193,.9)),url('/assets/brand/stone-texture.jpg'); background-size: auto, 720rpx; }
.card { background: #292e2a; border-color: #4c554d; color: #eee7db; box-shadow: 0 10rpx 24rpx rgba(44,38,30,.10); }
.outline-button { border-color: #9e7645; color: #835d32; background: rgba(250,246,237,.36); }
.solid-button, .button { background: #a87945; color: #fffaf2; }
.text-button { color: #8d6235; }
.sheet { background: #262b27; color: #eee7db; border-top: 1rpx solid #5c655d; box-shadow: 0 -12rpx 36rpx rgba(33,29,24,.2); }
.sheet-title { color: #f0e7d9; }
.sheet-close { color: #d4a66d; }
.empty-state .empty-mark { color: #a87945; }
