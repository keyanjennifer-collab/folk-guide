<view class="shop-page {{themeClass}}">
  <view class="shop-heading"><view><view class="eyebrow">五色应时 · 知时而行</view><view class="screen-title">一色一香，一时一境</view></view><image class="shop-logo" src="/assets/brand/logo-ai.png" mode="aspectFit"/></view>
  <button class="shop-hero" bindtap="toGift">
    <image src="{{gift.image}}" mode="aspectFill"/>
    <view class="hero-copy"><view class="hero-title">{{gift.name}}</view><view>随时序择色，也随心择香</view><text>赏阅礼盒</text></view>
  </button>
  <view class="catalog-header"><view class="filters"><button wx:for="{{filters}}" wx:key="id" data-id="{{item.id}}" bindtap="filterProducts" class="{{category === item.id ? 'active' : ''}}">{{item.name}}</button></view><text>{{visibleProducts.length}} 款</text></view>
  <view class="product-grid">
    <button wx:for="{{visibleProducts}}" wx:key="id" class="product-card" data-id="{{item.id}}" bindtap="showProduct">
      <view class="product-picture"><image class="product-image" src="{{item.image}}" mode="{{item.category === 'set' ? 'aspectFill' : 'aspectFit'}}"/><text class="product-tag">{{!item.active || item.available <= 0 ? '暂时售罄' : item.category === 'set' ? '五色套装' : item.element + ' · ' + item.beast}}</text></view>
      <view class="product-info"><view class="product-name">{{item.name}}</view><view class="product-mood">{{item.mood}}</view><view class="product-price price-figure">¥{{item.price}}<text>{{item.available > 0 ? '有货' : '补货中'}}</text></view></view>
    </button>
  </view>
  <view class="shop-note">{{saleNote}}</view>
  <view class="shop-story"><view class="eyebrow">五方图腾 · 五色香气</view><view>从一缕香开始，<text>把时间还给自己。</text></view></view>
  <view class="bag-bar"><button class="bag-open" bindtap="openCart">购物袋 <text>{{cartCount}}</text></button><text class="bag-total price-figure">{{cartCount ? '合计 ¥' + cartTotal : '循心选香'}}</text><button class="bag-view" bindtap="openCart">查看清单 ›</button></view>
  <view wx:if="{{showCart}}" class="scrim" bindtap="closeCart" catchtouchmove="noop"/>
  <view wx:if="{{showCart}}" class="sheet">
    <view class="sheet-head"><view class="sheet-title">我的购物袋</view><button class="sheet-close" bindtap="closeCart" aria-label="关闭">×</button></view>
    <view wx:if="{{!cartItems.length}}" class="empty-state"><view class="empty-mark">香</view><view class="empty-title">还没有选中的香</view><view class="muted">在商品详情中，把喜欢的香加入购物袋。</view><button class="outline-button" bindtap="closeCart">继续选香</button></view>
    <block wx:else>
      <view wx:for="{{cartItems}}" wx:key="id" class="cart-row">
        <image src="{{item.image}}" mode="aspectFill"/>
        <view class="cart-copy"><view>{{item.name}}</view><text class="price-figure">¥{{item.price}}</text></view>
        <view class="quantity"><button data-id="{{item.id}}" data-delta="-1" bindtap="changeQuantity" aria-label="减少数量">−</button><text>{{item.quantity}}</text><button data-id="{{item.id}}" data-delta="1" bindtap="changeQuantity" disabled="{{item.quantity >= 99}}" aria-label="增加数量">＋</button></view>
      </view>
      <view class="cart-summary"><text>共 {{cartCount}} 件</text><text class="price-figure">合计 ¥{{cartTotal}}</text></view>
      <button class="solid-button" bindtap="checkout" disabled="{{!saleEnabled}}">{{saleEnabled ? '去结算' : '商城尚未开售'}}</button>
      <view class="cart-note">结算时将由服务端重新核对价格与库存</view>
    </block>
  </view>
</view>




