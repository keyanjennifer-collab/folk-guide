<view class="home-page">
  <view style="height:{{statusBarHeight}}px"/>
  <view class="brandbar"><image class="brand-logo" src="/assets/brand/logo.png" mode="aspectFit" aria-label="五色知时"/></view>
  <view class="today">
    <view class="ranking">
      <view class="ranking-heading">
        <view class="eyebrow">{{dateLabel}}　{{primaryElement ? '今日主势 · ' + primaryElement : '每日时序'}}</view>
        <view class="today-title">今日五色</view>
        <view class="today-subtitle">依今日节律，先看用色次序</view>
        <button class="color-guide-button" bindtap="openGuide" disabled="{{!selected}}">今日色序依据 <text>查看 ›</text></button>
      </view>
      <view class="rank-list" wx:if="{{contentSource === 'ready'}}">
        <button wx:for="{{guides}}" wx:key="rank" class="rank-row tone-{{item.product.id}} {{selected.rank === item.rank ? 'selected' : ''}}" bindtap="selectGuide" data-rank="{{item.rank}}" aria-label="{{item.name + '，第' + item.rank + '位，' + item.status}}">
          <view class="rank-no">0{{item.rank}}</view>
          <view class="rank-copy"><view class="rank-main"><text class="rank-color">{{details[item.product.id].label}}</text><text class="rank-slash">/</text><text class="rank-status">{{rankLabels[item.rank - 1]}}</text></view><view class="rank-note">{{item.suitable[0]}}</view></view>
        </button>
      </view>
      <view wx:else class="rank-empty"><view>{{contentSource === 'loading' ? '正在读取今日五色' : '静候今日'}}</view><text>{{contentMessage}}</text><button wx:if="{{contentSource === 'error'}}" class="outline-button" bindtap="loadToday">重新读取</button></view>
      <view class="calendar-line">{{term}} · {{calendarLabel}}</view>
    </view>
    <view class="scent-stage">
      <view class="scent-heading">{{selected ? '今日相应之香' : '循心择香'}}</view>
      <image class="product-emblem" src="{{scent.emblem}}" mode="aspectFit"/>
      <view class="scent-name">{{scent.name}}</view>
      <view class="scent-mood">{{scent.mood}}</view>
      <view class="scent-notes">{{details[scent.id].notes}}</view>
      <view class="inline-aroma"><view class="aroma-intro">{{details[scent.id].intro}}</view><view class="aroma-notes"><view wx:for="{{details[scent.id].aroma}}" wx:key="*this"><text>{{index === 0 ? '前调' : index === 1 ? '中调' : '余韵'}}</text><view>{{item}}</view></view></view></view>
      <view class="visual-frame" bindtap="toProduct" role="button" aria-label="{{'查看' + scent.name}}"><image class="product-visual" src="{{scent.image}}" mode="aspectFill"/><view class="visual-fade"/></view>
      <button class="aroma-button" bindtap="toProduct">轻触闻香　↗</button>
    </view>
  </view>
  <view class="gift">
    <view class="gift-copy"><view class="gift-kicker">五色应时 · 知时而行</view><view class="gift-title">五色应时礼盒</view><view class="gift-desc">随时序择色，也随心择香</view><view class="gift-price">¥239 <text>参考价</text></view><button class="gift-button" bindtap="toGift">查看礼盒</button></view>
    <image class="gift-image" src="/assets/brand/gift.jpg" mode="aspectFit"/>
  </view>
  <view class="home-links"><button bindtap="toAi"><text>AI国学</text><view>问典籍，也问生活 ›</view></button><button bindtap="toMine"><text>我的今日五色</text><view>结合本人档案查看 ›</view></button></view>
  <view class="page-foot">传统文化与日常生活参考</view>
  <view wx:if="{{showGuide}}" class="scrim" bindtap="closeGuide" catchtouchmove="noop"/>
  <view wx:if="{{showGuide}}" class="sheet">
    <view class="sheet-head"><view class="sheet-title">{{selected.name}} · 今日用色</view><button class="sheet-close" bindtap="closeGuide" aria-label="关闭">×</button></view>
    <view class="guide-status">第{{selected.rank}}位 · {{selected.status}}</view>
    <view class="guide-swatches"><view wx:for="{{selected.product.swatches}}" wx:key="*this" style="background:{{item}}"/></view>
    <view class="detail-title">今日用色依据</view><view class="detail-text">{{selected.advice}}</view>
    <view class="detail-title">适合处理</view><view wx:for="{{selected.suitable}}" wx:key="*this" class="detail-text">· {{item}}</view>
    <view class="detail-title">留意之处</view><view class="detail-text">{{selected.resistance}}</view>
    <view class="muted guide-note">按当日时序生成公共五色；个人结果可在「我的」中查看。</view>
  </view>
</view>
