<view class="ziwei-page {{themeClass}}">
  <view class="hero"><view class="eyebrow">{{mode === 'chart' ? 'ZIWEI · PERSONAL CHART' : 'ZIWEI · CHART COMPATIBILITY'}}</view><view class="title">{{mode === 'chart' ? '紫微起盘' : '紫微合盘'}}</view><view class="subtitle">{{mode === 'chart' ? '支持公历、农历、三级出生地点和详细地址；排盘记录会保存。' : '支持双方公历、农历、三级出生地点和详细地址；合盘记录会保存。'}}</view></view>
  <view wx:if="{{loading}}" class="loading">正在读取已保存的命盘…</view>

  <block wx:elif="{{mode === 'chart'}}">
    <view class="card"><view class="card-title">输入出生信息</view><view class="field"><text>命盘名称</text><input value="{{chartForm.label}}" data-person="chartForm" data-field="label" bindinput="setFormInput" placeholder="例如：我的命盘"/></view><view class="field"><text>姓名（可选）</text><input value="{{chartForm.name}}" data-person="chartForm" data-field="name" bindinput="setFormInput" placeholder="用于区分保存的命盘"/></view><view class="field"><text>历法类型</text><view class="gender"><button class="{{chartForm.calendarType === 'solar' ? 'active' : ''}}" data-person="chartForm" data-calendar="solar" bindtap="setCalendar">公历</button><button class="{{chartForm.calendarType === 'lunar' ? 'active' : ''}}" data-person="chartForm" data-calendar="lunar" bindtap="setCalendar">农历</button></view></view><view wx:if="{{chartForm.calendarType === 'lunar'}}" class="switch-row"><text>闰月</text><switch checked="{{chartForm.isLeapMonth}}" color="#96663c" data-person="chartForm" bindchange="setLeapMonth"/></view><view class="field"><text>出生日期</text><picker mode="date" value="{{chartForm.birthDate}}" start="1900-01-01" bindchange="setFormPicker" data-person="chartForm" data-field="birthDate"><view class="picker">{{chartForm.birthDate || (chartForm.calendarType === 'lunar' ? '请选择农历年月日' : '请选择公历年月日')}}<text>›</text></view></picker><view wx:if="{{chartForm.calendarType === 'lunar'}}" class="hint">选择的数字将按农历年月日解释，并转换为公历排盘。</view></view><view class="field"><text>具体出生时间</text><picker mode="time" value="{{chartForm.birthTime}}" bindchange="setFormPicker" data-person="chartForm" data-field="birthTime"><view class="picker">{{chartForm.birthTime}}<text>›</text></view></picker></view><view class="field"><text>性别</text><view class="gender"><button class="{{chartForm.gender === 'male' ? 'active' : ''}}" data-person="chartForm" data-gender="male" bindtap="setGender">男</button><button class="{{chartForm.gender === 'female' ? 'active' : ''}}" data-person="chartForm" data-gender="female" bindtap="setGender">女</button></view></view><view class="field"><text>出生地点（可选）</text><picker mode="region" level="district" value="{{chartForm.birthRegion}}" data-person="chartForm" bindchange="setBirthRegion"><view class="picker {{chartForm.birthAddress ? '' : 'placeholder'}}">{{chartForm.birthAddress || '请选择省、市、区/县'}}<text>›</text></view></picker><input class="detail-input" value="{{chartForm.birthDetailAddress}}" data-person="chartForm" data-field="birthDetailAddress" bindinput="setFormInput" maxlength="80" placeholder="详细地址，如街道、门牌号（可选）"/></view><button class="primary" loading="{{saving}}" bindtap="createChart">起盘并保存</button></view>
    <view wx:if="{{savedCharts.length}}" class="card"><view class="card-title">已保存命盘</view><view wx:for="{{savedCharts}}" wx:key="id" class="saved-row"><view class="saved-open" data-id="{{item.id}}" bindtap="showChart"><view>{{item.label}}<text>{{item.name || '未署名'}} · {{item.calendar_type === 'lunar' ? '农历' : '公历'}}</text></view><text>{{item.birth_date}} {{item.birth_time}} ›</text></view><button class="saved-delete" data-id="{{item.id}}" catchtap="deleteChart">删除</button></view></view>
  </block>

  <block wx:else>
    <view class="card"><view class="card-title">选择关系主题</view><view class="relation-row"><button wx:for="{{relations}}" wx:key="id" data-relation="{{item.id}}" bindtap="setRelation" class="{{relationType === item.id ? 'active' : ''}}">{{item.label}}</button></view><view class="divider"/><view class="person-title">第一位出生信息</view><view class="field"><text>姓名或昵称（可选）</text><input value="{{personA.name}}" data-person="personA" data-field="name" bindinput="setFormInput" placeholder="方便区分记录"/></view><view class="field"><text>历法类型</text><view class="gender"><button class="{{personA.calendarType === 'solar' ? 'active' : ''}}" data-person="personA" data-calendar="solar" bindtap="setCalendar">公历</button><button class="{{personA.calendarType === 'lunar' ? 'active' : ''}}" data-person="personA" data-calendar="lunar" bindtap="setCalendar">农历</button></view></view><view wx:if="{{personA.calendarType === 'lunar'}}" class="switch-row"><text>闰月</text><switch checked="{{personA.isLeapMonth}}" color="#96663c" data-person="personA" bindchange="setLeapMonth"/></view><view class="field"><text>出生日期</text><picker mode="date" value="{{personA.birthDate}}" start="1900-01-01" bindchange="setFormPicker" data-person="personA" data-field="birthDate"><view class="picker">{{personA.birthDate || (personA.calendarType === 'lunar' ? '请选择农历年月日' : '请选择公历年月日')}}<text>›</text></view></picker></view><view class="field"><text>具体出生时间</text><picker mode="time" value="{{personA.birthTime}}" bindchange="setFormPicker" data-person="personA" data-field="birthTime"><view class="picker">{{personA.birthTime}}<text>›</text></view></picker></view><view class="field"><text>性别</text><view class="gender"><button class="{{personA.gender === 'male' ? 'active' : ''}}" data-person="personA" data-gender="male" bindtap="setGender">男</button><button class="{{personA.gender === 'female' ? 'active' : ''}}" data-person="personA" data-gender="female" bindtap="setGender">女</button></view></view><view class="field"><text>出生地点（可选）</text><picker mode="region" level="district" value="{{personA.birthRegion}}" data-person="personA" bindchange="setBirthRegion"><view class="picker {{personA.birthAddress ? '' : 'placeholder'}}">{{personA.birthAddress || '请选择省、市、区/县'}}<text>›</text></view></picker><input class="detail-input" value="{{personA.birthDetailAddress}}" data-person="personA" data-field="birthDetailAddress" bindinput="setFormInput" maxlength="80" placeholder="详细地址，如街道、门牌号（可选）"/></view>
    <view class="person-title">第二位出生信息</view><view class="field"><text>姓名或昵称（可选）</text><input value="{{personB.name}}" data-person="personB" data-field="name" bindinput="setFormInput" placeholder="方便区分记录"/></view><view class="field"><text>历法类型</text><view class="gender"><button class="{{personB.calendarType === 'solar' ? 'active' : ''}}" data-person="personB" data-calendar="solar" bindtap="setCalendar">公历</button><button class="{{personB.calendarType === 'lunar' ? 'active' : ''}}" data-person="personB" data-calendar="lunar" bindtap="setCalendar">农历</button></view></view><view wx:if="{{personB.calendarType === 'lunar'}}" class="switch-row"><text>闰月</text><switch checked="{{personB.isLeapMonth}}" color="#96663c" data-person="personB" bindchange="setLeapMonth"/></view><view class="field"><text>出生日期</text><picker mode="date" value="{{personB.birthDate}}" start="1900-01-01" bindchange="setFormPicker" data-person="personB" data-field="birthDate"><view class="picker">{{personB.birthDate || (personB.calendarType === 'lunar' ? '请选择农历年月日' : '请选择公历年月日')}}<text>›</text></view></picker></view><view class="field"><text>具体出生时间</text><picker mode="time" value="{{personB.birthTime}}" bindchange="setFormPicker" data-person="personB" data-field="birthTime"><view class="picker">{{personB.birthTime}}<text>›</text></view></picker></view><view class="field"><text>性别</text><view class="gender"><button class="{{personB.gender === 'male' ? 'active' : ''}}" data-person="personB" data-gender="male" bindtap="setGender">男</button><button class="{{personB.gender === 'female' ? 'active' : ''}}" data-person="personB" data-gender="female" bindtap="setGender">女</button></view></view><view class="field"><text>出生地点（可选）</text><picker mode="region" level="district" value="{{personB.birthRegion}}" data-person="personB" bindchange="setBirthRegion"><view class="picker {{personB.birthAddress ? '' : 'placeholder'}}">{{personB.birthAddress || '请选择省、市、区/县'}}<text>›</text></view></picker><input class="detail-input" value="{{personB.birthDetailAddress}}" data-person="personB" data-field="birthDetailAddress" bindinput="setFormInput" maxlength="80" placeholder="详细地址，如街道、门牌号（可选）"/></view><button class="primary" loading="{{saving}}" bindtap="createCompatibility">合盘并保存</button></view>
    <view wx:if="{{savedCompatibilities.length}}" class="card"><view class="card-title">已保存合盘</view><view wx:for="{{savedCompatibilities}}" wx:key="id" class="saved-row"><view class="saved-open" data-id="{{item.id}}" bindtap="showCompatibility"><view>{{item.result.title}}<text>{{item.person_a.name || '第一位'}} · {{item.person_b.name || '第二位'}}</text></view><text>›</text></view><button class="saved-delete" data-id="{{item.id}}" catchtap="deleteCompatibility">删除</button></view></view>
  </block>
</view>
