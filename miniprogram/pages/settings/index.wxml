<view class="mine-page">
  <view wx:if="{{!isLoggedIn}}" class="guest-hero">
    <view class="mine-moon"></view>
    <view class="guest-overline">PERSONAL CENTER</view>
    <view class="guest-avatar">五</view>
    <view class="guest-title">登录后管理个人服务</view>
    <view class="guest-copy">公共五色无需登录；个人档案、个人五色和AI问答记录需要微信登录。</view>
    <button bindtap="realLogin">微信快捷登录</button>
    <view class="login-note">仅用于建立小程序账号，手机号可稍后绑定</view>
  </view>

  <block wx:else>
    <view class="user-hero">
      <view class="mine-moon"></view>
      <view class="user-overline">PERSONAL CENTER</view>
      <view class="identity-row">
        <view class="avatar">五</view>
        <view class="user-main">
          <view class="user-name">{{nickname}}</view>
          <view class="user-id">五色知时用户 · {{memberStatus}}</view>
        </view>
        <view class="settings-mark">WUSE</view>
      </view>
      <view class="hero-stats">
        <view><strong>{{serviceActive ? serviceDaysLeft : '—'}}</strong><text>服务剩余天数</text></view>
        <view><strong>{{questionRemaining}}</strong><text>今日问答次数</text></view>
        <view><strong>{{hasProfile ? profileCompleteness : 0}}%</strong><text>档案完整度</text></view>
      </view>
    </view>

    <view class="profile-card" bindtap="toProfile">
      <view class="profile-icon"><view class="file-symbol"><text></text><text></text></view></view>
      <view class="profile-main">
        <view class="profile-title">本人档案 <text>{{hasProfile ? '完整度 ' + profileCompleteness + '%' : '待创建'}}</text></view>
        <view class="progress"><view style="width: {{hasProfile ? profileCompleteness : 0}}%"></view></view>
        <view class="profile-copy">{{profileSummary}}</view>
      </view>
      <view class="arrow">›</view>
    </view>

    <view class="service-card">
      <view class="card-head">
        <view class="service-heading"><view class="service-logo">✦</view><view><view class="section-kicker">MY SERVICE</view><view class="section-title">我的个人服务</view></view></view>
        <view class="card-count" bindtap="showServiceDetails">服务详情 ›</view>
      </view>
      <view class="trial-card {{serviceActive ? '' : 'inactive'}}">
        <view class="trial-top">
          <view><view class="trial-label">{{serviceLabel}}</view><view class="trial-title">{{serviceTitle}}</view></view>
          <view class="trial-number">{{serviceActive ? serviceDaysLeft : '—'}}<text wx:if="{{serviceActive}}">天</text></view>
        </view>
        <view class="trial-progress"><view style="width: {{serviceProgress}}%"></view></view>
        <view class="trial-copy">{{serviceCopy}}</view>
        <view class="service-meta"><text>{{serviceExpiry}}</text><text class="{{answerReady ? 'ready' : 'waiting'}}">{{answerStatus}}</text></view>
        <button bindtap="toAi">{{serviceActive ? '继续使用AI国学' : '查看AI国学'}}</button>
      </view>
    </view>

    <view class="panel account-panel">
      <view class="panel-head"><view><view class="section-kicker">ACCOUNT</view><view class="section-title">账号安全</view></view><text>微信已登录</text></view>
      <view class="menu-row">
        <view class="menu-main"><strong>账号与手机号</strong><text>{{phoneDisplay}}</text></view>
        <button wx:if="{{!phoneBound}}" class="phone-button" open-type="getPhoneNumber" bindgetphonenumber="bindPhone">绑定手机号</button>
      </view>
      <view wx:if="{{!wechatPhoneAvailable && !phoneBound}}" class="phone-note">完成微信小程序注册和后端密钥配置后即可使用手机号绑定。</view>
      <button class="logout-button" bindtap="logout">退出登录</button>
    </view>

    <view class="panel">
      <view class="menu-row" bindtap="showPushPending">
        <view class="menu-icon reminder-menu-icon"><view class="bell-icon"><text></text></view></view>
        <view class="menu-main"><strong>每日五色提醒</strong><text>尚未开通 · 上线前接入微信订阅消息</text></view>
        <view class="pending-text">待接入</view><view class="arrow">›</view>
      </view>
      <view class="menu-row" bindtap="openPersonalResult">
        <view class="menu-icon color-menu-icon"><text class="menu-green"></text><text class="menu-black"></text><text class="menu-gold"></text><text class="menu-white"></text><text class="menu-red"></text></view>
        <view class="menu-main"><strong>今日个人五色</strong><text>{{personalResultSummary}}</text></view>
        <view class="arrow">›</view>
      </view>
      <view class="menu-row" bindtap="showAIRecords">
        <view class="menu-icon ai-menu-icon"><view class="menu-book"><text></text><text></text></view><view class="menu-spark">✦</view></view>
        <view class="menu-main"><strong>AI问答记录</strong><text>{{historySummary}}</text></view>
        <view class="arrow">›</view>
      </view>
    </view>

    <view class="panel simple-menu">
      <view class="menu-row" bindtap="showHelp"><view class="menu-main"><strong>帮助与反馈</strong></view><view class="arrow">›</view></view>
      <view class="menu-row" bindtap="showPrivacy"><view class="menu-main"><strong>隐私与数据管理</strong></view><view class="arrow">›</view></view>
      <view class="menu-row" bindtap="showAbout"><view class="menu-main"><strong>关于五色知时</strong></view><view class="arrow">›</view></view>
    </view>
    <view wx:if="{{dashboardLoading}}" class="dashboard-loading">正在同步个人数据…</view>
    <view class="version">五色知时 V1.0 · 内容仅供文化与生活参考</view>
  </block>
</view>
