.home-page{min-height:100vh;padding:0 0 70rpx;background:#eee9df;color:#27332d;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}
.home-page button::after{border:0}
.home-content{position:relative;z-index:3}

/* 首屏保留现有森林摄影，以暖金滤层和更稳定的文字层次适配品牌。 */
.editorial-hero{position:relative;overflow:hidden;height:690rpx;background:#172a23;color:#fff}
.hero-image,.hero-image-empty,.hero-warmth,.hero-shade{position:absolute;inset:0;width:100%;height:100%}
.hero-image-empty{background:linear-gradient(150deg,#1b3028,#4d5a47 58%,#171f1b)}
.hero-warmth{background:linear-gradient(125deg,rgba(181,146,92,.28),rgba(49,74,60,.04) 48%,rgba(20,29,24,.18))}
.hero-shade{background:linear-gradient(180deg,rgba(9,17,14,.46) 0%,rgba(11,19,16,.12) 31%,rgba(8,16,13,.28) 61%,rgba(7,14,11,.87) 100%)}
.hero-brand{position:absolute;z-index:2;top:34rpx;left:38rpx;display:flex;flex-direction:column;color:#f8f1e2;font-family:"Songti SC","STSong",serif;font-size:25rpx;letter-spacing:6rpx;text-shadow:0 2rpx 10rpx rgba(0,0,0,.35)}
.hero-brand-en{margin-top:2rpx;font-family:Georgia,"Times New Roman",serif;font-size:12rpx;letter-spacing:3rpx;opacity:.72}
.hero-copy{position:absolute;z-index:2;left:42rpx;right:42rpx;top:180rpx;text-align:center;text-shadow:0 3rpx 16rpx rgba(0,0,0,.58)}
.hero-kicker{font-family:Georgia,"Times New Roman",serif;font-size:15rpx;letter-spacing:6rpx;opacity:.78}
.hero-slogan{margin:23rpx 0 8rpx;font-family:"Songti SC","STSong",serif;font-size:48rpx;font-weight:500;letter-spacing:5rpx;white-space:nowrap}
.hero-principle{font-family:"Songti SC","STSong",serif;font-size:23rpx;letter-spacing:5rpx;opacity:.9}
.hero-enter{width:270rpx;margin:36rpx auto 0;padding:0;border:1rpx solid rgba(246,235,210,.72)!important;border-radius:5rpx;background:rgba(31,48,40,.22)!important;color:#fff!important;font-size:23rpx;line-height:72rpx;letter-spacing:3rpx;backdrop-filter:blur(3rpx)}
.hero-five-dots{display:flex;justify-content:center;gap:14rpx;margin-top:23rpx}.hero-five-dots text{width:11rpx;height:11rpx;border:1rpx solid rgba(255,255,255,.62);border-radius:50%;box-shadow:0 2rpx 7rpx rgba(0,0,0,.28)}
.dot-green{background:#4c725f}.dot-black{background:#1d2924}.dot-gold{background:#c4a456}.dot-white{background:#f5f1e7}.dot-red{background:#a65349}
.hero-footer{position:absolute;z-index:2;left:32rpx;right:30rpx;bottom:31rpx;display:flex;align-items:flex-end;justify-content:space-between;padding-top:20rpx;border-top:1rpx solid rgba(255,255,255,.34)}
.hero-date{font-size:22rpx;letter-spacing:1rpx}.hero-calendar{max-width:565rpx;margin-top:5rpx;font-size:18rpx;opacity:.75}
.hero-share{width:auto;margin:0;padding:0 20rpx;border:1rpx solid rgba(255,255,255,.58)!important;border-radius:4rpx;background:transparent!important;color:#fff!important;font-size:20rpx;line-height:54rpx;letter-spacing:2rpx}

/* 悬浮今日摘要：通过五色轨道形成可持续使用的品牌符号。 */
.today-overlap-card{position:relative;z-index:4;display:grid;grid-template-columns:162rpx 1fr;margin:-76rpx 24rpx 0;padding:30rpx 28rpx 27rpx;border:1rpx solid rgba(209,199,181,.78);border-radius:18rpx;background:linear-gradient(145deg,#fffef9,#f5f0e5);box-shadow:0 22rpx 52rpx rgba(35,43,37,.16)}
.five-orbit{position:relative;width:132rpx;height:132rpx;margin:2rpx auto 0}.orbit-line{position:absolute;inset:10rpx;border:1rpx solid #c9b993;border-radius:50%;box-shadow:inset 0 0 0 8rpx rgba(195,174,129,.06)}
.orbit-center{position:absolute;top:36rpx;left:34rpx;display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx;flex-direction:column;border-radius:50%;background:#25473b;color:#f5ead2;font-family:"Songti SC","STSong","SimSun",serif}.orbit-center text{font-size:17rpx}.orbit-center strong{font-size:22rpx;font-weight:500}
.orbit-dot{position:absolute;width:16rpx;height:16rpx;border:3rpx solid #fbf8ef;border-radius:50%;box-shadow:0 2rpx 6rpx rgba(45,43,34,.25)}
.orbit-green{top:0;left:57rpx;background:#49715d}.orbit-black{top:42rpx;right:1rpx;background:#222e28}.orbit-gold{right:20rpx;bottom:5rpx;background:#b9964d}.orbit-white{left:20rpx;bottom:5rpx;background:#f2f0e8;box-shadow:0 0 0 1rpx #adb8b0}.orbit-red{top:42rpx;left:1rpx;background:#a65449}
.today-summary{padding-left:12rpx}.summary-eyebrow{color:#9b8353;font-family:Georgia,"Times New Roman",serif;font-size:15rpx;letter-spacing:3rpx}.summary-color{display:flex;align-items:center;margin-top:8rpx;color:#273e34}.summary-color strong{font-family:"Songti SC","STSong","SimSun",serif;font-size:36rpx;font-weight:500;letter-spacing:3rpx}.summary-color>text:last-child{margin-left:7rpx;color:#707a73;font-size:21rpx}.summary-swatch{width:12rpx;height:42rpx;margin-right:13rpx;border-radius:3rpx 3rpx 9rpx 9rpx}.summary-status{margin-top:5rpx;color:#57665d;font-size:23rpx}.summary-support{margin-top:7rpx;color:#898b83;font-size:20rpx}
.summary-foot{grid-column:1/3;margin-top:22rpx;padding-top:17rpx;border-top:1rpx solid #ded6c7;color:#756745;font-family:"Songti SC","STSong",serif;font-size:22rpx;letter-spacing:1rpx;text-align:center}

/* 两个核心入口保持真实，不混入暂缓功能。 */
.core-entry-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin:18rpx 24rpx 0}
.core-entry{position:relative;overflow:hidden;min-height:286rpx;margin:0;padding:25rpx 23rpx;border:1rpx solid #d8d0c2!important;border-radius:12rpx;background:#faf8f2!important;color:#34463d;text-align:left;line-height:1.5}
.core-entry::before{content:"";position:absolute;right:-55rpx;bottom:-78rpx;width:190rpx;height:190rpx;border:1rpx solid rgba(92,119,104,.16);border-radius:50%}.ai-entry{background:linear-gradient(145deg,#f7f2e7,#eee6d5)!important}
.entry-logo{position:relative;width:58rpx;height:58rpx;color:#806a40}.color-entry-logo{border:1rpx solid rgba(145,124,82,.55);border-radius:50%}.color-logo-dot{position:absolute;width:10rpx;height:10rpx;border-radius:50%}.color-logo-green{top:8rpx;left:23rpx;background:#416b58}.color-logo-black{top:20rpx;right:8rpx;background:#242d29}.color-logo-gold{right:13rpx;bottom:8rpx;background:#b9974f}.color-logo-white{left:13rpx;bottom:8rpx;border:1rpx solid #adb5af;background:#f5f3ec}.color-logo-red{top:20rpx;left:8rpx;background:#9d5046}
.ai-entry-logo{display:flex;align-items:center;justify-content:center;border:1rpx solid rgba(145,124,82,.55);border-radius:50%}.ai-book{position:relative;display:flex;width:32rpx;height:24rpx}.ai-book text{box-sizing:border-box;width:16rpx;height:23rpx;border-bottom:1rpx solid #887347}.ai-book text:first-child{border-left:1rpx solid #887347;border-radius:0 0 0 8rpx;transform:skewY(10deg)}.ai-book text:last-child{border-right:1rpx solid #887347;border-radius:0 0 8rpx 0;transform:skewY(-10deg)}.ai-book::after{content:"";position:absolute;top:2rpx;bottom:0;left:50%;width:1rpx;background:#887347}.ai-spark{position:absolute;top:1rpx;right:3rpx;color:#aa8c51;font-family:Georgia,serif;font-size:15rpx}
.entry-kicker{margin-top:17rpx;color:#9c8658;font-family:Georgia,"Times New Roman",serif;font-size:13rpx;letter-spacing:2rpx}.entry-title{margin-top:5rpx;color:#27443a;font-family:"Songti SC","STSong","SimSun",serif;font-size:30rpx;font-weight:400;letter-spacing:3rpx}.entry-copy{margin-top:9rpx;color:#6f766f;font-size:21rpx;line-height:1.65}.entry-link{position:absolute;left:23rpx;bottom:20rpx;color:#6d6044;font-size:19rpx;letter-spacing:1rpx}

.section-kicker{color:#9a8454;font-family:Georgia,"Times New Roman",serif;font-size:16rpx;letter-spacing:4rpx}.section-kicker.center{text-align:center}
.section-title{margin-top:7rpx;color:#203a31;font-family:"Songti SC","STSong","SimSun",serif;font-size:38rpx;font-weight:400;letter-spacing:4rpx}

/* 今日排名以细线、序号与色签建立秩序，降低普通卡片感。 */
.ranking-section{margin-top:18rpx;padding:54rpx 34rpx 42rpx;background:#fffef9}
.section-head{display:flex;align-items:flex-end;justify-content:space-between;padding:0 7rpx 23rpx;border-bottom:1rpx solid #dcd5c8}.rule-tag{padding:6rpx 11rpx;border:1rpx solid #b5965b;color:#856d3c;font-size:18rpx;white-space:nowrap}.ranking-intro{padding:22rpx 8rpx 18rpx;color:#737a75;font-size:22rpx;line-height:1.75}
.guide-empty{padding:64rpx 30rpx 52rpx;border-bottom:1rpx solid #e1ddd5;text-align:center}.guide-empty-mark{color:#a18a5a;font-family:serif;font-size:16rpx;letter-spacing:5rpx}.guide-empty-title{margin-top:15rpx;color:#2c443a;font-family:"Songti SC","STSong",serif;font-size:31rpx;letter-spacing:3rpx}.guide-empty-copy{max-width:540rpx;margin:16rpx auto 0;color:#7b807c;font-size:22rpx;line-height:1.8}.guide-retry{width:220rpx;margin:30rpx auto 0;border:1rpx solid #9a8355!important;border-radius:3rpx;background:transparent!important;color:#796641!important;font-size:22rpx;line-height:64rpx;letter-spacing:2rpx}
.guide-row{display:flex;align-items:center;min-height:119rpx;padding:0 8rpx;border-bottom:1rpx solid #e1ddd5}.guide-row.is-expanded{background:linear-gradient(90deg,rgba(239,235,225,.03),rgba(239,235,225,.62),rgba(239,235,225,.03))}.rank-number{width:58rpx;color:#8b938e;font-family:serif;font-size:22rpx}
/* 五色只做纯粹的圆形色印，避免吊牌、香水瓶一类具象造型抢夺文字信息。 */
.color-ribbon{box-sizing:border-box;width:30rpx;height:30rpx;margin-right:26rpx;border:1rpx solid rgba(70,72,65,.16);border-radius:50%;box-shadow:0 2rpx 7rpx rgba(38,43,39,.12)}.color-ribbon text{display:none}
.tone-green{background:#416b58}.tone-black{background:#242d29}.tone-gold{background:#b9974f}.tone-white{border-color:#aeb7b0;background:#f5f3ec;box-shadow:0 2rpx 7rpx rgba(38,43,39,.08)}.tone-red{background:#9d5046}
.guide-main{flex:1}.guide-name{color:#283a32;font-family:"Songti SC","STSong",serif;font-size:30rpx;letter-spacing:2rpx}.guide-name text{color:#777d78;font-size:21rpx}.guide-status{margin-top:5rpx;color:#737a75;font-size:22rpx}.chevron{color:#9a865d;font-family:serif;font-size:33rpx}
.guide-detail{margin:0 7rpx 16rpx 58rpx;padding:3rpx 22rpx 23rpx;border-left:1rpx solid #cbb78f;border-bottom:1rpx solid #ded6c8;background:linear-gradient(145deg,rgba(249,246,239,.72),rgba(244,238,227,.52));color:#565e58;font-size:23rpx;line-height:1.75}.detail-section{padding:19rpx 0;border-top:1rpx solid #e1d9cc}.detail-section:first-child{border-top:0}.detail-heading{display:flex;align-items:center;margin-bottom:9rpx}.detail-index{margin-right:11rpx;color:#b19661;font-family:Georgia,"Times New Roman",serif;font-size:15rpx;letter-spacing:1rpx}.detail-label{display:block;margin:0;color:#806f4f;font-size:18rpx;font-weight:500;letter-spacing:2rpx}.detail-copy{color:#5a615b;font-size:22rpx;line-height:1.8}.chips{display:flex;flex-wrap:wrap;gap:8rpx}.chip{padding:6rpx 12rpx;border-radius:2rpx;background:#ece8df;color:#4f6157;font-size:20rpx}
.incense-inline{display:grid;grid-template-columns:58rpx 1fr auto;align-items:center;gap:14rpx;margin-top:8rpx;padding:18rpx;border-top:1rpx solid #d7c7a9;border-bottom:1rpx solid #d7c7a9;background:#eee5d6}.incense-detail-logo{position:relative;box-sizing:border-box;width:58rpx;height:58rpx;border:1rpx solid #ad925f;border-radius:50%}.detail-incense-stick{position:absolute;left:28rpx;bottom:13rpx;width:2rpx;height:21rpx;background:#866f43}.detail-incense-base{position:absolute;left:17rpx;bottom:10rpx;width:24rpx;height:5rpx;border-bottom:1rpx solid #866f43;border-radius:50%}.detail-smoke{position:absolute;width:10rpx;height:18rpx;border-left:1rpx solid #a38956;border-radius:50%}.detail-smoke-left{top:8rpx;left:22rpx;transform:rotate(14deg)}.detail-smoke-right{top:5rpx;left:31rpx;height:22rpx;opacity:.62;transform:rotate(-12deg)}.incense-inline-copy{min-width:0}.incense-inline .detail-label{margin:0 0 2rpx}.incense-name{color:#4f493d;font-family:"Songti SC","STSong","SimSun",serif;font-size:25rpx;letter-spacing:1rpx}.incense-scent{overflow:hidden;color:#797368;font-size:18rpx;line-height:1.55}.small-button{box-sizing:border-box;width:120rpx;min-width:120rpx;height:54rpx;margin:0;padding:0;border:1rpx solid #897348!important;border-radius:2rpx;background:transparent!important;color:#69593b!important;font-size:18rpx;line-height:52rpx;white-space:nowrap}

/* 线香模块先使用可发布的无图视觉，后续填图片路径自动替换。 */
.incense-feature{margin-top:18rpx;padding:58rpx 30rpx 42rpx;background:#f5f0e5}.feature-heading{padding:0 8rpx}.feature-title-row{display:flex;align-items:center;gap:20rpx}.section-logo{position:relative;box-sizing:border-box;width:72rpx;height:72rpx;flex:0 0 72rpx;border:1rpx solid #b69b67;border-radius:50%}.incense-logo-stick{position:absolute;left:35rpx;bottom:17rpx;width:2rpx;height:25rpx;background:#8d7445}.incense-logo-base{position:absolute;left:22rpx;bottom:14rpx;width:28rpx;height:5rpx;border-bottom:1rpx solid #8d7445;border-radius:50%}.incense-logo-smoke{position:absolute;width:12rpx;height:21rpx;border-left:1rpx solid #a68a57;border-radius:50%}.smoke-left{top:10rpx;left:27rpx;transform:rotate(14deg)}.smoke-right{top:7rpx;left:37rpx;height:25rpx;transform:rotate(-12deg);opacity:.65}.feature-heading-copy{margin-top:20rpx;color:#6b736c;font-size:23rpx;line-height:1.75}.incense-product-card{display:grid;grid-template-columns:44% 56%;overflow:hidden;margin-top:28rpx;border:1rpx solid #d4c9b7;border-radius:10rpx;background:#fffdf8;box-shadow:0 14rpx 32rpx rgba(54,51,42,.08)}
.incense-visual{position:relative;min-height:390rpx;overflow:hidden;background:#263f35}.incense-visual image{position:absolute;width:100%;height:100%}.incense-visual-empty{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;background:radial-gradient(circle at 48% 72%,rgba(176,148,91,.28),transparent 23%),linear-gradient(155deg,#1e3b31,#4f6559 72%,#d2bea0);color:#efe3c9}.incense-seal{display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;border:1rpx solid rgba(239,224,191,.65);font-family:"Songti SC","STSong",serif;font-size:38rpx}.incense-visual-en{position:absolute;left:0;right:0;bottom:25rpx;font-family:serif;font-size:13rpx;letter-spacing:3rpx;text-align:center;opacity:.72}.smoke{position:absolute;width:55rpx;height:180rpx;border-left:2rpx solid rgba(239,232,210,.35);border-radius:50%;filter:blur(1rpx)}.smoke-one{top:31rpx;left:95rpx;transform:rotate(13deg)}.smoke-two{top:4rpx;left:133rpx;height:210rpx;transform:rotate(-12deg);opacity:.5}
.incense-product-copy{display:flex;padding:32rpx 27rpx 27rpx;flex-direction:column}.product-label{color:#9b8353;font-size:18rpx;letter-spacing:2rpx}.product-name{margin-top:9rpx;color:#2c453a;font-family:"Songti SC","STSong",serif;font-size:33rpx;line-height:1.4}.product-scent{margin-top:8rpx;color:#777468;font-size:21rpx;line-height:1.65}.product-scene{margin-top:23rpx;padding-top:17rpx;border-top:1rpx solid #e0d8ca}.product-scene text{color:#927d51;font-size:18rpx}.product-scene view{margin-top:5rpx;color:#58645c;font-size:21rpx;line-height:1.6}.incense-product-copy button{width:100%;margin:auto 0 0;padding:0;border:1rpx solid #88734a!important;border-radius:3rpx;background:transparent!important;color:#655638!important;font-size:21rpx;line-height:61rpx}.product-note{margin-top:15rpx;color:#8b8d87;font-size:19rpx;line-height:1.65;text-align:center}

/* 将规则解释为用户易懂的四步流程，建立专业感而不暴露内部权重。 */
.method-section{margin-top:18rpx;padding:64rpx 32rpx 48rpx;background:#fffef9}.method-heading{text-align:center}.method-title{margin-top:10rpx;color:#263f35;font-family:"Songti SC","STSong",serif;font-size:39rpx;letter-spacing:3rpx}.method-copy{max-width:620rpx;margin:17rpx auto 0;color:#727973;font-size:23rpx;line-height:1.75}.method-grid{display:grid;grid-template-columns:1fr 1fr;margin-top:36rpx;border-top:1rpx solid #dcd4c6;border-left:1rpx solid #dcd4c6}.method-item{position:relative;min-height:160rpx;padding:27rpx 23rpx;border-right:1rpx solid #dcd4c6;border-bottom:1rpx solid #dcd4c6}.method-number{position:absolute;top:19rpx;right:20rpx;color:#c2ad7d;font-family:serif;font-size:18rpx}.method-item strong{display:block;color:#2f5143;font-family:"Songti SC","STSong",serif;font-size:29rpx;font-weight:500;letter-spacing:3rpx}.method-item view{margin-top:11rpx;color:#777d78;font-size:21rpx;line-height:1.55}

.brand-section{position:relative;margin-top:18rpx;padding:73rpx 42rpx 66rpx;border-top:1rpx solid #d7c7aa;border-bottom:1rpx solid #d7c7aa;background:linear-gradient(145deg,#f2ece1,#e5d9c7);color:#393b35;text-align:center}.brand-roundel{display:flex;align-items:center;justify-content:center;width:74rpx;height:74rpx;margin:0 auto 24rpx;border:1rpx solid #aa8d58;border-radius:50%;color:#856d40;font-family:"Songti SC","STSong","SimSun",serif;font-size:28rpx}.brand-section .section-kicker{color:#987e4e}.brand-title{margin:12rpx 0 26rpx;color:#34443b;font-family:"Songti SC","STSong","SimSun",serif;font-size:39rpx;font-weight:400;letter-spacing:6rpx}.brand-copy{max-width:650rpx;margin:0 auto;color:#62645e;font-size:24rpx;line-height:2;text-align:left}.story-conclusion{margin-top:28rpx;color:#735f3c;font-family:"Songti SC","STSong","SimSun",serif;font-size:23rpx;letter-spacing:2rpx}.story-link{display:inline-block;margin-top:29rpx;padding-bottom:4rpx;border-bottom:1rpx solid #9e8352;color:#725e39;font-size:21rpx;letter-spacing:2rpx}

.share-section{display:flex;align-items:center;justify-content:space-between;margin-top:18rpx;padding:36rpx 32rpx;background:#faf8f2}.share-section>view>text{display:block;color:#9a8454;font-family:serif;font-size:14rpx;letter-spacing:3rpx}.share-section strong{display:block;margin-top:8rpx;color:#2d453a;font-family:"Songti SC","STSong",serif;font-size:28rpx;font-weight:500}.share-section>view>view{margin-top:6rpx;color:#7a807b;font-size:20rpx}.share-section button{width:auto;margin:0 0 0 20rpx;padding:0 18rpx;border:1rpx solid #9b865c!important;border-radius:3rpx;background:transparent!important;color:#6f6041!important;font-size:20rpx;line-height:59rpx;white-space:nowrap}
.disclaimer{padding:38rpx 45rpx 0;color:#8a8d88;font-size:20rpx;line-height:1.7;text-align:center}
