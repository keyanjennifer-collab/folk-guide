page { background: #262626; color: #eee4d5; }
.test-page { min-height: 100vh; padding: 0 28rpx calc(150rpx + env(safe-area-inset-bottom)); background-color: #262626; background-image: linear-gradient(180deg,rgba(38,38,38,.88),rgba(28,28,28,.97)),var(--stone-texture); background-size: auto,760rpx; }
.test-heading { display: flex; min-height: 132rpx; align-items: center; justify-content: space-between; }
.test-heading image { width: 172rpx; height: 118rpx; }
.heading-label { color: #d6aa70; font-size: 28rpx; letter-spacing: 5rpx; }
.test-hero { position: relative; padding: 46rpx 38rpx 52rpx; overflow: hidden; background: linear-gradient(145deg,rgba(75,68,59,.98),rgba(45,44,42,.98)); border: 1rpx solid rgba(214,166,103,.2); border-radius: 28rpx; box-shadow: 0 18rpx 46rpx rgba(0,0,0,.2); }
.test-hero::after { position: absolute; top: -160rpx; right: -100rpx; width: 420rpx; height: 420rpx; background: radial-gradient(circle,rgba(190,134,76,.19),transparent 68%); content: ""; }
.hero-kicker { color: #d5a66d; font-family: -apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; font-size: 21rpx; letter-spacing: 5rpx; }
.hero-title { margin-top: 18rpx; color: #f5eadb; font-family: "Songti SC","STSong",serif; font-size: 62rpx; letter-spacing: 8rpx; }
.hero-subtitle { margin-top: 8rpx; color: #dfba87; font-family: "Songti SC","STSong",serif; font-size: 34rpx; letter-spacing: 5rpx; }
.hero-copy { max-width: 540rpx; margin-top: 24rpx; color: #c9bfb2; font-size: 27rpx; line-height: 1.8; }
.chart-section { padding: 48rpx 0 10rpx; }
.section-title { color: #f0e5d6; font-family: "Songti SC","STSong",serif; font-size: 43rpx; letter-spacing: 4rpx; }
.section-copy { margin-top: 10rpx; color: #aaa198; font-size: 26rpx; }
.chart-card { position: relative; display: flex; width: 100%; min-height: 300rpx; margin-top: 22rpx; padding: 30rpx; overflow: hidden; color: #eee4d5; background: #3a3937; border: 1rpx solid rgba(219,178,122,.16); border-radius: 24rpx; text-align: left; box-shadow: 0 16rpx 38rpx rgba(0,0,0,.16); }
.chart-card.natal { background: linear-gradient(145deg,#49443d,#343332); }
.chart-card.match { background: linear-gradient(145deg,#45453e,#323433); }
.chart-number { width: 56rpx; flex: none; color: #c9965c; font-family: Georgia,serif; font-size: 27rpx; }
.chart-copy { position: relative; z-index: 2; max-width: 420rpx; }
.chart-kicker { color: #b99162; font-size: 19rpx; letter-spacing: 3rpx; }
.chart-title { margin-top: 10rpx; color: #f1e4d3; font-family: "Songti SC","STSong",serif; font-size: 42rpx; letter-spacing: 4rpx; }
.chart-copy>text { display: block; margin-top: 14rpx; color: #c4baad; font-size: 26rpx; line-height: 1.75; }
.chart-action { margin-top: 24rpx; color: #e0b57b; font-size: 26rpx; }
.chart-orbit { position: absolute; right: -42rpx; bottom: -50rpx; display: flex; width: 230rpx; height: 230rpx; align-items: center; justify-content: center; border: 1rpx solid rgba(211,164,104,.26); border-radius: 50%; }
.chart-orbit>view { position: absolute; width: 150rpx; height: 150rpx; border: 1rpx solid rgba(211,164,104,.19); border-radius: 50%; }
.chart-orbit>view:nth-child(2) { width: 76rpx; height: 76rpx; }
.chart-orbit>text { color: rgba(224,181,123,.38); font-family: "Songti SC",serif; font-size: 38rpx; }
.chart-orbit.double { border-color: rgba(156,174,144,.28); }
.method-note { display: flex; gap: 20rpx; margin-top: 30rpx; padding: 26rpx; background: rgba(52,51,49,.9); border-radius: 20rpx; }
.note-mark { display: flex; width: 62rpx; height: 62rpx; flex: none; align-items: center; justify-content: center; color: #d9ad74; border: 1rpx solid rgba(209,161,102,.55); border-radius: 50%; font-family: "Songti SC",serif; font-size: 29rpx; }
.method-note>view:last-child { min-width: 0; }
.method-note>view:last-child>view { color: #e7d8c5; font-size: 29rpx; }
.method-note text { display: block; margin-top: 8rpx; color: #aaa198; font-size: 24rpx; line-height: 1.75; }
