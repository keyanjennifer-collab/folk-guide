.policy-page{min-height:100vh;padding:34rpx;color:var(--text);background:var(--canvas)}.screen-title{margin-bottom:24rpx;font-size:46rpx}.policy-card{margin-bottom:20rpx;padding:28rpx;background:#343331;border-radius:18rpx}.policy-card .title{margin-bottom:14rpx;color:var(--cream);font-family:var(--font-display);font-size:34rpx}.policy-card text{color:#cbc4b8;font-size:28rpx;line-height:1.9}.policy-card .block{display:block}.policy-note{padding:22rpx;color:var(--muted);font-size:25rpx;line-height:1.8}.policy-page.theme-day{color:#34342f;background:#d5d3ca}.policy-page.theme-day .policy-card{background:#e7e4da}.policy-page.theme-day .policy-card text{color:#55544e}
