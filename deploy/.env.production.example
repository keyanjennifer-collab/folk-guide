# 复制为 .env.production 后填写真实值；不要把 .env.production 提交到 Git。
ENVIRONMENT=production
AUTO_CREATE_SCHEMA=false
TESTING=false

# 域名（不要带 http:// 或路径）
SITE_DOMAIN=wusezhishi.com
API_DOMAIN=api.wusezhishi.com
CORS_ORIGINS=https://wusezhishi.com,https://www.wusezhishi.com

# PostgreSQL（请使用随机强密码）
POSTGRES_DB=folk_guide
POSTGRES_USER=folk_guide_app
POSTGRES_PASSWORD=replace-with-a-long-random-password

# 应用密钥（至少32/24位随机值）
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_API_KEY=replace-with-a-long-random-admin-key

# 真实微信凭据只放服务器；暂未配置时不要开放真实登录功能
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 模型未准备好时保持为空；联网搜索和知识库按方案保持关闭
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
AI_USE_KNOWLEDGE_BASE=false
AI_WEB_SEARCH_ENABLED=false
AI_WEB_SEARCH_ALWAYS=false

DAILY_SCHEDULER_ENABLED=true
KNOWLEDGE_STORAGE_ROOT=/app/storage/knowledge
