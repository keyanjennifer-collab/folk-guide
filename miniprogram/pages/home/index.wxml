<view class="home-page">
  <view style="height:{{statusBarHeight}}px"/>

  <view class="brandbar">
    <image class="brand-logo" src="/assets/brand/logo-ai.png" mode="aspectFit" aria-label="五色知时"/>
  </view>

  <view wx:if="{{contentSource === 'loading'}}" class="loading-card">
    <view class="skeleton wide"/><view class="skeleton"/><view class="skeleton short"/>
  </view>
  <view wx:elif="{{contentSource === 'error'}}" class="reload-card">
    <view class="reload-mark">时</view>
    <view class="reload-copy"><view>今日内容稍后即来</view><text>网络恢复后可立即重新读取，不会展示过期排行。</text></view>
    <button bindtap="loadToday">重新读取</button>
  </view>

  <block wx:else>
    <view class="overview-card">
      <view class="today-heading">
        <view class="today-date">{{solarDateLabel}}</view>
        <view class="today-title">今日五色</view>
        <view class="today-lunar">{{lunarDateLabel}}</view>
      </view>
      <scroll-view class="date-strip" scroll-x="true" enable-flex="true">
        <button wx:for="{{dayOptions}}" wx:key="date" class="date-option {{item.active ? 'active' : ''}}" bindtap="selectDate" data-date="{{item.date}}">
          <text>{{item.label}}</text><text class="date-weekday">{{item.weekday}}</text>
        </button>
      </scroll-view>
      <view class="rank-pills">
        <button wx:for="{{guides}}" wx:key="rank" class="rank-pill tone-{{item.product.id}} {{selected.rank === item.rank ? 'active' : ''}}" bindtap="selectGuide" data-rank="{{item.rank}}">
          <text>0{{item.rank}}</text><view>{{item.name}}</view><text class="rank-tier">{{item.tier}}</text>
        </button>
      </view>
      <view class="featured" wx:if="{{selected}}">
        <view class="featured-copy">
          <view class="featured-label">今日首选对应香品</view>
          <view class="featured-name">{{selected.product.name}}</view>
          <view class="featured-mood">{{selected.product.mood}}</view>
          <view class="featured-text">{{selected.scent}}</view>
          <button bindtap="toGuideProduct" data-id="{{selected.product.id}}">查看香品　›</button>
        </view>
        <view class="featured-image-wrap">
          <image class="featured-image" src="{{selected.product.image}}" mode="aspectFill"/>
        </view>
      </view>
    </view>

    <view class="detail-section">
      <view class="section-kicker">DAILY GUIDANCE</view>
      <view class="section-title">五色详解</view>
      <view class="section-intro">从适宜之事到行动节奏，把颜色建议落进真实的一天。</view>

      <view class="rule-basis-card">
        <view class="rule-seal"><text>{{dayBranch}}</text><view>{{dayElement}}</view></view>
        <view class="rule-basis-copy">
          <view class="rule-basis-title">日支取象 · {{dayPillar}}日</view>
          <view class="rule-basis-text">{{dayBasis}}</view>
          <view class="rule-order-label">固定色序关系</view>
          <view class="rule-order"><text>我生＝贵人　同我＝合作　克我＝奋斗</text><text>生我＝消耗　我克＝不利</text></view>
        </view>
      </view>

      <view wx:for="{{guides}}" wx:key="rank" class="guide-card tone-card-{{item.product.id}}">
        <view class="guide-head">
          <view class="guide-rank">0{{item.rank}}</view>
          <view class="guide-identity"><view>{{item.name}}</view><text>{{item.element}} · {{item.tier}}</text></view>
          <view class="guide-actions"><view class="status-chip">{{item.status}}</view><button bindtap="toggleGuide" data-rank="{{item.rank}}" aria-label="{{item.expanded ? '收起详情' : '展开详情'}}">{{item.expanded ? '收起 −' : '展开 ＋'}}</button></view>
        </view>
        <view class="swatch-row"><view wx:for="{{item.product.swatches}}" wx:for-item="swatch" wx:key="*this" style="background:{{swatch}}"/><text>{{item.palette}}</text></view>
        <view wx:if="{{item.expanded}}" class="advice-panel">
          <view class="relation-explanation"><text>色序依据</text><view>{{item.relationReason}}</view></view>
          <view class="micro-title">今日适宜</view>
          <view class="suitable-list"><text wx:for="{{item.suitable}}" wx:key="*this">{{item}}</text></view>
          <view class="micro-title">行动建议</view>
          <view class="body-copy">{{item.advice}}</view>
          <view class="notice"><text>留意</text><view>{{item.resistance}}</view></view>
        </view>
        <view wx:if="{{item.expanded}}" class="product-row">
          <view><text>对应香品</text><view>{{item.product.name}} · {{item.product.mood}}</view></view>
          <button bindtap="toGuideProduct" data-id="{{item.product.id}}">了解 ›</button>
        </view>
      </view>
      <view class="source-note">传统文化与日常生活参考，请结合实际情境判断。</view>
    </view>
  </block>

  <view class="life-section">
    <view class="section-kicker">A MOMENT FOR YOURSELF</view>
    <view class="section-title">知时小趣</view>
    <view class="section-intro">一个人慢慢看，也可以和家人朋友一起玩。</view>
    <view class="life-entries">
      <button data-tab="daily" bindtap="toExplore"><text class="life-mark">时</text><view>节气日常<text>观察、散步与书写</text></view><text>›</text></button>
      <button data-tab="scent" bindtap="toExplore"><text class="life-mark">香</text><view>选香小测<text>按此刻偏好循心择香</text></view><text>›</text></button>
      <button data-tab="quiz" bindtap="toExplore"><text class="life-mark">问</text><view>国学一题<text>独答或共玩皆有趣</text></view><text>›</text></button>
    </view>
  </view>

  <view class="gift">
    <view class="gift-copy"><view class="gift-kicker">五色齐备 · 一盒知时</view><view class="gift-title">五色知时线香套装</view><view class="gift-desc">青木、朱蜜、黄檀、白桂、墨沉</view><view class="gift-price price-figure">¥239 <text>参考价</text></view><button class="gift-button" bindtap="toGift">查看套装</button></view>
    <image class="gift-image" src="{{gift.image}}" mode="aspectFit"/>
  </view>

  <view class="home-links">
    <button bindtap="toAi"><text>时序文化</text><view>从典籍出发，聊聊此刻的困惑</view><text class="home-link-action">进入问答 ›</text></button>
    <button bindtap="toMine"><text>我的</text><view>登录、个人五色与订单记录</view><text class="home-link-action">查看账户 ›</text></button>
  </view>
  <view class="page-foot">五色知时 · 让传统文化自然进入日常</view>
</view>
