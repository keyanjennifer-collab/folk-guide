# 复制为 .env 后填写。不要把真实密钥提交到Git或发送到聊天中。
APP_NAME=五行五色 API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./folk_guide.db

# 至少32位随机字符串；生产环境请使用服务器密钥管理。
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=10080

# 真实微信登录；仅后端保存。
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 任意OpenAI兼容的聊天补全服务。三个字段必须同时填写，然后重启后端。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1200

# AI问答内部策略。当前先直接调用模型；未来知识库准备好后改为true并重启后端。
AI_USE_KNOWLEDGE_BASE=false

# 留空时使用项目storage/knowledge；生产可填写对象存储挂载目录。
KNOWLEDGE_STORAGE_ROOT=

# PDF解析：文字型PDF始终先在本地读取。只有显式开启后，扫描版才发送到指定MinerU服务。
PDF_MAX_PAGES=1000
PDF_MIN_TEXT_CHARS_PER_PAGE=20
PDF_MIN_OCR_CONFIDENCE=0.80
MINERU_ENABLED=false
MINERU_BASE_URL=
MINERU_TIMEOUT_SECONDS=1200

# 原型后台Key。生产环境必须替换为正式管理员账号与权限系统。
ADMIN_API_KEY=replace-with-a-long-random-admin-key
