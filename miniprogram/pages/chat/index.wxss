page{background:#151713;color:#d9caa8}.ai-page{padding:20rpx 34rpx 230rpx;background:#151713;min-height:100vh}.ai-heading{display:flex;align-items:center;justify-content:space-between}.ai-heading image{width:94rpx;height:80rpx}.ai-heading button{background:transparent;border:1rpx solid #5d5441;border-radius:30rpx;padding:0 20rpx;line-height:55rpx;font-size:22rpx;color:#bcab86}
.ai-intro{padding:48rpx 0 34rpx}.ai-intro .eyebrow{color:#a9966d;font-size:22rpx;letter-spacing:4rpx}.ai-title{font-family:"Songti SC",serif;font-size:52rpx;letter-spacing:4rpx;line-height:1.5;margin-top:18rpx}.ai-subtitle{font-size:25rpx;color:#a79d85;margin-top:12rpx}
.service-strip{display:flex;align-items:center;justify-content:space-between;padding:22rpx 0;border-top:1rpx solid #484637;border-bottom:1rpx solid #484637;gap:20rpx}.service-strip>view{min-width:0;flex:1}.service-title{font-size:25rpx;color:#c5b58f}.service-copy{color:#928971;font-size:21rpx;margin-top:4rpx}.login-link{padding:0;background:transparent;color:#c9ae76;font-size:23rpx;line-height:1.6}.quota-number{font-family:Georgia,serif;font-size:36rpx;color:#d1b87e;white-space:nowrap}.quota-number text{font-family:sans-serif;font-size:20rpx;color:#928971}
.personal-panel{border:1rpx solid #484637;margin-top:24rpx;padding:0 20rpx;background:#1c1f19}.personal-toggle{display:flex;align-items:center;justify-content:space-between;width:100%;text-align:left;background:transparent;padding:22rpx 0;color:#cabb99;border-radius:0;line-height:1.6;gap:20rpx}.personal-toggle>view{flex:1;min-width:0}.personal-toggle>view>view{font-family:serif;font-size:30rpx;letter-spacing:2rpx}.personal-toggle>view>text{font-size:21rpx;color:#9e947e}.personal-toggle>text{font-size:32rpx}.personal-content{border-top:1rpx solid #484637;padding:18rpx 0}.personal-copy{font-size:24rpx;color:#a89e86;margin:16rpx 0;line-height:1.85}.personal-summary{font-family:serif;font-size:28rpx;line-height:1.8}.personal-color-row{display:flex;align-items:center;gap:16rpx;width:100%;padding:18rpx 0;border-bottom:1rpx solid #454638;background:transparent;color:#c8bd9f;line-height:1.6;border-radius:0;font-size:25rpx}.personal-color-row>text:nth-last-child(2){margin-left:auto;font-size:22rpx}.personal-dot{width:18rpx;height:18rpx;border-radius:50%;background:#aaa}.personal-dot.green{background:#738557}.personal-dot.black{background:#424b46}.personal-dot.gold{background:#b38e46}.personal-dot.white{background:#d6cbb7}.personal-dot.red{background:#ac5650}.personal-detail{font-size:24rpx;line-height:1.9;color:#b0a68e;padding:20rpx 8rpx;border-bottom:1rpx solid #484637}.personal-label{font-size:21rpx;color:#c0aa78;margin-top:18rpx}.incense-link{background:transparent;color:#c4ad7c;padding:18rpx 0 0;text-align:left;line-height:1.8;font-size:23rpx}.profile-button{background:transparent;color:#c4ad7c;border:1rpx solid #796744;border-radius:3rpx;line-height:70rpx;font-size:24rpx;margin-top:22rpx}
.suggestion-title{font-family:"Songti SC",serif;font-size:30rpx;letter-spacing:2rpx;margin:34rpx 0 16rpx}.question-tabs{display:flex;justify-content:space-between;border-bottom:1rpx solid #3b3d31}.question-tabs button{padding:16rpx 0;color:#8f866f;background:transparent;border-radius:0;font-size:23rpx;line-height:1.5;border-bottom:2rpx solid transparent}.question-tabs button.active{color:#d3bb83;border-bottom-color:#b29963}.suggestions button{display:flex;align-items:center;justify-content:space-between;text-align:left;padding:22rpx 8rpx;background:transparent;color:#c2b798;border-bottom:1rpx solid #33362b;font-size:25rpx;line-height:1.7;border-radius:0;width:100%;gap:18rpx}.suggestions button>text:last-child{color:#a9956b}
.conversation-heading{display:flex;align-items:center;gap:24rpx;color:#8f866f;font-size:23rpx;margin:36rpx 0 24rpx}.conversation-heading>view{height:1rpx;background:#3b3d31;flex:1}.message{margin-bottom:24rpx;padding:24rpx;border:1rpx solid #3b3e31;background:#1d211a;border-radius:3rpx}.message.user{margin-left:44rpx;background:#303527;border-color:#4a513b}.message-role{color:#9d8a5f;font-size:20rpx;letter-spacing:2rpx;margin-bottom:12rpx}.message-text{font-size:28rpx;line-height:1.95;color:#d2c8af;white-space:pre-wrap;overflow-wrap:anywhere}.safety-note,.references{font-size:21rpx;color:#9f947d;margin-top:16rpx}.references>text{color:#bda679}.feedback-row{display:flex;gap:20rpx;margin-top:20rpx}.feedback-row button{padding:0;background:transparent;color:#8f866f;font-size:21rpx;line-height:1.8}.feedback-row button.chosen{color:#d4b87f}.thinking{color:#baa679;font-size:24rpx;padding:10rpx 0}
.composer-wrap{position:fixed;bottom:0;left:0;right:0;padding:22rpx 28rpx 16rpx;background:#151713;border-top:1rpx solid #464635;z-index:10}.composer{display:flex;align-items:flex-end;background:#252a20;border:1rpx solid #60583f;padding:14rpx;border-radius:4rpx;gap:10rpx}.composer textarea{flex:1;width:auto;min-height:58rpx;max-height:210rpx;padding:10rpx 6rpx;border:0;background:transparent;color:#ddcfaf;font-size:27rpx;line-height:1.6;margin:0}.composer button{background:#b9a06b;color:#20261c;padding:0 20rpx;font-size:25rpx;line-height:66rpx;border-radius:3rpx;flex:none}.ai-disclaimer{font-size:19rpx;color:#8e846f;text-align:center;padding-top:12rpx;letter-spacing:1rpx}
.ai-page{padding-bottom:calc(340rpx + env(safe-area-inset-bottom))}.composer-wrap{bottom:calc(110rpx + env(safe-area-inset-bottom))}
