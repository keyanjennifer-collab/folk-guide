font-size:18rpx}.personal-color-detail{padding:0 8rpx 23rpx 70rpx;color:#566159;font-size:22rpx;line-height:1.75}.personal-reason{margin-bottom:14rpx;padding:17rpx;border-left:3rpx solid #6c887a;background:#e8ede8}.personal-reason>text{color:#4c6a5c}.personal-detail-block{padding:14rpx 0;border-top:1rpx dashed #dcd6ca}.personal-suitable-list text{display:block}.personal-incense{display:flex;align-items:center;justify-content:space-between;margin-top:13rpx;padding:17rpx;border-left:3rpx solid #a88b4a;background:#eee6d5}.personal-incense>view{flex:1}.personal-incense text,.personal-incense strong,.personal-incense small{display:block}.personal-incense text{color:#8e794c;font-size:18rpx}.personal-incense strong{color:#3f493f;font-size:24rpx}.personal-incense small{color:#72766f;font-size:19rpx}.personal-incense button{width:auto;margin:0 0 0 13rpx;padding:0 15rpx;height:54rpx;line-height:52rpx;border:1rpx solid #9d8350;background:transparent;color:#715f3d;font-size:19rpx;border-radius:2rpx}.personal-incense button::after{border:0}.personal-calculation-note{margin-top:24rpx;padding-top:18rpx;border-top:1rpx solid #d8d1c4;color:#657068;font-size:21rpx;line-height:1.7}.personal-reminders{margin-top:12rpx;color:#7c837d;font-size:20rpx;line-height:1.7}.personal-reminders text{display:block}
