.explore-page{padding:36rpx 34rpx calc(60rpx + env(safe-area-inset-bottom));min-height:100vh}.explore-heading>text{display:block;margin-top:16rpx;color:#d7cbb7;font-size:28rpx}.explore-heading .screen-title{margin-top:12rpx;font-size:56rpx}.explore-tabs{display:flex;margin:36rpx 0;border-bottom:1rpx solid #807159}.explore-tabs button{flex:1;background:transparent;color:#ccbea7;border-radius:0;padding:22rpx 0;font-size:29rpx;line-height:1.8;border-bottom:3rpx solid transparent}.explore-tabs button.active{color:#f5d295;border-color:#e3b778}.section-title{font-size:39rpx;margin:30rpx 0 16rpx}.section-copy{font-size:29rpx;line-height:1.85;color:#d7cbb7}.idea-card{display:block;width:100%;text-align:left;margin-top:24rpx;padding:30rpx;background:rgba(44,43,36,.78);border:1rpx solid #817259;border-radius:8rpx;color:#f1e4ce;line-height:1.8}.idea-tag,.question-label{font-size:25rpx;letter-spacing:2rpx;color:#e3bc86}.idea-title{font-size:33rpx;font-family:"Songti SC",serif;margin-top:8rpx;display:flex;justify-content:space-between}.idea-copy{font-size:29rpx;margin-top:22rpx;color:#d7cbb7}.note{font-size:25rpx;line-height:1.9;color:#c0b39c;margin-top:32rpx}.taste-step{margin:36rpx 0}.question-title{font-family:"Songti SC",serif;font-size:37rpx;line-height:1.7;margin:14rpx 0 26rpx}.taste-options{display:flex;flex-direction:column;gap:16rpx}.taste-options button,.quiz-options button{background:rgba(40,40,34,.75);border:1rpx solid #85755c;color:#eadcc4;border-radius:6rpx;font-size:30rpx;line-height:1.7;padding:24rpx;text-align:left}.taste-options button.selected,.quiz-options button.correct{background:#dfb980;color:#29251e;border-color:#ecc78f}.taste-result{display:flex;gap:26rpx;padding:26rpx 0;border-top:1rpx solid #817259}.taste-result image{width:230rpx;height:340rpx;flex:none}.taste-result>view{flex:1;min-width:0}.result-title{font-family:serif;font-size:48rpx;margin:16rpx 0}.taste-result .eyebrow{font-size:24rpx;letter-spacing:0}.taste-result .outline-button{margin-top:20rpx;padding:0 16rpx;font-size:27rpx}.reset-taste{margin-top:18rpx;font-size:26rpx}.quiz-options{display:flex;flex-direction:column;gap:20rpx}.quiz-options button{display:flex;align-items:center;gap:20rpx}.quiz-options button[disabled]{opacity:1}.quiz-options button>text:last-child{margin-left:auto}.quiz-options button.selected{border-width:3rpx}.answer-card{margin-top:32rpx;background:rgba(44,43,36,.9);border:1rpx solid #85755c;border-radius:8rpx;padding:30rpx;font-size:30rpx;line-height:1.9}.answer-title{font-family:serif;color:#f0d1a0;font-size:33rpx;margin-bottom:18rpx}.source-link{display:block;background:transparent;color:#c7b99f;text-align:left;padding:22rpx 0;font-size:24rpx;line-height:1.8}
.explore-page{color:#4b4236;background-color:#e7e0d3}.explore-heading>text,.section-copy,.idea-copy,.note{color:#786d5d}.explore-tabs{border-bottom-color:#c4b6a0}.explore-tabs button{color:#817564}.explore-tabs button.active{color:#8f6330;border-color:#b18448}.idea-card,.answer-card{background:rgba(248,243,234,.72);border-color:#c4b397;color:#564938}.idea-tag,.question-label,.answer-title{color:#916a36}.taste-options button,.quiz-options button{background:rgba(248,243,234,.78);border-color:#c4b397;color:#594d3d}.quiz-options button.correct,.taste-options button.selected{background:#d5b274;color:#332b20}.source-link{color:#8a704b}
.explore-page{color:#eee6d8;background-color:#272c28;background-image:linear-gradient(rgba(39,44,40,.9),rgba(29,34,30,.95)),url('/assets/brand/stone-texture.jpg');background-size:auto,720rpx}.explore-heading>text,.section-copy,.idea-copy,.note{color:#b8b1a4}.explore-tabs{border-bottom-color:#59645b}.explore-tabs button{color:#aaa99b}.explore-tabs button.active{color:#e2b77c;border-color:#bf8d51}.section-title,.question-title{color:#f0e5d5}.idea-card,.answer-card{background:#353b36;border-color:#5d685f;color:#eee5d8;box-shadow:0 10rpx 20rpx rgba(20,23,20,.18)}.idea-tag,.question-label,.answer-title{color:#d3a46b}.taste-options button,.quiz-options button{background:#323832;border-color:#606b61;color:#ece3d5}.quiz-options button.correct,.taste-options button.selected{background:#b78b54;color:#fffaf2;border-color:#dbad71}.source-link{color:#d0a36a}.taste-result{border-top-color:#59645b}.result-title{color:#f0e5d5}
