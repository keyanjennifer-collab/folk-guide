.mine-page { min-height: 100vh; padding: 20rpx 34rpx calc(110rpx + env(safe-area-inset-bottom)); color: var(--text); background-color: #262626; background-image: linear-gradient(rgba(38, 38, 38, .88), rgba(25, 25, 25, .95)), var(--stone-texture); background-size: auto, 720rpx; }
.mine-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 26rpx; }
.mine-heading .brand-logo { width: 96rpx; height: 82rpx; }
.mine-heading .screen-title { font-size:56rpx; }
.identity-card { padding: 34rpx; color: var(--text); background: linear-gradient(145deg, #403e3a, #32312f); border-radius: 22rpx; box-shadow: 0 14rpx 30rpx rgba(11, 14, 12, .24); }
.identity-top { display: flex; align-items: center; }
.identity-seal { display: flex; width: 98rpx; height: 98rpx; flex: none; align-items: center; justify-content: center; color: #dfb77d; border: 1rpx solid #bc8b53; border-radius: 50%; font-family: "Songti SC", serif; font-size:50rpx; }
.identity-copy { min-width: 0; padding-left: 24rpx; }
.identity-title { color: var(--cream); font-family: "Songti SC", serif; font-size:40rpx; letter-spacing: 3rpx; }
.identity-subtitle { margin-top: 8rpx; color: var(--muted); font-size:30rpx; }
.login-button { width: 100%; margin-top: 30rpx; color: #fffaf2; background: var(--copper-deep); border-radius: 5rpx; font-size:34rpx; line-height: 80rpx; letter-spacing: 4rpx; }
.identity-footer { display: flex; justify-content: space-between; margin-top: 28rpx; padding-top: 22rpx; color: var(--muted); font-size:26rpx; }
.identity-action { padding: 0; color: var(--copper); background: transparent; font-size:27rpx; }
.account-error { margin-top: 20rpx; color: #e1b58b; font-size:28rpx; }
.orders-panel, .service-panel { margin-top: 20rpx; padding: 28rpx; background: #343331; border-radius: 20rpx; }
.panel-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.panel-title { color: var(--cream); font-family: "Songti SC", serif; font-size:37rpx; letter-spacing: 3rpx; }
.panel-heading .text-button { font-size:28rpx; }
.order-entries { display: flex; justify-content: space-between; padding: 6rpx 0; }
.order-entry { width: 25%; padding: 0 4rpx; color: #d0c8bd; background: transparent; border-radius: 0; font-size:30rpx; line-height: 1.6; }
.order-symbol { position: relative; width: 52rpx; height: 44rpx; margin: 8rpx auto 18rpx; border: 1.5rpx solid #c0955b; border-radius: 4rpx; }
.order-symbol::before { position: absolute; top: 11rpx; right: 8rpx; left: 8rpx; border-top: 1rpx solid #c0955b; content: ""; }
.order-symbol.box::before { top: 0; bottom: 0; left: 50%; border-top: 0; border-left: 1rpx solid #c0955b; }
.order-symbol.delivery { border-radius: 4rpx 14rpx 4rpx 4rpx; }
.order-symbol.delivery::after { position: absolute; bottom: -7rpx; left: 7rpx; width: 9rpx; height: 9rpx; background: var(--canvas); border: 1rpx solid #c0955b; border-radius: 50%; box-shadow: 26rpx 0 var(--canvas); content: ""; }
.order-symbol.service { width: 44rpx; height: 44rpx; border-radius: 50%; }
.order-symbol.service::before { top: 13rpx; left: 12rpx; width: 16rpx; height: 10rpx; border: 1rpx solid #c0955b; border-radius: 50%; }
.order-count { position: absolute; top: -14rpx; right: -20rpx; min-width: 28rpx; color: #ddb071; background: var(--canvas); font-size:25rpx; line-height: 28rpx; text-align: center; }
.profile-link { display: flex; align-items: center; width: 100%; margin-top: 18rpx; padding: 28rpx; color: #dec298; background: #373634; border-radius: 20rpx; line-height: 1.6; text-align: left; }
.profile-seal { width: 68rpx; height: 68rpx; flex: none; margin-right: 22rpx; color: #d4aa70; border: 1rpx solid #b99660; border-radius: 50%; font-family: serif; font-size:36rpx; line-height: 68rpx; text-align: center; }
.profile-title { color: var(--cream); font-family: "Songti SC", serif; font-size:35rpx; letter-spacing: 3rpx; }
.profile-link .muted { margin-top: 4rpx; font-size:29rpx; }
.arrow { margin-left: auto; padding-left: 16rpx; color: #d6ab71; font-size:36rpx; }
.service-label { color: #aaa99f; font-size:26rpx; letter-spacing: 2rpx; }
.service-link { display: flex; align-items: center; width: 100%; padding: 13rpx 0; color: #dec298; background: transparent; border-radius: 0; line-height: 1.7; text-align: left; }
.service-copy { min-width: 0; flex: 1; }
.service-title { font-size:31rpx; }
.service-description { display: block; max-width: 500rpx; overflow: hidden; color: var(--muted); font-size:29rpx; text-overflow: ellipsis; white-space: nowrap; }
.history-link { margin-top: 6rpx; }
.menu-panel { margin-top: 14rpx; }
.menu-row { display: flex; align-items: center; justify-content: space-between; width: 100%; margin-top: 10rpx; padding: 24rpx; color: #e7cba0; background: #333230; border-radius: 15rpx; font-size:34rpx; line-height: 1.8; text-align: left; }
.menu-value { color: var(--muted); font-size:30rpx; }
.logout-button { margin: 32rpx auto 0; color: #d2a367; background: transparent; border: 1rpx solid #826344; border-radius: 5rpx; font-size:29rpx; line-height: 72rpx; letter-spacing: 3rpx; }
