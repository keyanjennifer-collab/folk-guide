.ziwei-page { min-height: 100vh; padding: 28rpx 28rpx 64rpx; color: #eee4d5; background: #262626; background-image: linear-gradient(rgba(38,38,38,.9), rgba(25,25,25,.97)), var(--stone-texture); }
.hero { padding: 22rpx 8rpx 30rpx; } .eyebrow { color: #d3a56f; font-size: 22rpx; letter-spacing: 3rpx; } .title { margin-top: 9rpx; color: #f2e1ca; font-family: "Songti SC", serif; font-size: 46rpx; } .subtitle { margin-top: 12rpx; color: #bdb4a8; font-size: 25rpx; line-height: 1.7; }
.mode-tabs,.relation-row,.gender,.topic-row { display: flex; gap: 12rpx; } .mode-tabs { margin-bottom: 18rpx; } .mode-tabs button,.relation-row button,.gender button { flex: 1; margin: 0; color: #c7bdaf; background: #3a3937; border: 1rpx solid #5b5650; border-radius: 12rpx; font-size: 26rpx; } .mode-tabs button.active,.relation-row button.active,.gender button.active,.primary { color: #fff9ef; background: #96663c; border-color: #b48758; }
.card { margin-top: 20rpx; padding: 26rpx; background: #343331; border-radius: 20rpx; box-shadow: 0 10rpx 24rpx rgba(0,0,0,.16); } .card-title { color: #f1dfc8; font-family: "Songti SC", serif; font-size: 32rpx; } .field { padding: 18rpx 0; border-bottom: 1rpx solid #4d4944; } .field>text,.person-title { display: block; margin-bottom: 10rpx; color: #cdb99d; font-size: 26rpx; } .person-title { margin-top: 22rpx; color: #e9d2af; font-family: "Songti SC", serif; font-size: 30rpx; } input,.picker { box-sizing: border-box; width: 100%; min-height: 76rpx; padding: 16rpx 18rpx; color: #eee4d5; background: #2d2d2c; border: 1rpx solid #5b5650; border-radius: 12rpx; font-size: 28rpx; } .picker { display: flex; justify-content: space-between; } picker { margin: 0; padding: 0; background: transparent; border: 0; }
.primary { width: 100%; margin-top: 28rpx; border-radius: 10rpx; font-size: 29rpx; } .divider { height: 1rpx; margin-top: 28rpx; background: #575049; }.result { border: 1rpx solid #745638; }.summary { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 18rpx; }.summary>view { padding: 16rpx; background: #3d3b38; border-radius: 12rpx; }.summary text { display: block; color: #aaa194; font-size: 23rpx; }.summary view { margin-top: 5rpx; color: #eee1d0; font-size: 25rpx; }.palace-title { margin: 24rpx 0 13rpx; color: #dfbd8b; font-size: 28rpx; }.palace-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; }.palace { min-height: 112rpx; padding: 13rpx; background: #3b3936; border-radius: 11rpx; }.palace.ming { background: #514232; border: 1rpx solid #9f774c; }.palace>text { color: #e8d4b7; font-size: 23rpx; }.star { display: inline-block; margin: 7rpx 6rpx 0 0; color: #f2e3cc; font-size: 24rpx; }.age { display: block; margin-top: 8rpx; color: #a59b8e; font-size: 20rpx; }.note,.basis { margin-top: 18rpx; color: #aaa194; font-size: 23rpx; line-height: 1.7; }.observation { margin-top: 13rpx; padding: 15rpx; color: #ddd1c2; background: #3c3936; border-radius: 10rpx; font-size: 25rpx; line-height: 1.65; }.topic-row { flex-wrap: wrap; }.topic-row text { padding: 8rpx 14rpx; color: #e7c795; background: #4b4034; border-radius: 24rpx; font-size: 23rpx; }.saved-row { display: flex; align-items: center; justify-content: space-between; width: 100%; margin: 13rpx 0 0; padding: 17rpx; color: #eadbc8; background: #3b3937; border-radius: 11rpx; text-align: left; font-size: 26rpx; }.saved-row view text { display: block; margin-top: 5rpx; color: #aaa194; font-size: 22rpx; }.loading { padding: 54rpx; color: #bdb4a8; text-align: center; }.muted,.placeholder { color: #aaa194; }.switch-row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid #4d4944; color: #cdb99d; font-size: 26rpx; }.detail-input { margin-top: 13rpx; }.hint { margin-top: 9rpx; color: #aaa194; font-size: 22rpx; line-height: 1.5; }
.section-label,.analysis-nav-title { margin-top: 28rpx; margin-bottom: 12rpx; color: #dfbd8b; font-size: 26rpx; }.period-scroll,.analysis-scroll { width: 100%; white-space: nowrap; }.period-tabs,.analysis-tabs { display: inline-flex; gap: 12rpx; }.period-tab,.analysis-tab { display: inline-block; width: auto; min-width: 132rpx; margin: 0; padding: 13rpx 20rpx; color: #bdb4a8; background: #3b3936; border: 1rpx solid #5b5650; border-radius: 12rpx; font-size: 23rpx; line-height: 1.3; }.period-tab.active,.analysis-tab.active { color: #fff8ea; background: #725337; border-color: #c08b54; }.palace.selected { border: 1rpx solid #d0a36b; box-shadow: 0 0 0 2rpx rgba(208,163,107,.16); }.analysis-nav-title { margin-top: 30rpx; font-family: "Songti SC", serif; font-size: 31rpx; }.analysis-panel { margin-top: 16rpx; padding: 22rpx; background: #2d2c2b; border: 1rpx solid #5e4b39; border-radius: 16rpx; }.analysis-heading { display: flex; align-items: flex-start; justify-content: space-between; }.analysis-kicker { color: #b8a18a; font-size: 21rpx; }.analysis-title { margin-top: 5rpx; color: #f1dfc8; font-family: "Songti SC", serif; font-size: 35rpx; }.analysis-palace { padding: 9rpx 15rpx; color: #e7c795; background: #493b2d; border-radius: 22rpx; font-size: 23rpx; }.analysis-stars { display: flex; justify-content: space-between; margin-top: 20rpx; padding: 15rpx; color: #edcf9e; background: #3a3631; border-radius: 10rpx; font-size: 25rpx; }.analysis-stars text:first-child { color: #a99d8d; }.analysis-block { margin-top: 17rpx; }.analysis-block-title { display: block; margin-bottom: 7rpx; color: #d5ad75; font-size: 23rpx; }.analysis-copy { display: block; color: #ddd1c2; font-size: 25rpx; line-height: 1.75; }.analysis-block.advice { padding-top: 15rpx; border-top: 1rpx solid #4d4944; }
.analysis-overlay { margin-top: 15rpx; padding: 11rpx 14rpx; color: #d7b276; background: #3b332a; border-left: 4rpx solid #b9874d; border-radius: 8rpx; font-size: 22rpx; line-height: 1.5; }

.result-hero { padding: 26rpx 8rpx 14rpx; }
.result-actions { display: flex; justify-content: flex-end; margin-bottom: 8rpx; }
.danger-action { margin: 0; padding: 7rpx 14rpx; color: #e8b0a7; background: transparent; border: 1rpx solid #76504b; border-radius: 10rpx; font-size: 22rpx; }
.danger-action::after { border: 0; }

.remote-loading { margin-top: 18rpx; padding: 15rpx; color: #cdb99d; background: #3b3936; border-radius: 10rpx; font-size: 24rpx; }.remote-analysis { margin-top: 18rpx; padding: 18rpx; background: #2a2928; border: 1rpx solid #6b5137; border-radius: 12rpx; }.remote-title { margin-bottom: 12rpx; color: #e7c795; font-family: "Songti SC", serif; font-size: 29rpx; }.remote-copy { display: block; white-space: pre-wrap; color: #e4d8c9; font-size: 25rpx; line-height: 1.85; }
