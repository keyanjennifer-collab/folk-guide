.checkout-page{min-height:100vh;padding:30rpx 30rpx calc(150rpx + env(safe-area-inset-bottom));color:var(--text);background:var(--canvas)}.checkout-page .screen-title{font-size:48rpx}.section-card{margin-top:24rpx;padding:28rpx;background:#343331;border-radius:20rpx;box-shadow:0 10rpx 24rpx rgba(0,0,0,.16)}.section-title{margin-bottom:20rpx;color:var(--cream);font-family:var(--font-display);font-size:34rpx}.address-list{display:flex;white-space:nowrap}.address-card{display:inline-block;width:590rpx;margin-right:18rpx;padding:22rpx;color:var(--text);background:#3d3b38;border:2rpx solid transparent;border-radius:16rpx;text-align:left;white-space:normal}.address-card.selected{border-color:#b9854e}.address-card view{font-size:29rpx}.address-card text{display:block;margin-top:8rpx;color:var(--muted);font-size:25rpx;line-height:1.7}.address-actions{display:flex;align-items:center;gap:18rpx;margin-top:20rpx}.address-actions .outline-button,.address-actions .solid-button{flex:1;line-height:72rpx}.address-actions .danger-text{color:#c9877b}.address-form input,.picker-field,.address-form textarea{margin-top:16rpx}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.picker-field{min-height:82rpx;padding:20rpx 24rpx;color:var(--text);background:#323232;border:2rpx solid #5a5650;border-radius:14rpx;font-size:29rpx}.checkout-item{display:flex;align-items:center;padding:18rpx 0;border-bottom:1rpx solid var(--line)}.checkout-item:last-child{border:0}.checkout-item image{width:84rpx;height:108rpx;margin-right:18rpx;border-radius:5rpx}.checkout-item>view{min-width:0;flex:1}.checkout-item>view view{font-size:29rpx}.checkout-item>view text{color:var(--muted);font-size:25rpx}.checkout-item>text{color:var(--copper);font-size:27rpx}.summary-row{display:flex;justify-content:space-between;gap:24rpx;padding:14rpx 0;font-size:28rpx}.summary-row>text:first-child{color:var(--muted)}.totals .total{margin-top:8rpx;padding-top:22rpx;border-top:1rpx solid var(--line);font-size:34rpx}.totals .total>text:last-child{color:var(--copper)}textarea{height:130rpx;margin-top:18rpx}.agreement{display:flex;align-items:center;gap:8rpx;margin-top:24rpx;font-size:25rpx}.agreement checkbox{transform:scale(.82)}.agreement .text-button{font-size:25rpx}.security-note{margin:18rpx 6rpx;color:var(--muted);font-size:23rpx;line-height:1.7}.pay-button{position:fixed;z-index:10;right:30rpx;bottom:calc(24rpx + env(safe-area-inset-bottom));left:30rpx;color:#fffaf2;background:var(--copper-deep);border-radius:8rpx;font-size:31rpx;line-height:88rpx;box-shadow:0 12rpx 28rpx rgba(0,0,0,.3)}.pay-button[disabled]{opacity:.55}.checkout-page.theme-day{color:#34342f;background:#d5d3ca}.checkout-page.theme-day .section-card{color:#34342f;background:#e7e4da}.checkout-page.theme-day .picker-field{color:#34342f;background:#f1eee5;border-color:#b8b5aa}
