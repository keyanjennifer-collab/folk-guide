/* 与深色概念稿统一；保留已有档案与历法功能。 */
.profile-page{background:#0d0e0d;color:#e7cfab;padding:28rpx}
.profile-hero{background:linear-gradient(145deg,#26271f,#151713);border:1rpx solid #514330;border-radius:4rpx;color:#e7cfab}
.hero-kicker,.hero-kicker.dark{color:#c99c5f}.hero-title{font-family:"Songti SC",serif;font-weight:400}
.hero-copy,.completion small{color:#b3a38a}.completion{background:#c99c5f0d;border-color:#6a5438}
.loading-card,.form-card,.mode-card,.calendar-card,.load-error-card{background:#191a16;border:1rpx solid #3c3428;border-radius:4rpx}
.mode-icon,.mode-card.simplified .mode-icon{background:#302c21;color:#e1b97f;border-radius:4rpx}
.mode-card text,.field-head small,.switch-row text,.field-note,.timezone-row,.privacy-row,.safe-note,.calendar-note,.loading-card{color:#a4947e}
.field,.switch-row{border-color:#3c3428}.field-head{font-weight:400}
.segmented button,.gender-row button{background:#272820;color:#bdad91;border:1rpx solid #49402f;border-radius:3rpx}
.segmented button.active,.gender-row button.active,.save-button{background:#c99c5f;color:#10110e;border-radius:3rpx}
.picker-value,input,.time-field{background:#12130f;color:#e7cfab;border-color:#49402f;border-radius:3rpx}
picker{padding:0;border:0;background:transparent}.picker-value.placeholder{color:#8f826e}
.privacy-row text{color:#c99c5f}.delete-button{background:#2b1e1b;color:#d79d90;border:1rpx solid #62433a;border-radius:3rpx}
.version-tag,.date-results view,.meta-grid view{background:#25261f;color:#bcac90;border-radius:3rpx}
.date-results text,.meta-grid text,.meta-grid small{color:#a4947e}
.calendar-title,.pillars-title{font-family:"Songti SC",serif;font-weight:400}
.pillars view{background:#363023;color:#e7cfab;border:1rpx solid #685337;border-radius:3rpx}
.pillars text{color:#c99c5f}.pillars .muted-pillar{background:#262820;color:#8f826e}
