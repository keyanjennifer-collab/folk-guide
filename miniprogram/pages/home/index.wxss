.home-page { min-height: 100vh; padding-bottom: calc(110rpx + env(safe-area-inset-bottom)); color: var(--text); background-color: #262626; background-image: linear-gradient(135deg, rgba(38, 38, 38, .88), rgba(25, 25, 25, .94)), url('/assets/brand/stone-texture.jpg'); background-size: auto, 720rpx; font-family: "Songti SC", "STSong", serif; }
.brandbar { display: flex; align-items: center; justify-content: center; height: 174rpx; background: rgba(28, 33, 29, .62); border-bottom: 1rpx solid rgba(208, 161, 102, .24); }
.brandbar .brand-logo { width: 226rpx; height: 164rpx; }
.today { display: flex; min-height: 940rpx; background: rgba(52, 52, 52, .84); border-bottom: 1rpx solid rgba(208, 161, 102, .24); }
.ranking { width: 52%; flex: none; padding: 30rpx 18rpx 24rpx 28rpx; border-right: 1rpx solid rgba(208, 161, 102, .3); }
.ranking .eyebrow { overflow: hidden; color: #d8aa70; font-size: 18rpx; letter-spacing: 1rpx; text-overflow: ellipsis; white-space: nowrap; }
.today-title { margin-top: 8rpx; color: #f3e9da; font-size: 52rpx; line-height: 1.25; letter-spacing: 4rpx; }
.today-subtitle { min-height: 68rpx; margin: 10rpx 0 14rpx; color: #beb8ac; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 21rpx; line-height: 1.6; }
.color-guide-button { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 62rpx; padding: 0 13rpx; color: #e7c28d; background: rgba(170, 119, 67, .16); border: 1rpx solid #a77e4d; border-radius: 4rpx; font-size: 21rpx; line-height: 1.5; }
.color-guide-button text { color: #f1d2a5; font-size: 19rpx; }
.rank-list { margin-top: 20rpx; overflow: hidden; background: rgba(248, 242, 231, .95); border: 1rpx solid rgba(219, 177, 119, .34); border-radius: 6rpx; }
.rank-row { position: relative; display: flex; align-items: stretch; width: 100%; height: 108rpx; padding: 0; overflow: hidden; color: #554936; background: rgba(248, 242, 231, .96); border-bottom: 1rpx solid rgba(113, 92, 64, .2); border-radius: 0; line-height: 1.5; text-align: left; }
.rank-row:last-child { border-bottom: 0; }
.rank-row.selected { background: #dfc8a7; }
.rank-row.selected::after { position: absolute; top: 0; right: 0; bottom: 0; width: 5rpx; background: #a97743; content: ""; }
.rank-accent { width: 7rpx; flex: none; background: #b8aa94; }
.rank-accent.tone-green { background: #667a5c; }
.rank-accent.tone-black { background: #3d4541; }
.rank-accent.tone-gold { background: #bd873d; }
.rank-accent.tone-white { background: #d7ccbb; }
.rank-accent.tone-red { background: #a84e49; }
.rank-no { display: flex; width: 60rpx; flex: none; align-items: center; justify-content: center; color: #786449; border-right: 1rpx solid rgba(113, 92, 64, .16); font-family: Georgia, serif; font-size: 30rpx; }
.rank-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; justify-content: center; padding: 10rpx 7rpx 10rpx 12rpx; }
.rank-main { display: flex; align-items: baseline; gap: 4rpx; white-space: nowrap; }
.rank-color { color: #554936; font-size: 26rpx; }
.rank-slash { color: #aa9476; font-size: 18rpx; }
.rank-status { color: #946538; font-size: 18rpx; }
.rank-note { margin-top: 5rpx; overflow: hidden; color: #786b5a; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.calendar-line { padding-top: 18rpx; color: #b5afa4; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 18rpx; line-height: 1.6; }
.archive-badge { display: inline-block; margin-top: 10rpx; padding: 4rpx 10rpx; color: #e1bd89; background: rgba(166, 116, 64, .14); border: 1rpx solid rgba(204, 153, 91, .46); border-radius: 40rpx; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 18rpx; }
.rank-empty { padding: 48rpx 8rpx 40rpx 0; color: var(--cream); font-size: 31rpx; }
.rank-empty>text { display: block; margin: 22rpx 0; color: var(--muted); font-size: 24rpx; line-height: 1.85; }
.rank-empty .outline-button { padding: 0 18rpx; font-size: 24rpx; }
.scent-stage { position: relative; width: 48%; min-height: 940rpx; padding: 28rpx 15rpx 0; overflow: hidden; text-align: center; background: linear-gradient(180deg, #ded6c8 0%, #c9bca8 62%, #a99478 100%); }
.scent-heading { position: relative; z-index: 3; color: #564a3a; font-size: 25rpx; letter-spacing: 2rpx; }
.product-emblem { position: relative; z-index: 3; width: 92rpx; height: 92rpx; margin: 12rpx auto 0; }
.scent-name { position: relative; z-index: 3; margin-top: 4rpx; color: #4d4438; font-size: 47rpx; line-height: 1.2; letter-spacing: 3rpx; }
.scent-mood { position: relative; z-index: 3; margin-top: 7rpx; color: #715e46; font-size: 23rpx; letter-spacing: 2rpx; }
.scent-notes { position: relative; z-index: 3; margin-top: 8rpx; color: #695e51; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 17rpx; white-space: nowrap; }
.inline-aroma { position: relative; z-index: 3; margin-top: 13rpx; padding-top: 12rpx; color: #62584d; border-top: 1rpx solid rgba(98, 72, 42, .25); font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; text-align: left; }
.aroma-intro { font-size: 18rpx; line-height: 1.58; }
.aroma-notes { display: flex; margin-top: 10rpx; }
.aroma-notes>view { width: 33.33%; padding: 0 4rpx; border-right: 1rpx solid rgba(98, 72, 42, .2); }
.aroma-notes>view:last-child { border: 0; }
.aroma-notes text { color: #966937; font-size: 16rpx; }
.aroma-notes>view>view { color: #695e51; font-size: 16rpx; line-height: 1.5; white-space: nowrap; }
.visual-frame { position: absolute; top: 428rpx; right: 12rpx; bottom: 14rpx; left: 12rpx; overflow: hidden; background: #343a35; border: 1rpx solid rgba(70, 74, 67, .48); border-radius: 8rpx; box-shadow: 0 10rpx 28rpx rgba(30, 27, 22, .28); }
.product-visual { width: 100%; height: 100%; transform: scale(1.03); transform-origin: 50% 100%; }
.visual-fade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(38, 42, 37, .1), transparent 42%, rgba(22, 25, 22, .38)); }
.aroma-button { position: absolute; z-index: 5; right: 27rpx; bottom: 28rpx; padding: 0 17rpx; color: #edc792; background: rgba(37, 42, 37, .88); border: 1rpx solid #b48650; border-radius: 30rpx; font-size: 21rpx; line-height: 54rpx; }
.life-section { padding: 38rpx 30rpx 40rpx; background: rgba(45, 45, 45, .92); border-bottom: 1rpx solid var(--line); }
.life-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 18rpx; }
.life-heading>view { color: var(--cream); font-size: 36rpx; letter-spacing: 3rpx; }
.life-heading>text { color: var(--muted); font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 21rpx; text-align: right; }
.life-entries { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; margin-top: 24rpx; }
.life-entries button { display: flex; min-height: 202rpx; flex-direction: column; align-items: flex-start; justify-content: space-between; padding: 20rpx 16rpx; color: var(--text); background: linear-gradient(145deg, #414141, #353535); border: 1rpx solid #625d56; border-radius: 6rpx; text-align: left; }
.life-mark { color: var(--copper); font-size: 38rpx; }
.life-entries button>view { font-size: 24rpx; line-height: 1.5; }
.life-entries button>view>text { display: block; margin-top: 7rpx; color: var(--muted); font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 18rpx; line-height: 1.45; }
.life-entries button>text:last-child { align-self: flex-end; color: var(--copper); font-size: 30rpx; }
.gift { position: relative; height: 398rpx; overflow: hidden; background: linear-gradient(115deg, rgba(48, 53, 47, .97), rgba(30, 35, 31, .9) 64%, rgba(43, 42, 36, .94)), url('/assets/brand/stone-texture.jpg'); background-size: auto, cover; border-bottom: 1rpx solid rgba(208, 161, 102, .24); }
.gift-copy { position: relative; z-index: 2; width: 55%; padding: 38rpx 0 0 32rpx; }
.gift-kicker { margin-bottom: 12rpx; color: #d3a66c; font-size: 19rpx; letter-spacing: 2rpx; }
.gift-title { color: #f0d5aa; font-size: 41rpx; line-height: 1.3; letter-spacing: 2rpx; }
.gift-desc { margin-top: 10rpx; color: #c4b9a7; font-size: 22rpx; white-space: nowrap; }
.gift-price { margin: 14rpx 0; color: #e6bc82; font-family: Georgia, serif; font-size: 46rpx; }
.gift-price text { color: #aaa295; font-family: sans-serif; font-size: 19rpx; }
.gift-button { display: inline-block; min-width: 182rpx; height: 64rpx; padding: 0 22rpx; color: #fffaf2; background: #a97743; border: 1rpx solid #d0a166; border-radius: 4rpx; font-size: 26rpx; line-height: 62rpx; letter-spacing: 2rpx; }
.gift-image { position: absolute; right: -96rpx; bottom: -12rpx; width: 510rpx; height: 384rpx; opacity: .82; }
.home-links { display: flex; background: rgba(29, 34, 30, .78); border-bottom: 1rpx solid var(--line); }
.home-links button { width: 50%; padding: 25rpx 30rpx; color: #e3bd86; background: transparent; border-radius: 0; line-height: 1.7; text-align: left; }
.home-links button+button { border-left: 1rpx solid var(--line); }
.home-links text { font-size: 29rpx; }
.home-links view { margin-top: 5rpx; color: var(--muted); font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 21rpx; }
.guide-status { padding-bottom: 20rpx; color: var(--copper); border-bottom: 1rpx solid var(--line); }
.guide-swatches { display: flex; padding-top: 22rpx; }
.guide-swatches view { width: 58rpx; height: 58rpx; margin-right: -8rpx; border: 2rpx solid #d9bd92; border-radius: 50%; }
.detail-title { margin: 24rpx 0 10rpx; color: #e4b97e; font-size: 26rpx; }
.detail-text { color: #d3c9bb; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 28rpx; line-height: 1.9; }
.guide-note { margin-top: 28rpx; font-size: 22rpx; }
