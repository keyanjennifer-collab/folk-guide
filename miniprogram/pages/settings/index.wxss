/*
 * 我的：暖纸色个人中心。
 * 信息顺序固定为身份概览、本人档案、个人服务、常用入口和账号管理。
 */
.mine-page{box-sizing:border-box;min-height:100vh;padding:24rpx 24rpx 54rpx!important;background:radial-gradient(circle at 94% 0,rgba(171,139,82,.11),transparent 28%),linear-gradient(180deg,#eee6da,#f6f1e9 560rpx,#f2ece3)!important;color:#3c413c;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}
.mine-page button::after{border:0}

/* 登录前与登录后的身份名片使用同一视觉，不再铺大面积深绿。 */
.user-hero,.guest-hero{position:relative;overflow:hidden;padding:36rpx 33rpx 31rpx!important;border:1rpx solid #d0bc98!important;border-radius:9rpx!important;background:linear-gradient(145deg,#f7f1e7,#dfd0b8)!important;color:#3b413c!important;box-shadow:0 17rpx 42rpx rgba(68,57,40,.09)!important}
.mine-moon{position:absolute;right:-48rpx;top:-88rpx;width:280rpx;height:280rpx;border:1rpx solid rgba(151,118,62,.18);border-radius:50%;box-shadow:inset 0 0 0 32rpx rgba(255,253,247,.12)}
.user-overline,.guest-overline{position:relative;z-index:1;margin-bottom:19rpx;color:#997c49;font-family:Georgia,"Times New Roman",serif;font-size:13rpx;letter-spacing:4rpx}
.identity-row{position:relative;z-index:1;display:flex;align-items:center}.avatar,.guest-avatar{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:82rpx;height:82rpx;flex:0 0 82rpx;border:1rpx solid #a98a54;border-radius:50%;background:rgba(255,253,248,.48);color:#745f3b;font-family:"Songti SC","STSong","SimSun",serif;font-size:34rpx;font-weight:400}.user-main{min-width:0;margin-left:19rpx;flex:1}.user-name,.guest-title{color:#3f4842!important;font-family:"Songti SC","STSong","SimSun",serif!important;font-size:33rpx;font-weight:400!important;letter-spacing:3rpx}.user-id{overflow:hidden;margin-top:4rpx;color:#74786f;font-size:20rpx;white-space:nowrap;text-overflow:ellipsis}.settings-mark{align-self:flex-start;margin-top:5rpx;color:#a18450;font-family:Georgia,"Times New Roman",serif;font-size:13rpx;letter-spacing:2rpx}
.hero-stats{position:relative;z-index:1;display:grid;grid-template-columns:repeat(3,1fr);margin-top:27rpx;padding:21rpx 0;border-top:1rpx solid rgba(162,133,80,.3);border-bottom:1rpx solid rgba(162,133,80,.3);background:rgba(255,253,248,.24)}.hero-stats view{text-align:center;border-right:1rpx solid rgba(162,133,80,.22)}.hero-stats view:last-child{border:0}.hero-stats strong,.hero-stats text{display:block}.hero-stats strong{color:#4b504a;font-family:Georgia,"Times New Roman",serif;font-size:34rpx;font-weight:400;line-height:1.3}.hero-stats text{margin-top:4rpx;color:#7d7f77;font-size:17rpx}
.guest-hero{text-align:left}.guest-avatar{position:relative;z-index:1;margin-bottom:20rpx}.guest-title{font-size:37rpx}.guest-copy{position:relative;z-index:1;max-width:590rpx;margin:13rpx 0 25rpx;color:#686d66;font-size:23rpx;line-height:1.8}.guest-hero button{position:relative;z-index:1;margin:0;border-radius:3rpx!important;background:#4b504b!important;color:#fff9ee!important;font-size:25rpx;letter-spacing:2rpx}.login-note{position:relative;z-index:1;margin-top:13rpx;color:#85877f;font-size:18rpx;text-align:center}

/* 本人档案 */
.profile-card{display:flex;align-items:center;margin:19rpx 0;padding:25rpx!important;border:1rpx solid #ddd4c7!important;border-radius:7rpx!important;background:#fdfaf4!important;box-shadow:0 12rpx 31rpx rgba(58,54,45,.05)!important}.profile-icon{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:64rpx;height:64rpx;margin-right:17rpx;flex:0 0 64rpx;border:1rpx solid #ae925e;border-radius:50%;background:#f5ede0;color:#826b41}.file-symbol{position:relative;box-sizing:border-box;width:26rpx;height:33rpx;border:1rpx solid currentColor;border-radius:2rpx}.file-symbol::before{content:"";position:absolute;top:-1rpx;right:-1rpx;width:9rpx;height:9rpx;border-left:1rpx solid currentColor;border-bottom:1rpx solid currentColor;background:#f5ede0}.file-symbol text{position:absolute;left:5rpx;right:5rpx;height:1rpx;background:currentColor}.file-symbol text:first-child{top:17rpx}.file-symbol text:last-child{top:23rpx}.profile-main{min-width:0;flex:1}.profile-title{color:#444b45;font-family:"Songti SC","STSong","SimSun",serif;font-size:27rpx;letter-spacing:2rpx}.profile-title text{margin-left:7rpx;color:#8b8d85;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:19rpx;letter-spacing:0}.progress{overflow:hidden;height:5rpx;margin:10rpx 0;background:#e5dfd4;border-radius:4rpx}.progress view{height:100%;border-radius:4rpx;background:linear-gradient(90deg,#a98b53,#555f58)}.profile-copy{overflow:hidden;color:#858982;font-size:19rpx;white-space:nowrap;text-overflow:ellipsis}.arrow{color:#9b927f;font-family:Georgia,"Times New Roman",serif;font-size:31rpx}

/* 个人服务与会员权益 */
.service-card,.panel{margin-bottom:19rpx;padding:27rpx!important;border:1rpx solid #ddd4c7!important;border-radius:7rpx!important;background:#fbf8f2!important;box-shadow:0 12rpx 32rpx rgba(58,54,45,.045)!important}.card-head,.panel-head{display:flex;align-items:center;justify-content:space-between}.service-heading{display:flex;align-items:center}.service-logo{display:flex;align-items:center;justify-content:center;width:53rpx;height:53rpx;margin-right:14rpx;border:1rpx solid #aa8b53;border-radius:50%;color:#987b47;font-family:Georgia,"Times New Roman",serif;font-size:19rpx}.section-kicker{color:#987c4b;font-family:Georgia,"Times New Roman",serif;font-size:13rpx;letter-spacing:3rpx}.section-title{margin-top:3rpx;color:#424a44!important;font-family:"Songti SC","STSong","SimSun",serif!important;font-size:30rpx;font-weight:400!important;letter-spacing:3rpx}.card-count,.panel-head>text{color:#85785f;font-size:19rpx}.trial-card{margin-top:20rpx;padding:23rpx;border-left:3rpx solid #a8894f;border-radius:2rpx!important;background:linear-gradient(145deg,#eee2ce,#f6efe3)!important}.trial-card.inactive{border-left-color:#a6a59e;background:linear-gradient(145deg,#eceae4,#f5f2eb)!important}.trial-top{display:flex;align-items:flex-start;justify-content:space-between}.trial-label{display:inline-block;padding:4rpx 10rpx;border-radius:2rpx;background:#956158;color:#fffaf1;font-size:17rpx;letter-spacing:1rpx}.trial-card.inactive .trial-label{background:#858982}.trial-title{margin-top:6rpx;color:#474c46;font-family:"Songti SC","STSong","SimSun",serif;font-size:27rpx;font-weight:400;letter-spacing:1rpx}.trial-number{margin-left:15rpx;color:#745e39;font-family:Georgia,"Times New Roman",serif;font-size:39rpx;line-height:1;white-space:nowrap}.trial-number text{margin-left:2rpx;font-size:17rpx}.trial-progress{overflow:hidden;height:5rpx;margin:17rpx 0;background:#d9cfbd;border-radius:4rpx}.trial-progress view{height:100%;border-radius:4rpx;background:#9a7d49}.trial-copy{color:#756e60;font-size:20rpx;line-height:1.65}.service-meta{display:flex;justify-content:space-between;gap:16rpx;margin-top:14rpx;color:#817968;font-size:18rpx}.service-meta .ready{color:#58675d}.service-meta .waiting{color:#9a6755}.trial-card button{margin:19rpx 0 0;border-radius:3rpx!important;background:#4b504b!important;color:#fff9ee!important;font-size:23rpx;letter-spacing:2rpx}

/* 账号与常用入口 */
.account-panel{margin-top:0}.panel-head{padding-bottom:13rpx;border-bottom:1rpx solid #e0d8cc}.menu-row{display:flex;align-items:center;min-height:94rpx;border-bottom:1rpx solid #e4ddd2}.menu-row:last-child{border:0}.menu-main{min-width:0;flex:1}.menu-main strong,.menu-main text{display:block}.menu-main strong{color:#4a504a;font-size:24rpx;font-weight:500}.menu-main text{overflow:hidden;margin-top:3rpx;color:#888c85;font-size:18rpx;white-space:nowrap;text-overflow:ellipsis}.phone-button{width:auto;margin:0 0 0 13rpx;padding:0 15rpx;border:1rpx solid #9c814e!important;border-radius:2rpx!important;background:transparent!important;color:#745f3c!important;font-size:19rpx;line-height:54rpx}.phone-note{padding:12rpx 0;color:#88764d;font-size:20rpx;line-height:1.6}.logout-button{margin:15rpx 0 0;border:1rpx solid #d3cabc!important;border-radius:3rpx!important;background:transparent!important;color:#757871!important;font-size:22rpx}
.menu-icon{position:relative;display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:55rpx;height:55rpx;margin-right:16rpx;flex:0 0 55rpx;border:1rpx solid #b09665;border-radius:50%;color:#8a7043}.bell-icon{position:relative;box-sizing:border-box;width:22rpx;height:25rpx;border:1rpx solid currentColor;border-radius:11rpx 11rpx 4rpx 4rpx}.bell-icon::before{content:"";position:absolute;top:-5rpx;left:8rpx;width:4rpx;height:5rpx;border:1rpx solid currentColor;border-bottom:0;border-radius:4rpx 4rpx 0 0}.bell-icon::after{content:"";position:absolute;left:8rpx;bottom:-5rpx;width:5rpx;height:5rpx;border-radius:50%;background:currentColor}.bell-icon text{display:none}
.color-menu-icon text{position:absolute;width:8rpx;height:8rpx;border-radius:50%}.menu-green{top:7rpx;left:23rpx;background:#53735f}.menu-black{top:18rpx;right:7rpx;background:#2e3532}.menu-gold{right:12rpx;bottom:7rpx;background:#b59750}.menu-white{left:12rpx;bottom:7rpx;border:1rpx solid #aeb4ae;background:#f5f2e9}.menu-red{top:18rpx;left:7rpx;background:#a05a50}
.menu-book{position:relative;display:flex;width:29rpx;height:22rpx}.menu-book text{box-sizing:border-box;width:15rpx;height:21rpx;border-bottom:1rpx solid currentColor}.menu-book text:first-child{border-left:1rpx solid currentColor;border-radius:0 0 0 7rpx;transform:skewY(10deg)}.menu-book text:last-child{border-right:1rpx solid currentColor;border-radius:0 0 7rpx 0;transform:skewY(-10deg)}.menu-book::after{content:"";position:absolute;top:2rpx;bottom:0;left:50%;width:1rpx;background:currentColor}.menu-spark{position:absolute;top:1rpx;right:3rpx;color:#a7884e;font-family:Georgia,"Times New Roman",serif;font-size:13rpx}
.pending-text{margin-right:6rpx;color:#987c4b;font-size:18rpx}.simple-menu .menu-row{min-height:80rpx}.dashboard-loading{padding:4rpx 0 17rpx;color:#858982;font-size:20rpx;text-align:center}.version{padding:12rpx 0 34rpx;color:#93958e;font-size:18rpx;letter-spacing:1rpx;text-align:center}
