page { background: #f7f5ef; color: #27322d; font-size: 30rpx; }
.page { padding: 32rpx; }
.card { margin-bottom: 24rpx; padding: 32rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 30rpx rgba(38, 50, 44, .06); }
.title { margin-bottom: 20rpx; font-size: 38rpx; font-weight: 600; }
.muted { color: #718078; font-size: 26rpx; }
.button { margin-top: 24rpx; background: #385f4d !important; color: #fff !important; }
input, textarea, picker { box-sizing: border-box; width: 100%; margin: 12rpx 0 24rpx; padding: 20rpx; border: 1rpx solid #dfe5e1; border-radius: 14rpx; background: #fff; }

/* 现代东方雅奢主题：宣纸米白、墨色、黛青、少量哑金。 */
page{background:#F4EFE5;color:#242923;font-size:30rpx;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;line-height:1.65}
.page{padding:32rpx}
.card,.ranking-card,.result-card,.question-group,.profile-line,.action-card{border:1rpx solid #E1DACE!important;background:#FBFAF6!important;border-radius:16rpx!important;box-shadow:0 14rpx 42rpx rgba(41,45,38,.055)!important}
.title,.hero-title,.section-title,.result-title{color:#193C33;font-family:"Songti SC","STSong",serif!important;letter-spacing:3rpx}
.muted{color:#77776F;font-size:26rpx}
button::after{border:0}
.button,.result-button,.composer button,.buy-button{background:#183F35!important;color:#F8F3E8!important;border-radius:8rpx!important}
input,textarea,picker{padding:22rpx;border-color:#DCD5C8;border-radius:10rpx;background:#FBFAF6;color:#252A25;font-size:29rpx}
.home-page,.ai-page{background:radial-gradient(circle at 100% 0,rgba(176,145,78,.09),transparent 34%)}
.share-button,.rule-button{border:1rpx solid #C8B78E!important;background:transparent!important;color:#655735!important;border-radius:8rpx!important}
.intro{border-left-color:#A88B4A!important;background:#EFE9DC!important;color:#5C594F!important;border-radius:2rpx 10rpx 10rpx 2rpx!important}
.rule-tag{border:1rpx solid #D5C49A!important;background:#F7F1E4!important;color:#7C6737!important;border-radius:6rpx!important}
.personal-card,.ai-hero,.user-hero,.guest-hero,.profilehero{border:1rpx solid #31594D!important;background:linear-gradient(145deg,#12382F,#285247)!important;border-radius:16rpx!important;box-shadow:0 18rpx 48rpx rgba(20,55,46,.18)!important}
.primary-button{background:#D7C394!important;color:#263B34!important;border-radius:8rpx!important}
.question-button{background:#F1EDE4!important;color:#39463F!important;border-radius:8rpx!important}
.message.assistant{border:1rpx solid #E1DACE;background:#FBFAF6}.message.user{background:#DDE8E1}

/* 全局基底保持克制，具体画卷效果由各页面自行绘制。 */
page{background:#f4efe5;color:#28312c;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}
button{font-family:inherit}
