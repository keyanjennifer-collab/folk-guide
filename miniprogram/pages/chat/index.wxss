/* 真实RAG问答状态卡：替代原来的个人五色演示结果。 */
.knowledge-card{position:relative;overflow:hidden;margin-top:20rpx;padding:34rpx 30rpx;border:1rpx solid #dcd3c3;background:linear-gradient(145deg,#fbfaf5,#f2ecdf);box-shadow:0 15rpx 40rpx rgba(50,52,45,.06)}
.knowledge-mark{position:absolute;right:24rpx;top:24rpx;display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx;border:1rpx solid #a68851;color:#8c7244;font-family:"Songti SC",serif;font-size:27rpx}
.knowledge-title{margin:8rpx 80rpx 12rpx 0;color:#243f35;font-family:"Songti SC",serif;font-size:39rpx;letter-spacing:3rpx}
.knowledge-copy{max-width:610rpx;color:#646b65;font-size:24rpx;line-height:1.8}
.status-list{margin-top:25rpx;border-top:1rpx solid #ddd5c7}
.status-row{display:flex;align-items:center;justify-content:space-between;padding:18rpx 0;border-bottom:1rpx solid #e3ddd2;font-size:22rpx}
.status-row>text:first-child{color:#6d756f}.status-row>text:last-child{max-width:460rpx;text-align:right}
.status-row.ready>text:last-child{color:#345f4b}.status-row.waiting>text:last-child{color:#9b644f}
.loading-copy{padding-top:17rpx;color:#858b85;font-size:21rpx;text-align:center}
.section-rule{flex:1;height:1rpx;margin-left:22rpx;background:linear-gradient(90deg,#b49c6a,transparent)}
.question-button[disabled],.composer button[disabled]{opacity:.55}
.personal-color-card{margin-top:22rpx}.personal-status{margin-top:16rpx;color:#718077;font-size:23rpx;line-height:1.7}.personal-meta{display:flex;justify-content:space-between;margin-top:20rpx;color:#7b8b82;font-size:21rpx}.personal-ranking{margin:18rpx 0}.personal-color-row{display:grid;grid-template-columns:42rpx 1fr 70rpx 130rpx;align-items:center;padding:16rpx 8rpx;border-bottom:1rpx solid #e8ece9;color:#6f7c75;font-size:22rpx}.personal-color-row strong{color:#31473c;font-size:26rpx}.personal-rank{color:#a58b55;font-family:serif;font-size:25rpx}.personal-note{margin-top:18rpx;color:#7a8880;font-size:21rpx;line-height:1.7}

