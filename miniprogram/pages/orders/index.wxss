.orders-page{padding:26rpx 34rpx}.screen-title{font-size:48rpx;margin-top:10rpx}.order-logo{width:84rpx;height:74rpx}.order-tabs{display:flex;white-space:nowrap;margin:20rpx 0 0;border-bottom:1rpx solid #3c3428}.order-tabs button{display:inline-block;flex:none;padding:18rpx 24rpx;background:transparent;border-radius:0;color:#8d806a;font-size:24rpx;line-height:1.6;border-bottom:3rpx solid transparent}.order-tabs button.active{color:#e1b97f;border-bottom-color:#c99c5f}.orders-page .empty-state{padding-top:110rpx}.order-card{padding:24rpx;margin:24rpx 0 0;background:#191a16;border:1rpx solid #3c3428;border-radius:4rpx;color:#e7cfab;text-align:left;line-height:1.7}.order-top{display:flex;justify-content:space-between;padding-bottom:18rpx;border-bottom:1rpx solid #3c3428;font-size:22rpx;color:#887d68}.order-top>text:last-child{color:#c99c5f}.order-product{display:flex;align-items:center;padding:22rpx 0}.order-product image{width:100rpx;height:128rpx;margin-right:24rpx;flex:none}.order-product>view>view{font-family:serif;font-size:29rpx}.order-product>view>text{font-size:23rpx;color:#918169}.order-total{display:flex;justify-content:space-between;border-top:1rpx solid #3c3428;padding-top:18rpx;font-size:25rpx}.order-total>text:last-child{color:#a0885e;font-size:22rpx}.detail-status{color:#c99c5f;font-family:serif;font-size:36rpx;margin-bottom:16rpx}.order-detail-row{display:flex;align-items:center;justify-content:space-between;padding:18rpx 0;border-bottom:1rpx solid #3c3428;gap:20rpx;font-size:24rpx}.order-detail-row>text:first-child{color:#897960}.order-detail-row button{overflow-wrap:anywhere;font-size:23rpx}.order-tip{font-size:22rpx;margin-top:24rpx}.sheet .outline-button{margin-top:24rpx}
