<view class="ai-page">
  <view class="ai-heading"><image src="/assets/brand/logo.png" mode="aspectFit"/><button bindtap="showRules">服务说明</button></view>
  <view class="ai-intro"><view class="eyebrow">AI 国学 · 与古今对话</view><view class="ai-title">问典籍，也问生活</view><view class="ai-subtitle">从一问开始，读懂时序里的日常。</view></view>
  <view class="service-strip">
    <view><view class="service-title">{{serviceTitle}}</view><view class="service-copy">{{serviceCopy}}</view></view>
    <button wx:if="{{!isLoggedIn}}" class="login-link" bindtap="toLogin">去登录 ›</button>
    <text wx:else class="quota-number">{{remainingQuestions}}<text> / {{dailyLimit}} 次</text></text>
  </view>
  <view class="personal-panel" wx:if="{{isLoggedIn}}">
    <button class="personal-toggle" bindtap="togglePersonal"><view><view>我的今日五色</view><text>{{personalState === 'ready' ? personalDate + ' · ' + personalPrecision : personalStatusCopy}}</text></view><text>{{personalOpen ? '−' : '＋'}}</text></button>
    <view wx:if="{{personalOpen}}" class="personal-content">
      <block wx:if="{{personalState === 'ready'}}">
        <view class="personal-summary">{{personalFocus}}</view>
        <view class="personal-copy">{{personalCombinationAdvice}}</view>
        <view wx:for="{{personalColors}}" wx:key="rank" class="personal-color">
          <button class="personal-color-row" data-rank="{{item.rank}}" bindtap="togglePersonalColor"><text>{{item.rank}}</text><text class="personal-dot {{item.tone}}"/><text>{{item.name}}</text><text>{{item.tendency}}</text><text>{{expandedPersonalRank === item.rank ? '−' : '＋'}}</text></button>
          <view wx:if="{{expandedPersonalRank === item.rank}}" class="personal-detail"><view>{{item.reason}}</view><view class="personal-label">适合处理</view><view wx:for="{{item.suitable}}" wx:for-item="advice" wx:key="*this">· {{advice}}</view><view class="personal-label">留意之处</view><view>{{item.resistance}}</view><view class="personal-label">行动与穿搭</view><view>{{item.advice}}</view><button class="incense-link" bindtap="toIncense">{{item.incense}} · {{item.scent}} ›</button></view>
        </view>
        <view class="personal-copy">{{personalComparisonNote}}</view>
        <button class="profile-button" bindtap="toProfile">查看或修改本人档案</button>
      </block>
      <block wx:else><view class="personal-copy">{{personalStatusCopy}}</view><button wx:if="{{personalState === 'missing'}}" class="profile-button" bindtap="toProfile">完善本人档案</button><button wx:if="{{personalState === 'error'}}" class="profile-button" bindtap="loadPersonalDaily">重新读取</button></block>
    </view>
  </view>
  <view class="suggestion-title">从你感兴趣的开始</view>
  <view class="question-tabs"><button wx:for="{{questions}}" wx:key="group" class="{{index === activeGroup ? 'active' : ''}}" data-index="{{index}}" bindtap="chooseGroup">{{item.group}}</button></view>
  <view class="suggestions"><button wx:for="{{questions[activeGroup].items}}" wx:key="*this" data-question="{{item}}" bindtap="chooseQuestion" disabled="{{sending}}"><text>{{item}}</text><text>↗</text></button></view>
  <view class="conversation-heading"><text>对话</text><view/></view>
  <view class="messages">
    <view wx:for="{{messages}}" wx:key="index" class="message {{item.role}}">
      <view class="message-role">{{item.role === 'user' ? '你' : 'AI 国学 · AI生成'}}</view>
      <text class="message-text" selectable>{{item.text}}</text>
      <view wx:if="{{item.safetyStatus === 'output_filtered'}}" class="safety-note">回答已按服务规则处理。</view>
      <view wx:if="{{item.safetyStatus === 'output_truncated'}}" class="safety-note">回答较长，已截取至服务长度上限。</view>
      <view wx:if="{{item.references.length}}" class="references"><text>参考资料</text><view wx:for="{{item.references}}" wx:for-item="reference" wx:key="*this">{{reference}}</view></view>
      <view wx:if="{{item.messageId}}" class="feedback-row"><button class="{{item.feedback === 'helpful' ? 'chosen' : ''}}" data-index="{{index}}" data-message-id="{{item.messageId}}" data-value="helpful" bindtap="feedback">有帮助</button><button class="{{item.feedback === 'unhelpful' ? 'chosen' : ''}}" data-index="{{index}}" data-message-id="{{item.messageId}}" data-value="unhelpful" bindtap="feedback">需要纠正</button></view>
    </view>
    <view wx:if="{{sending}}" class="thinking">正在整理思路…</view>
  </view>
  <view id="conversationEnd"/>
  <view class="composer-wrap"><view class="composer"><textarea value="{{question}}" bindinput="setQuestion" focus="{{inputFocus}}" auto-height maxlength="500" disabled="{{sending}}" placeholder="写下你的问题…" placeholder-style="color:#8e846f" cursor-spacing="20"/><button bindtap="send" loading="{{sending}}" disabled="{{sending || !question}}" aria-label="发送问题">发送</button></view><view class="ai-disclaimer">AI生成 · 仅供传统文化学习与生活参考</view></view>
</view>
