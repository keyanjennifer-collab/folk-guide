page { background: var(--canvas); color: var(--text); }
.product-page { min-height: 100vh; padding-bottom: 140rpx; background: var(--canvas); }
.product-gallery { height: 750rpx; background: #303631; }
.product-gallery image { width: 100%; height: 100%; }
.product-body { padding: 38rpx; color: var(--text); background-color: #2d332e; background-image: linear-gradient(rgba(43, 49, 44, .9), rgba(28, 33, 29, .96)), url('/assets/brand/stone-texture.jpg'); background-size: auto, 720rpx; }
.detail-heading { display: flex; align-items: center; justify-content: space-between; }
.detail-heading .eyebrow { color: var(--copper); }
.product-title { margin: 7rpx 0; color: var(--cream); font-family: "Songti SC", serif; font-size: 46rpx; line-height: 1.5; letter-spacing: 4rpx; }
.product-mood { color: var(--muted); font-size: 26rpx; letter-spacing: 3rpx; }
.product-emblem { width: 86rpx; height: 94rpx; flex: none; margin-left: 20rpx; }
.price-row { display: flex; align-items: center; gap: 20rpx; padding: 28rpx 0; border-bottom: 1rpx solid var(--line); }
.price { color: #e3bc84; font-family: Georgia, serif; font-size: 46rpx; }
.price-row>text:last-child { color: var(--muted); font-size: 22rpx; }
.quantity-row { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 0; font-size: 27rpx; }
.quantity-row>view { display: flex; align-items: center; gap: 30rpx; }
.quantity-row button { width: 56rpx; height: 56rpx; padding: 0; color: #e0bd88; background: #444c45; border-radius: 3rpx; line-height: 56rpx; }
.detail-section { padding: 30rpx 0; border-top: 1rpx solid var(--line); }
.detail-label { margin-bottom: 18rpx; color: var(--cream); font-family: "Songti SC", serif; font-size: 31rpx; letter-spacing: 3rpx; }
.story { color: #c7bfb3; font-size: 28rpx; line-height: 1.95; }
.notes { margin-top: 18rpx; color: #d0a773; font-size: 24rpx; }
.care-row { margin-bottom: 12rpx; color: #b8b2a7; font-size: 25rpx; line-height: 1.85; }
.purchase-note { padding-top: 22rpx; color: #aaa99f; border-top: 1rpx solid var(--line); font-size: 22rpx; }
.product-actions { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; display: flex; gap: 20rpx; padding: 22rpx 30rpx calc(22rpx + env(safe-area-inset-bottom)); background: rgba(35, 41, 36, .98); border-top: 1rpx solid var(--line); }
.product-actions button { border-radius: 4rpx; font-size: 27rpx; line-height: 78rpx; }
.back-shop { padding: 0 20rpx; color: #dfb67c; background: transparent; border: 1rpx solid #967144; }
.add-bag { flex: 1; padding: 0 14rpx; color: #fffaf2; background: var(--copper-deep); }
