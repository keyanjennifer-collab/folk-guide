/*
 * 财库香：暖香纸、墨灰、哑金与低饱和五色。
 * 商品图片未就绪前使用抽象香盒剪影，不冒充真实商品摄影。
 */
.shop-page{min-height:100vh;padding-bottom:132rpx;background:linear-gradient(180deg,#eee6da,#f6f1e8 590rpx,#f2ece2);color:#393e39;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}
.shop-page button::after{border:0}

/* 品牌首屏 */
.shop-hero{position:relative;overflow:hidden;min-height:360rpx;padding:48rpx 38rpx 42rpx!important;border:0!important;border-bottom:1rpx solid #d1bd98!important;border-radius:0!important;background:linear-gradient(145deg,#f5eee2,#dfd0b9)!important;color:#393f3a!important;box-shadow:0 16rpx 42rpx rgba(74,61,41,.08)!important}
.hero-window{position:absolute;right:-52rpx;top:-96rpx;width:310rpx;height:310rpx;border:1rpx solid rgba(150,119,64,.2);border-radius:50%;box-shadow:inset 0 0 0 35rpx rgba(255,253,247,.12)}
.incense-smoke{position:absolute;right:104rpx;bottom:-136rpx;width:88rpx;height:430rpx;border:3rpx solid transparent;border-left-color:rgba(143,112,62,.18);border-radius:50%;transform:rotate(12deg)}.smoke-two{right:45rpx;bottom:-190rpx;height:500rpx;border-left-color:rgba(143,112,62,.1);transform:rotate(-6deg) scaleX(.76)}
.hero-brand-row,.hero-copy,.hero-points{position:relative;z-index:2}.hero-brand-row{display:flex;align-items:center}
.incense-brand-logo{position:relative;box-sizing:border-box;width:78rpx;height:78rpx;margin-right:21rpx;flex:0 0 78rpx;border:1rpx solid #a88952;border-radius:50%;background:rgba(255,253,248,.35)}
.logo-stick{position:absolute;left:38rpx;bottom:18rpx;width:2rpx;height:28rpx;background:#876d40}.logo-base{position:absolute;left:24rpx;bottom:15rpx;width:30rpx;height:6rpx;border-bottom:1rpx solid #876d40;border-radius:50%}.logo-smoke{position:absolute;width:13rpx;height:24rpx;border-left:1rpx solid #a1834e;border-radius:50%}.logo-smoke-left{top:11rpx;left:30rpx;transform:rotate(14deg)}.logo-smoke-right{top:7rpx;left:41rpx;height:29rpx;opacity:.65;transform:rotate(-12deg)}
.hero-kicker,.section-kicker{color:#987b48;font-family:Georgia,"Times New Roman",serif;font-size:14rpx;letter-spacing:4rpx}.hero-title{margin-top:3rpx;color:#3e4942!important;font-family:"Songti SC","STSong","SimSun",serif!important;font-size:54rpx;font-weight:400!important;line-height:1.25;letter-spacing:9rpx!important}
.hero-copy{max-width:565rpx;margin:24rpx 0 23rpx;color:#656960;font-family:"Songti SC","STSong","SimSun",serif;font-size:23rpx;line-height:1.85;letter-spacing:1rpx}.hero-points{display:flex;flex-wrap:wrap;gap:9rpx}.hero-points text{padding:6rpx 13rpx;border:1rpx solid rgba(155,128,79,.38);border-radius:24rpx;background:rgba(255,253,248,.36);color:#776441;font-size:18rpx}

/* 旗舰组合 */
.flagship-card{overflow:hidden;margin:20rpx 24rpx 38rpx!important;border:1rpx solid #ddd2c0!important;border-radius:8rpx!important;background:#fdfaf4!important;box-shadow:0 17rpx 42rpx rgba(64,57,45,.07)!important}
.flagship-visual{position:relative;overflow:hidden;height:332rpx;background:linear-gradient(145deg,#e1d5c0,#f4ecdd)!important}.sun-disc{position:absolute;right:54rpx;top:38rpx;width:128rpx;height:128rpx;border:1rpx solid rgba(158,122,60,.22);border-radius:50%;background:rgba(184,146,78,.15)}.silk-mountain{position:absolute;left:-82rpx;bottom:-218rpx;width:590rpx;height:398rpx;border-radius:45% 55% 0 0;background:rgba(103,105,91,.11);transform:rotate(11deg)}
.incense-tubes{position:absolute;z-index:2;right:48rpx;bottom:28rpx;display:flex;gap:8rpx}.tube{position:relative;display:block;box-sizing:border-box;width:48rpx;height:202rpx;border:1rpx solid rgba(70,65,50,.15);border-radius:3rpx;box-shadow:5rpx 8rpx 15rpx rgba(58,51,38,.16)}.tube::before{content:"";position:absolute;left:8rpx;right:8rpx;top:33rpx;height:1rpx;background:rgba(230,207,155,.72);box-shadow:0 7rpx 0 rgba(230,207,155,.42)}.tube::after{content:"";position:absolute;left:50%;bottom:19rpx;width:9rpx;height:9rpx;border:1rpx solid rgba(235,216,174,.72);border-radius:50%;transform:translateX(-50%)}
.tube.black,.tone-black{background:#2e3532}.tube.gold,.tone-gold{background:#b59750}.tube.green,.tone-green{background:#53735f}.tube.red,.tone-red{background:#a05a50}.tube.white,.tone-white{box-sizing:border-box;border:1rpx solid #b9bdb7;background:#f3f0e8}.tone-flagship{background:linear-gradient(135deg,#2e3532 0 20%,#b59750 20% 40%,#53735f 40% 60%,#a05a50 60% 80%,#f3f0e8 80%)}
.flagship-label{position:absolute;z-index:2;top:55rpx;left:33rpx;color:#655737;font-family:"Songti SC","STSong","SimSun",serif;font-size:32rpx;letter-spacing:4rpx}.flagship-label text,.flagship-label small{display:block}.flagship-label small{margin-top:11rpx;color:#887d68;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:18rpx;letter-spacing:1rpx}
.flagship-info{padding:31rpx!important}.product-badge{display:inline-block;padding:5rpx 12rpx;border-radius:2rpx!important;background:#956158!important;color:#fffaf0;font-size:18rpx;letter-spacing:1rpx}.flagship-title{margin-top:10rpx;color:#414943;font-family:"Songti SC","STSong","SimSun",serif;font-size:39rpx;font-weight:400;letter-spacing:3rpx}.flagship-spec,.sheet-spec{margin-top:3rpx;color:#85877f;font-size:22rpx}.flagship-copy{margin:14rpx 0;color:#62675f;font-size:23rpx;line-height:1.7}
.rights-box{display:flex;align-items:center;padding:19rpx;border-left:3rpx solid #a88a50;border-radius:2rpx!important;background:#eee3d1!important}.rights-icon{display:flex;align-items:center;justify-content:center;width:66rpx;height:66rpx;margin-right:17rpx;border:1rpx solid #9c804a;border-radius:50%;background:transparent!important;color:#765f38!important;font-family:Georgia,"Times New Roman",serif;font-size:26rpx}.rights-box strong,.rights-box text{display:block}.rights-box strong{color:#484c46;font-size:23rpx;font-weight:500}.rights-box text{margin-top:2rpx;color:#7c7568;font-size:19rpx;line-height:1.55}
.price-line{display:flex;align-items:center;justify-content:space-between;margin-top:24rpx}.currency{font-family:Georgia,"Times New Roman",serif;font-size:21rpx}.price{font-family:Georgia,"Times New Roman",serif;font-size:44rpx}.shipping{margin-left:9rpx;color:#878981;font-size:19rpx}.buy-button{width:210rpx;margin:0;border-radius:3rpx!important;background:#4b504b!important;color:#fff9ee!important;font-size:24rpx;letter-spacing:2rpx}

/* 单色补充装 */
.section-head{display:flex;align-items:flex-end;justify-content:space-between;padding:0 28rpx 15rpx}.collection-heading{display:flex;align-items:center}.collection-logo{position:relative;width:58rpx;height:58rpx;margin-right:17rpx;border:1rpx solid #aa8d58;border-radius:50%}.collection-logo text{position:absolute;width:9rpx;height:9rpx;border-radius:50%}.mini-green{top:7rpx;left:24rpx;background:#53735f}.mini-black{top:19rpx;right:7rpx;background:#2e3532}.mini-gold{right:13rpx;bottom:7rpx;background:#b59750}.mini-white{left:13rpx;bottom:7rpx;border:1rpx solid #adb3ad;background:#f5f2e9}.mini-red{top:19rpx;left:7rpx;background:#a05a50}
.section-kicker{font-size:13rpx}.section-title{margin-top:4rpx;color:#414943!important;font-family:"Songti SC","STSong","SimSun",serif!important;font-size:34rpx;font-weight:400!important;letter-spacing:3rpx}.section-note{color:#85877f;font-size:20rpx}.notice{margin:0 24rpx 19rpx;padding:18rpx 20rpx;border-left:3rpx solid #aa8b50;border-radius:2rpx!important;background:#eee4d4!important;color:#74684f;font-size:20rpx;line-height:1.65}
.product-grid{display:grid;grid-template-columns:1fr 1fr;gap:15rpx;padding:0 24rpx}.product-card{overflow:hidden;border:1rpx solid #ddd4c7!important;border-radius:6rpx!important;background:#fcf9f3!important;box-shadow:none!important}.product-visual{position:relative;height:236rpx}.tone-bg-black{background:#e2e4e1}.tone-bg-gold{background:#eee5d1}.tone-bg-green{background:#e0e7df}.tone-bg-red{background:#eee0dc}.tone-bg-white{background:#e9e9e4}.product-visual::after{content:"";position:absolute;left:27%;right:27%;bottom:19rpx;height:8rpx;border-radius:50%;background:rgba(59,59,51,.1);filter:blur(6rpx)}
.single-tube{position:absolute;z-index:2;left:50%;bottom:27rpx;box-sizing:border-box;width:58rpx;height:164rpx;border:1rpx solid rgba(65,61,49,.15);border-radius:3rpx;box-shadow:5rpx 8rpx 14rpx rgba(54,49,39,.15);transform:translateX(-50%)}.single-tube::before{content:"";position:absolute;left:9rpx;right:9rpx;top:27rpx;height:1rpx;background:rgba(235,216,174,.72);box-shadow:0 7rpx 0 rgba(235,216,174,.4)}.single-tube::after{content:"";position:absolute;left:50%;bottom:16rpx;width:9rpx;height:9rpx;border:1rpx solid rgba(235,216,174,.7);border-radius:50%;transform:translateX(-50%)}
.element-mark{position:absolute;top:17rpx;left:19rpx;color:rgba(78,77,66,.38);font-family:"STKaiti","Songti SC","STSong",serif;font-size:47rpx}.product-info{padding:19rpx}.product-name{color:#434a44;font-family:"Songti SC","STSong","SimSun",serif;font-size:27rpx;font-weight:400;letter-spacing:2rpx}.product-name text{color:#8b8d85;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:19rpx;letter-spacing:0}.product-scent{overflow:hidden;height:68rpx;margin:8rpx 0;color:#70756e;font-size:19rpx;line-height:1.65}.product-bottom{display:flex;align-items:center;justify-content:space-between}.single-price{font-family:Georgia,"Times New Roman",serif;font-size:31rpx}.plus{width:52rpx;height:52rpx;margin:0;padding:0;border:1rpx solid #8e7650!important;border-radius:50%!important;background:transparent!important;color:#705d3d!important;font-size:28rpx;line-height:50rpx}

/* 权益与安全说明 */
.service-card{margin:33rpx 24rpx 19rpx;padding:28rpx;border:1rpx solid #ddd4c7!important;border-radius:7rpx!important;background:#fbf8f2!important;box-shadow:none!important}.service-card>.section-title{padding-bottom:15rpx;border-bottom:1rpx solid #ded6ca}.service-row{display:flex;align-items:flex-start;padding:19rpx 0;border-bottom:1rpx solid #e4ddd2}.service-row:last-child{border:0}.service-row>text{margin-right:17rpx;color:#9d8049;font-family:Georgia,"Times New Roman",serif;font-size:21rpx}.service-row strong,.service-row small{display:block}.service-row strong{color:#4d524c;font-size:23rpx;font-weight:500}.service-row small{margin-top:3rpx;color:#858780;font-size:19rpx;line-height:1.55}.safety-note{padding:10rpx 38rpx 30rpx;color:#8c8e87;font-size:19rpx;line-height:1.65;text-align:center}

/* 购物车入口与底部弹层 */
.cart-float{position:fixed;right:27rpx;bottom:139rpx;z-index:5;display:flex;align-items:center;padding:17rpx 24rpx;border:1rpx solid rgba(212,190,147,.55);border-radius:32rpx;background:#4b504b;color:#fff9ee;box-shadow:0 10rpx 25rpx rgba(43,43,37,.24);font-size:21rpx;letter-spacing:1rpx}.cart-icon{position:relative;box-sizing:border-box;width:28rpx;height:25rpx;margin-right:10rpx;border:1rpx solid #e3d2ae;border-radius:2rpx}.cart-icon::before{content:"";position:absolute;left:6rpx;right:6rpx;top:-8rpx;height:10rpx;border:1rpx solid #e3d2ae;border-bottom:0;border-radius:8rpx 8rpx 0 0}.cart-icon text{display:none}.cart-count{position:absolute;top:-10rpx;right:-5rpx;display:flex;align-items:center;justify-content:center;min-width:34rpx;height:34rpx;padding:0 5rpx;border-radius:18rpx;background:#9e5a50;color:#fff;font-size:18rpx}
.overlay{position:fixed;inset:0;z-index:10;display:flex;align-items:flex-end;background:rgba(25,24,21,.46);backdrop-filter:blur(3rpx)}.product-sheet,.cart-sheet{overflow:auto;width:100%;max-height:88vh;border-radius:22rpx 22rpx 0 0;background:#f4eee4}.sheet-handle{width:76rpx;height:7rpx;margin:14rpx auto;border-radius:6rpx;background:#c7bca9}.sheet-visual{position:relative;height:292rpx}.single-tube.large{height:215rpx}.large-mark{font-size:58rpx}.sheet-content{padding:27rpx}.sheet-title{color:#414943;font-family:"Songti SC","STSong","SimSun",serif;font-size:38rpx;letter-spacing:3rpx}.sheet-section{margin-top:19rpx;padding-top:15rpx;border-top:1rpx solid #ded6ca;color:#555b55;font-size:22rpx;line-height:1.7}.sheet-section>text{display:block;margin-bottom:4rpx;color:#947b4d;font-size:18rpx;letter-spacing:1rpx}.sheet-price{display:flex;align-items:center;justify-content:space-between;margin-top:27rpx}.sheet-price button,.checkout button{width:250rpx;margin:0;border-radius:3rpx!important;background:#4b504b!important;color:#fff9ee!important;font-size:23rpx}
.cart-title{padding:15rpx 27rpx;color:#414943;font-family:"Songti SC","STSong","SimSun",serif;font-size:35rpx;letter-spacing:3rpx}.cart-title text{color:#898b84;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:20rpx;letter-spacing:0}.empty-cart{padding:78rpx 30rpx;color:#7f847e;text-align:center}.cart-item{display:flex;align-items:center;margin:0 23rpx;padding:21rpx 0;border-bottom:1rpx solid #ddd6ca}.mini-swatch{box-sizing:border-box;width:30rpx;height:30rpx;margin-right:17rpx;border:1rpx solid rgba(59,62,56,.14);border-radius:50%}.cart-main{flex:1}.cart-main strong,.cart-main text{display:block}.cart-main strong{color:#474d47;font-size:23rpx;font-weight:500}.cart-main text{color:#83867f;font-size:19rpx}.quantity{display:flex;align-items:center}.quantity button{width:48rpx;height:48rpx;margin:0;padding:0;border:1rpx solid #d4cbbb!important;border-radius:50%;background:transparent!important;color:#735f3e!important;line-height:46rpx}.quantity text{width:48rpx;text-align:center}.checkout{display:flex;align-items:center;justify-content:space-between;padding:25rpx;background:#fcfaf5}.checkout text,.checkout strong{display:block}.checkout text{color:#888a83;font-size:18rpx}.checkout strong{color:#454b45;font-family:Georgia,"Times New Roman",serif;font-size:32rpx}
