page{background:#151613;color:#dbc89d}.product-page{padding-bottom:140rpx}.product-gallery{height:750rpx;background:#11120f}.product-gallery image{width:100%;height:100%}.product-body{padding:36rpx 38rpx}.detail-heading{display:flex;justify-content:space-between;align-items:center}.eyebrow{color:#a99468}.product-title{font-family:"Songti SC",serif;font-size:44rpx;letter-spacing:4rpx;line-height:1.5;margin:8rpx 0}.product-mood{color:#b5ab94;font-size:25rpx;letter-spacing:3rpx}.product-emblem{width:82rpx;height:92rpx;margin-left:20rpx;flex:none}.price-row{display:flex;align-items:center;gap:20rpx;padding:28rpx 0;border-bottom:1rpx solid #3f3d30}.price{font-family:Georgia,serif;font-size:44rpx}.price-row>text:last-child{font-size:22rpx;color:#a6987b}.quantity-row{display:flex;align-items:center;justify-content:space-between;padding:24rpx 0;font-size:26rpx}.quantity-row>view{display:flex;align-items:center;gap:30rpx}.quantity-row button{width:56rpx;height:56rpx;padding:0;line-height:56rpx;background:#2e3027;color:#d7c393;border-radius:2rpx}.detail-section{border-top:1rpx solid #3f3d30;padding:30rpx 0}.detail-label{font-family:"Songti SC",serif;font-size:30rpx;letter-spacing:3rpx;margin-bottom:20rpx}.story{font-size:27rpx;color:#c0b6a0;line-height:1.95}.notes{margin-top:18rpx;font-size:23rpx;color:#978768}.care-row{font-size:24rpx;color:#a69d89;margin-bottom:12rpx;line-height:1.85}.purchase-note{font-size:22rpx;color:#9a907b;border-top:1rpx solid #3f3d30;padding-top:22rpx}.product-actions{position:fixed;left:0;right:0;bottom:0;display:flex;gap:20rpx;padding:22rpx 30rpx calc(22rpx + env(safe-area-inset-bottom));background:#191a16;border-top:1rpx solid #3f3d30;z-index:10}.product-actions button{font-size:26rpx;border-radius:3rpx;line-height:78rpx}.back-shop{padding:0 20rpx;background:transparent;color:#bbaa84;border:1rpx solid #766746}.add-bag{flex:1;background:#c5ac77;color:#22271f;padding:0 14rpx}
