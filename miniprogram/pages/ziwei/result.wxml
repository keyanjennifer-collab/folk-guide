<view class="ziwei-page {{themeClass}}">
  <view class="result-hero"><view class="eyebrow">ZIWEI · CHART ANALYSIS</view><view class="title">{{chartResult ? chartResult.label : '命盘分析'}}</view><view class="subtitle">点击时期、宫位和主题，查看对应的命盘分析。</view></view>
  <view wx:if="{{loading}}" class="loading">正在读取命盘…</view>
  <view wx:elif="{{chartResult}}" class="card result">
    <view class="result-actions"><button class="danger-action" bindtap="deleteChart">删除这份命盘</button></view>
    <view class="summary"><view><text>输入历法</text><view>{{chartResult.calendar_type === 'lunar' ? '农历' : '公历'}} {{chartResult.birth_date}}</view></view><view><text>实际公历</text><view>{{chartResult.chart.inputCalendar.solarDate || chartResult.birth_date}}</view></view><view><text>农历</text><view>{{chartResult.chart.lunarInfo.lunarText}}</view></view><view><text>四柱干支</text><view>{{chartResult.chart.lunarInfo.yearGanZhi}} {{chartResult.chart.lunarInfo.monthGanZhi}} {{chartResult.chart.lunarInfo.dayGanZhi}} {{chartResult.chart.lunarInfo.timeGanZhi}}</view></view><view><text>命宫 / 身宫</text><view>{{chartResult.chart.mingGongBranch}}宫 / {{chartResult.chart.shenGongBranch}}宫 · {{chartResult.chart.wuxingJuName}}</view></view></view>
    <view class="palace-title">十二宫主星 · 点击查看分析</view><view class="palace-grid"><view wx:for="{{chartResult.chart.palaces}}" wx:key="branch" class="palace {{item.isMingGong ? 'ming' : ''}} {{selectedPalaceBranch === item.branch ? 'selected' : ''}}" data-branch="{{item.branch}}" bindtap="selectPalace"><text>{{item.name}}</text><view><text wx:for="{{item.stars}}" wx:for-item="star" wx:key="name" wx:if="{{star.type === 'major'}}" class="star">{{star.name}}{{star.siHua ? '化' + star.siHua : ''}}</text></view><text wx:if="{{item.daXianAge}}" class="age">{{item.daXianAge[0]}}–{{item.daXianAge[1]}}岁</text></view></view>
    <view class="section-label">查看不同时期</view><scroll-view scroll-x="true" class="period-scroll"><view class="period-tabs"><button class="period-tab {{periodMode === 'mingpan' ? 'active' : ''}}" data-period="mingpan" bindtap="selectPeriod">本命</button><button wx:for="{{chartResult.chart.daXians}}" wx:key="startAge" class="period-tab {{periodMode === index ? 'active' : ''}}" data-period="{{index}}" bindtap="selectPeriod">大限 {{item.startAge}}–{{item.endAge}}</button><button class="period-tab {{periodMode === 'liunian' ? 'active' : ''}}" data-period="liunian" bindtap="selectPeriod">流年</button><button class="period-tab {{periodMode === 'xiaoxian' ? 'active' : ''}}" data-period="xiaoxian" bindtap="selectPeriod">小限</button><button class="period-tab {{periodMode === 'liuyue' ? 'active' : ''}}" data-period="liuyue" bindtap="selectPeriod">流月</button><button class="period-tab {{periodMode === 'liuri' ? 'active' : ''}}" data-period="liuri" bindtap="selectPeriod">流日</button><button class="period-tab {{periodMode === 'liushi' ? 'active' : ''}}" data-period="liushi" bindtap="selectPeriod">流时</button></view></scroll-view>
    <view class="analysis-nav-title">命盘分析</view><scroll-view scroll-x="true" class="analysis-scroll"><view class="analysis-tabs"><button wx:for="{{analysisTabs}}" wx:key="key" class="analysis-tab {{activeAnalysis === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="selectAnalysis">{{item.label}}</button></view></scroll-view>
    <view wx:if="{{analysisLoading}}" class="remote-loading">正在结合命盘资料生成详细解读…</view><view wx:if="{{analysisText}}" class="remote-analysis"><view class="remote-title">AI 命盘详细解读</view><text class="remote-copy">{{analysisText}}</text></view>
    <view wx:if="{{analysis}}" class="analysis-panel"><view class="analysis-heading"><view><text class="analysis-kicker">{{analysis.period}}</text><view class="analysis-title">{{analysis.title}}</view></view><view class="analysis-palace">{{analysis.palaceName}}宫</view></view><view wx:if="{{analysis.overlay}}" class="analysis-overlay">{{analysis.overlay}}</view><view class="analysis-stars"><text>主星</text><text>{{analysis.stars}}</text></view><view class="analysis-block"><text class="analysis-block-title">命盘分析</text><text class="analysis-copy">{{analysis.summary}}</text></view><view class="analysis-block"><text class="analysis-block-title">命盘依据</text><text class="analysis-copy">{{analysis.evidence}}</text></view><view class="analysis-block"><text class="analysis-block-title">详细解读</text><text wx:for="{{analysis.details}}" wx:key="*this" class="analysis-copy">{{item}}</text></view><view class="analysis-block advice"><text class="analysis-block-title">现实建议</text><text class="analysis-copy">{{analysis.advice}}</text></view></view>
    <view class="note">排盘内核：iztro。结果仅供传统文化学习与生活参考。</view>
  </view>
</view>
